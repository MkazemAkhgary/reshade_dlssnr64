    <Touch Files="$(DlssnrShaderStampDir)\precompile.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(DlssnrShaderStampDir)\precompile.stamp" />
      <FileWrites Include="$(DlssnrGeneratedDir)\shader_bytecode_precompiled.cpp" />
      <FileWrites Include="@(ShaderCacheFiles)" />
    </ItemGroup>
  </Target>
