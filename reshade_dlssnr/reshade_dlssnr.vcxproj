  <!-- Rebuild removes only explicit outputs owned by this project. Unrelated
       files and directories under generated/ are preserved. -->
  <!--
    Derived shader items are created here, not at evaluation time:
    %(Extension) in an ItemGroup Condition is rejected by MSBuild
    before the project loads, but is legal inside a target body.
    ShaderSourceFiles remains the single explicit source list.
  -->
  <Target Name="PrepareShaderItems" BeforeTargets="Clean;ClCompile">
    <ItemGroup>
      <ShaderRootFiles Include="@(ShaderSourceFiles)" Condition="'%(Extension)' == '.hlsl'" />
      <ExpandedShaderFiles Include="@(ShaderRootFiles->'$(DlssnrGeneratedDir)\expanded_shaders\%(Identity)')" />
      <ShaderCacheFiles Include="@(ShaderRootFiles->'$(DlssnrGeneratedDir)\shader_cache\%(Filename).cso')" />
    </ItemGroup>
  </Target>

  <Target Name="CleanGeneratedShaderOutputsBeforeRebuild" BeforeTargets="Rebuild" DependsOnTargets="PrepareShaderItems">
    <Delete Files="$(DlssnrGeneratedFiles);$(DlssnrGeneratedDir)\shader_bytecode_precompiled.cpp;$(DlssnrShaderStampDir)\generate.stamp;$(DlssnrShaderStampDir)\verify.stamp;$(DlssnrShaderStampDir)\precompile.stamp;@(ExpandedShaderFiles);@(ShaderCacheFiles)" />
  </Target>
  <Target Name="ValidateFxcPath" Condition="('$(VerifyShaders)' == 'true' or '$(PrecompileShaders)' == 'true') and '$(FxcPath)' == ''">
    <Error Text="FxcPath is not set. Set /p:FxcPath=... or ensure a Windows SDK is installed." />
  </Target>
  <!--
    Incremental gating is on `generate.stamp`, not on the four generated C++
    files. generate_shaders.ps1 now writes those four files only when their
    contents actually change, so their mtimes no longer advance on every run;
    without a separate stamp, MSBuild would see inputs newer than unchanged
    outputs and re-run the Exec forever. The stamp is touched after every
    successful Exec, so the target runs exactly once per shader-source edit.
    FileWrites makes Clean (and therefore Rebuild) remove the generated files,
    the expanded FXC sources and the stamp.
  -->
  <Target Name="GenerateEmbeddedShadersTarget" BeforeTargets="ClCompile" DependsOnTargets="PrepareShaderItems" Inputs="@(ShaderSourceFiles->'shaders\%(Identity)');$(ProjectDir)tools\generate_shaders.ps1;$(ProjectDir)tools\generate_shaders.py" Outputs="$(DlssnrShaderStampDir)\generate.stamp">
    <MakeDir Directories="$(DlssnrShaderStampDir)" />
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\generate_shaders.ps1&quot; -ProjectDir &quot;$(DlssnrProjectDir)&quot; -GeneratedDir &quot;$(DlssnrGeneratedDir)&quot;" />
    <Touch Files="$(DlssnrShaderStampDir)\generate.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(DlssnrGeneratedFiles)" />
      <FileWrites Include="@(ExpandedShaderFiles)" />
      <FileWrites Include="$(DlssnrShaderStampDir)\generate.stamp" />
    </ItemGroup>
  </Target>
  <Target Name="VerifyShadersTarget" BeforeTargets="ClCompile" DependsOnTargets="GenerateEmbeddedShadersTarget;ValidateFxcPath" Condition="'$(VerifyShaders)' == 'true'" Inputs="@(ShaderSourceFiles->'shaders\%(Identity)');$(ProjectDir)tools\verify_shaders.ps1" Outputs="$(DlssnrShaderStampDir)\verify.stamp">
