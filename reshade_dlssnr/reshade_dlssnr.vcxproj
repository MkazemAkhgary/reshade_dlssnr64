    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(ProjectDir)tools\verify_shaders.ps1&quot; -ProjectDir &quot;$(DlssnrProjectDir)&quot; -FxcPath &quot;$(FxcPath)&quot;" />
    <Touch Files="$(DlssnrShaderStampDir)\verify.stamp" AlwaysCreate="true" />
    <ItemGroup>
      <FileWrites Include="$(DlssnrShaderStampDir)\verify.stamp" />
    </ItemGroup>
  </Target>
  <Target Name="PrecompileShadersTarget" BeforeTargets="ClCompile" DependsOnTargets="GenerateEmbeddedShadersTarget;VerifyShadersTarget;ValidateFxcPath" Condition="'$(PrecompileShaders)' == 'true'" Inputs="@(ShaderSourceFiles->'shaders\%(Identity)');$(ProjectDir)tools\precompile_shaders.ps1" Outputs="$(DlssnrShaderStampDir)\precompile.stamp">
