    <DlssnrShaderStampDir>$(DlssnrGeneratedDir)\stamps</DlssnrShaderStampDir>
    <DlssnrGeneratedFiles>$(DlssnrGeneratedDir)\shader_sources.cpp;$(DlssnrGeneratedDir)\shader_sources.h;$(DlssnrGeneratedDir)\shader_bytecode.cpp;$(DlssnrGeneratedDir)\shader_bytecode.h</DlssnrGeneratedFiles>
