pass.preset.a.tip = Uporabi prednastavitev modela A. Spremembe se uporabijo ob vsakem ovrednotenju in ponastavijo notranjo zgodovino modela, ne da bi se funkcija obnovila.
pass.preset.b = B
pass.preset.b.tip = Uporabi prednastavitev modela B. Spremembe se uporabijo ob vsakem ovrednotenju in ponastavijo notranjo zgodovino modela, ne da bi se funkcija obnovila.
pass.preset.c = C
pass.preset.c.tip = Uporabi prednastavitev modela C. Spremembe se uporabijo ob vsakem ovrednotenju in ponastavijo notranjo zgodovino modela, ne da bi se funkcija obnovila.
pass.preset.tip = Izberi prednastavitev kakovosti/vedenja modela za ta pas.
pass.ratio_brighten = Razmerje svetljenja
pass.ratio_brighten.tip = Zgornja meja razmerja preostanka na kanal, ko so omejitve razmerja omogočene. Velja za sestavo SDR in HDR.
pass.ratio_clamps = Omejitve razmerja
pass.ratio_clamps.tip = Omeji logaritmično razmerje preostanka modela na kanal na območje [Zatemnitev razmerja, Svetljenje razmerja] pred oblikovanjem. Velja za sestavo SDR in HDR.
pass.ratio_darken = Zatemnitev razmerja
pass.ratio_darken.tip = Spodnja meja razmerja preostanka na kanal, ko so omejitve razmerja omogočene. Velja za sestavo SDR in HDR.
pass.ratio_eps = Razmerje eps
pass.ratio_eps.tip = Najnižja vrednost imenovalca za logaritmično razmerje preostanka na kanal. Ohranja preostanek končen, ko je kanal blizu ničle. Velja za sestavo SDR in HDR.
pass.render_preset = Prednastavitev upodabljanja
pass.render_preset.performance = Zmogljivost
pass.render_preset.performance.tip = Namig 2: prednastavitev, usmerjena k zmogljivosti.
pass.render_preset.quality = Kakovost
pass.render_preset.quality.tip = Namig 1: prednastavitev, usmerjena k kakovosti.
pass.render_preset.tip = Namig DLSSNR.Hint.Render.Preset za ta pas. NGX ga zadrži ob ustvarjanju funkcije, zato sprememba obnovi funkcijo tega pasu.
pass.residual_chroma = Moč krome
pass.residual_chroma.tip = Kolikšen del krome urejanja se pojavi glede na njegovo svetilnost.
pass.residual_gamma = Gama urejanja
pass.residual_gamma.tip = Oblikuje krivuljo odziva urejanja.
pass.residual_highlight = Zaščita svetlih tonov
pass.residual_highlight.tip = Oslabi urejanje nad srednjo do visoko svetilnostjo.
pass.residual_shadow = Zaščita senčnih tonov
pass.residual_shadow.tip = Oslabi urejanje pod srednjo do nizko svetilnostjo.
pass.skin_structure = Kožna struktura
pass.skin_structure.tip = Nadzoruje, kako močno model uporablja svoja urejanja, specifična za kožo. Onemogočeno, ko je samodejna možnost maskiranja modela izklopljena.
pass.target = Cilj
pass.target.backbuffer = Zadnji medpomnilnik
pass.target.backbuffer.tip = Zaženi na končnem zamenjalnem zadnjem medpomnilniku ob ReShade Present. Deluje tudi, ko igra ne uporablja DLSS; ni urejen s pre-/po-DLSS pasovi, razen če so te stopnje na voljo.
pass.target.post_dlss = Po-DLSS
pass.target.post_dlss.tip = Zaženi po ovrednotenju DLSS igre na njenem povečanem izhodu, pred kasnejšo obdelavo in uporabniškim vmesnikom.
pass.target.pre_dlss = Pred-DLSS
pass.target.pre_dlss.tip = Zaženi pred ovrednotenjem DLSS igre na njenem vhodnem viru Color. Igra nato poveča spremenjeno sliko. Zahteva vhod Color s polnim virom.
pass.target.tip = Vsak pas lahko neodvisno cilja na Pred-DLSS, Po-DLSS ali Zadnji medpomnilnik. Vrstni red izvajanja je združen po stopnjah; pasovi znotraj vsake stopnje sledijo vrstnemu redu zavihkov pasov. Sprememba cilja ponastavi notranjo zgodovino modela ob naslednjem ovrednotenju.
pass.temporal.adaptive = Prilagodljivo
pass.temporal.adaptive.tip = Ponovno uporabi reprojicirano urejanje, kolikor dopušča zaupanje na slikovno piko, in vsili osvežitev vsaj vsakih N sličic, kjer je N drsnik Kadence. Učinkovita kadenca se razpolovi, ko je delež neveljavnih slikovnih pik visok.
pass.temporal.cadence = Kadenca
pass.temporal.cadence.tip = Število sličic med ovrednotenji modela. V prilagodljivem načinu je to maksimum; učinkovita kadenca se razpolovi, ko je delež neveljavnih slikovnih pik visok. V fiksnem načinu je to točna kadenca.
pass.temporal.cheap = Cenejši model
pass.temporal.cheap.tip = Zaženi drug, cenejši model na sličicah med polnimi ovrednotenji in prevzemi njegovo urejanje tam, kjer je zaupanje reprojekcije nizko. Izključeno, se te sličice obnovijo le iz zgodovine, kar ne stane nič dodatnega, a pusti disokluzije in hitro gibanje nerešena do naslednjega polnega ovrednotenja.
pass.temporal.cheap_preset = Prednastavitev cenejšega modela
pass.temporal.cheap_preset.tip = Prednastavitev upodabljanja za lastno funkcijo cenejšega modela. Samodejno sledi tej pasu, kar ne potrebuje druge funkcije; ostale ustvarijo eno, ker NGX zadrži namig ob ustvarjanju.
pass.temporal.cheap_scale = Merilo cenejšega modela
pass.temporal.cheap_scale.tip = Ločljivost cenejšega modela kot delež delovnega merila. 0,5 pomeni 50 % ločljivosti delovnega merila. Nižje vrednosti so hitrejše, a zapolnijo območja reprojekcije z nizkim zaupanjem z manj podrobnostmi.
pass.temporal.depth_abs = Abs. globine
pass.temporal.depth_abs.tip = Dovoljena absolutna razlika globine po reprojekciji gibanja.
pass.temporal.depth_rel = Rel. globine
pass.temporal.depth_rel.tip = Relativni dovoljeni odstop globine. Prag je večji od tega dovoljenega odstopa in Abs. globine.
pass.temporal.fixed = Fiksno
pass.temporal.fixed.tip = Ponovno uporabi reprojicirano urejanje za fiksno število sličic med ovrednotenji modela, ne glede na zaupanje. Drsnik Kadence je točna kadenca.
pass.temporal.fp16_history = Zgodovina urejanja FP16
pass.temporal.fp16_history.tip = Shrani časovne teksture urejanja/kandidatov v FP16. Zmanjša pasovno širino in pomnilnik zgodovine z majhnimi razlikami kvantizacije pri ponovno uporabljenih urejanjih.
pass.temporal.max_invalid = Najv. neveljavnih %
pass.temporal.max_invalid.tip = Največji delež neveljavnih ali fotometrično neujemajočih se slikovnih pik, dovoljen pred osvežitvijo modela.
pass.temporal.max_motion = Najv. gibanje
pass.temporal.max_motion.tip = Zavrni reprojekcijo, ko gibanje preseže toliko slikovnih pik delovne ločljivosti.
pass.temporal.mode = Način
pass.temporal.mode.tip = Ponovno uporabi z gibanjem reprojicirano multiplikativno urejanje modela namesto ovrednotenja modela vsako sličico. Zahteva globino trenutne sličice in polje gibanja – igre ali eno, ki ga ustvari Popravi vektorje gibanja; negotova zgodovina vsili sveže ovrednotenje.
pass.temporal.off = Izklopljeno
pass.temporal.off.tip = Ovrednoti nevronski model na vsaki sličici.
pass.temporal.photo_abs = Fot. abs.
pass.temporal.photo_abs.tip = Dovoljena absolutna razlika svetilnosti vhoda modela med trenutno slikovno piko in njenim z gibanjem reprojiciranim ujemanjem prejšnje sličice.
pass.temporal.photo_rel = Fot. rel.
pass.temporal.photo_rel.tip = Relativni dovoljeni odstop svetilnosti, povečan z večjo absolutno trenutno ali prejšnjo svetilnostjo. Dodano k Fot. abs.
pass.ui_correction = Popravek uporabniškega vmesnika
pass.ui_correction.tip = Zmanjšaj urejanja modela tam, kjer zazna elemente uporabniškega vmesnika.
pass.upsample_sharpness = Ostrina povečave
pass.upsample_sharpness.tip = Eksponent ohranjanja robov za fiksno skupno dvostransko 3x3 rekonstrukcijo vhoda in izhoda modela. Višje vrednosti natančneje sledijo vodnikom robov polne ločljivosti; nižje vrednosti se gladkeje mešajo čez soseščino nizke ločljivosti. To ne spremeni velikosti urejanja modela.
pass.working_scale = Delovno merilo
pass.working_scale.reset_tip = Ponastavi Delovno merilo in x2 na njune privzete vrednosti.
pass.working_scale.slider_tip = Delovna ločljivost modela kot delež sličice.\n\nZelo nizke vrednosti se dvignejo na minimum 180p navpične ločljivosti, zato časovna reprojekcija vedno ima uporabno zgodovino. Sprememba te vrednosti ponastavi notranjo zgodovino modela ob naslednjem ovrednotenju.
pass.working_scale.tip = Ločljivost, pri kateri se model izvaja, kot delež sličice. Označi x2, da jo podvojiš za nad-vzorčenje. Sestava in zadnji medpomnilnik ostata pri ločljivosti sličice.
pass.working_scale.x2_off_tip = Trenutno podvajaš delovno ločljivost modela za nad-vzorčenje. Odznači, da se vrneš na vrednost drsnika. Sprememba te nastavitve ponastavi notranjo zgodovino modela ob naslednjem ovrednotenju.\n\nPrva sličica po odznačitvi se lahko za kratek čas tudi zamrzne, medtem ko se dodelijo manjši viri in se prejšnji upokojijo na GPU.
pass.working_scale.x2_on_tip = Podvoji delovno ločljivost modela za nad-vzorčenje. To ponastavi notranjo zgodovino modela ob naslednjem ovrednotenju.\n\nOPOZORILO: omogočenje tega lahko za kratek trenutek zamrzne igro na prvi sličici po preklopu, medtem ko se dodelijo večji viri delovnega merila (delovni vhod/izhod, časovna zgodovina, ne-dvignjen referenčni) in se prejšnji med-poti medpomnilniki upokojijo na GPU.\n\nDruge nevarnosti:\n  - Uporaba VRAM se za vire delovnega merila približno štirikrat poveča.\n  - Ovrednotenje modela in sestava sta pri 2x počasnejša.\n  - Cenejši model, ponovno uporabljen na sličicah ponovne uporabe, raste z delovnim merilom, zato so sličice ponovne uporabe dražje.\n  - Zamrznitev, daljša od ene do dve sekundi, običajno pomeni, da napravi zmanjkuje VRAM; izključi to, da se obnoviš.

# prefs
prefs.clone_resources = Kloniraj vire igre
prefs.clone_resources.tip = Izklopljeno (privzeto): neposredno preberi trenutne vire globine/gibanja igre in izhod DLSS. Vključeno: kopiraj globino/gibanje trenutne sličice in izhod DLSS, ko je Po-DLSS omogočen, v teksture v lasti dodatka. Ta možnost velja za vse stopnje, vključno z Zadnjim medpomnilnikom; zahtevani način se varno zadrži ob novem ovrednotenju DLSS.
prefs.fp16_storage = Cevovod FP16
prefs.fp16_storage.tip = Shrani nosilec HDR gain-map, delovne teksture modela in ne-dvignjen referenčni sestave v RGBA16F namesto RGBA32F. Prepolovi pasovno širino in obseg cevovoda HDR za ceno kvantizacije v množitelju nosilec-v-HDR in deltah domene modela. Poti SDR niso prizadete. Preklop ponastavi časovno zgodovino in obnovi funkcijo NGX.
prefs.invert_fallback_depth = Obrni nadomestno globino
prefs.invert_fallback_depth.tip = Obrni vrednosti ReShade Generic Depth, ko se uporabijo, ker ovrednotenje DLSS ni priskrbelo vira globine. Ne spremeni globine, ki jo priskrbi DLSS.
