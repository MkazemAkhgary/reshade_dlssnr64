# local_exposure
local_exposure.bright_detail_protection = Zaščita svetlih podrobnosti
local_exposure.bright_detail_protection.tip = Nadzoruje, ali lahko temna soseščina dvigne piksle nad os. 1 ohrani svetle točke sidrane; 0 dovoli popravek čez os.
local_exposure.cat.advanced = Napredno
local_exposure.dark_detail_protection = Zaščita temnih podrobnosti
local_exposure.dark_detail_protection.tip = Nadzoruje, ali lahko svetla soseščina potemni piksle pod osjo. 1 ohrani temne podrobnosti sidrane; 0 dovoli popravek čez os.
local_exposure.detail_retention = Ohranjanje podrobnosti
local_exposure.detail_retention.tip = Ohrani podrobnost log-svetilnosti piksla glede na njegovo lokalno osnovo. 1 ohrani vse relativne podrobnosti; nižje vrednosti jih stisnejo.
local_exposure.edge_protection = Zaščita robov
local_exposure.edge_protection.tip = Zmanjša vpliv vzorcev čez močne robove log-svetilnosti. 0 uporabi le prostorske uteži; višje vrednosti zmanjšajo halo, a lahko naredijo prilagajanje bolj lokalno.
local_exposure.enabled = Lokalna izpostavljenost
local_exposure.enabled.tip = Uporabi prostorsko spremenljiv popravek izpostavljenosti, ki se vrti okoli srednjega tona, navezanega na zaslon. Deluje na vsakem viru: pot HDR doseže os prek svoje krivulje tona, pot, navezana na zaslon, pa jo prebere iz slike.
local_exposure.highlight_reduction = Zmanjšanje svetlih poudarkov
local_exposure.highlight_reduction.tip = Neodvisni množitelj za zmanjšanje svetlih poudarkov. Nastavi na nič, da svetle predele pusti tam, kjer so, medtem ko še vedno dviga sence.
local_exposure.highlight_transition = Prehod svetlih poudarkov
local_exposure.highlight_transition.tip = Koraki nad osjo srednjega tona, pri katerih se zmanjšanje svetlih poudarkov poveča do polne moči. Manjša vrednost deluje bolj agresivno.
local_exposure.max_brighten = Največje osvetljenje
local_exposure.max_brighten.tip = Največje dvignjenje sence v korakih. Pri polni zaščiti svetlih podrobnosti piksli nad osjo srednjega tona niso dvignjeni, tudi če je njihova soseščina temna.
local_exposure.max_darken = Največje potemnitve
local_exposure.max_darken.tip = Največje zmanjšanje svetlih poudarkov v korakih. Pri polni zaščiti temnih podrobnosti piksli pod osjo niso potemnjeni, tudi če je njihova soseščina svetla.
local_exposure.midtone = Lokalni srednji ton
local_exposure.midtone.tip = Ciljna os svetilnosti v SDR domeni modela. Piksli blizu te ose prejmejo malo popravka; sence se dvignejo, svetli poudarki pa se spustijo proti njej.
local_exposure.radius = Lokalni polmer
local_exposure.radius.tip = Polmer v izvornih pikslih. Polmer 1 onemogoči vzorčenje soseščine z več dotiki in uporabi le osrednji piksel. Večji polmeri se odzivajo na širša temna/svetla območja namesto na hrup posameznih pikslov.
local_exposure.restore = Obnovi izpostavljenost modela
local_exposure.restore.tip = Uporabi popravek na izhod modela po oceni. Ko je onemogočeno, obnovljeno lokalno senčenje modela ostane nerodovano.
local_exposure.restore_scale = Prostorska lestvica obnove
local_exposure.restore_scale.tip = Nadzoruje prostorsko lestvico obnove izpostavljenosti: 0 = natančno preklicanje lokalnega dviga na piksel, 1 = enoten splošni popravek, z mešanjem v log-prostoru med njima. Splošna obnova ohrani več obnovljenih svetlostnih razmerij modela.
local_exposure.restore_strength = Moč obnove
local_exposure.restore_strength.tip = Količina obnove izpostavljenosti: 0 = brez popravka, 1 = polni popravek. Vmesne vrednosti mešajo izbrano obnovo v log-prostoru izpostavljenosti.
local_exposure.samples = Vzorci soseščine
local_exposure.samples.tip = Zahtevani prostorski dotiki v lokalni oceni log-svetilnosti. Učinkovito število se zaokroži v skupine po štiri, da ostane vzorčenje prostorsko uravnoteženo.
local_exposure.shadow_lift = Dvignjenje sence
local_exposure.shadow_lift.tip = Neodvisni množitelj za dvignjenje sence. Nastavi na nič, da temne predele pusti tam, kjer so, medtem ko še vedno zmanjšuje svetle poudarke.
local_exposure.shadow_transition = Prehod sence
local_exposure.shadow_transition.tip = Koraki od ose srednjega tona, pri katerih se dvignjenje sence poveča do polne moči. Manjša vrednost deluje bolj agresivno na temna območja.
local_exposure.strength = Moč
local_exposure.strength.tip = Splošna količina lokalnega popravka izpostavljenosti.
local_exposure.title = Lokalna izpostavljenost

