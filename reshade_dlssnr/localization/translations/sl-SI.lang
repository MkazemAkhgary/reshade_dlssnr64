hdr.game.enabled = Izpostavljenost igre
hdr.game.enabled.tip = Uporabi teksturo NGX izpostavljenosti igre kot osnovno izpostavljenost. Če igra je ne zagotovi, ta plast odpade in Prilagodljiva izpostavljenost lahko namesto tega zagotovi osnovo.
hdr.highlight_headroom = Rezerva svetlih poudarkov
