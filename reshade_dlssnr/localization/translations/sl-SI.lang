grade_backbuffer.enabled = Omogočeno
grade_backbuffer.enabled.tip = Ocenjuj končno sliko swapchain po vsakem pass-u, neposredno pred predstavitvijo. To je neodvisno od ocen vhoda in izhoda modela vsakega pass-a.
grade_backbuffer.title = Ocenjevanje medpomnilnika

# hdr
hdr.adaptive.enabled = Prilagodljiva izpostavljenost
hdr.adaptive.enabled.tip = Ko je izpostavljenost igre izklopljena, zagotavlja splošno izpostavljenost iz merjenja histograma. Ko je izpostavljenost igre vključena, uporabi Moč nad igro kot omejen popravek (brez učinka pri 0). Nima učinka, dokler ne prispeti prvo merjenje.
hdr.adaptive.max_correction = Največji popravek (koraki)
hdr.adaptive.max_correction.tip = Največja prilagoditev okoli izpostavljenosti igre, ko sta omogočeni obe plasti.
hdr.adaptive.midtone = Cilj srednjih tonov
hdr.adaptive.midtone.tip = Ciljna svetilnost za izbrano populacijo.
hdr.adaptive.speed_down = Hitrost potemnitve
hdr.adaptive.speed_down.tip = Največje zmanjšanje izpostavljenosti v korakih na sekundo.
hdr.adaptive.speed_up = Hitrost osvetlitve
hdr.adaptive.speed_up.tip = Največje povečanje izpostavljenosti v korakih na sekundo.
hdr.adaptive.strength_over_game = Moč nad igro
hdr.adaptive.strength_over_game.tip = Ko je izpostavljenost igre dejavna, dodaj ta delež korakovnega popravka prilagodljivega cilja. Če je igra onemogočena, je Prilagodljiva osnovna izpostavljenost.
hdr.bt2446_ip = Prelom BT.2446C
hdr.bt2446_ip.tip = Položaj kolena v domeni krivulje BT.2446C. Vsebina nad to točko je log-stisnjena; vsebina pod njo je linearna. Drsnik zajema uporaben obseg za resnično vsebino HDR. Vrednosti zunaj njega je še vedno mogoče vnesti: 10000 onemogoči stiskanje.
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = Nagib linearnega območja: Y_SDR = k1 * Y_HDR za vsebino pod prelomno točko. Prav tako nagib, ki se ga log-veja ujema pri koleni.
hdr.bt2446_k2 = BT.2446C k2 (izpeljano)
hdr.bt2446_k2.tip = Nagib log-območja krivulje BT.2446C. Izpeljan iz k1, k3 in prelomne točke, tako da se log-veja ujema z nagibom linearne veje pri koleni.
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = Moč stiskanja ramena. Večje vrednosti močneje povlečejo log-vejo navzdol in bolj potemnijo svetle poudarke. k2 in k4 sta izpeljana iz tega, da krivulja ostane gladka pri koleni.
hdr.bt2446_k4 = BT.2446C k4 (izpeljano)
hdr.bt2446_k4.tip = Presek log-območja krivulje BT.2446C. Izpeljan iz k1, k3 in prelomne točke, tako da se log-veja ujema z vrednostjo linearne veje pri koleni.
