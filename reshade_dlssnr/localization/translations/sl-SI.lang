exposure_mask.luma_relative = Relativna svetilnost
exposure_mask.luma_relative.tip = Najmanjša razlika svetilnosti glede na svetlejši vhod/izhod svetilnosti.
exposure_mask.luma_threshold = Prag svetilnosti
exposure_mask.luma_threshold.tip = Najmanjša absolutna razlika svetilnosti za označevanje urejanja modela.
exposure_mask.response = Časovni odziv
exposure_mask.response.tip = Zmešaj nove glasove maske z masko prejšnje sličice.
exposure_mask.smoothing = Prostorsko glajenje
exposure_mask.smoothing.tip = Večinsko filtriraj binarne glasove izpostavljenosti v majhni soseščini.
exposure_mask.title = Maska izpostavljenosti

# grade
grade.black_level = Raven črnine
grade.black_level.tip = Vrednost svetilnosti OKLab, preslikana v črno. Pozitivne vrednosti potemnijo le najgloblje sence; negativne vrednosti dvignejo začetek.
grade.brightness = Svetlost
grade.brightness.tip = V načinu izpostavljenosti je vrednost v korakih (-1 prepolovi linearno svetlobo; +1 jo podvoji). Drug načini uporabljajo svojo krivuljo svetlosti.
grade.brightness_mode = Način svetlosti
grade.brightness_mode.tip = Kateri algoritem uporablja svetlost. To so alternativa, ne plasti.
grade.cas = Izostrovanje CAS
grade.cas.tip = Omogoči AMD FidelityFX Contrast Adaptive Sharpening na ocenjenem rezultatu. Teče kot ločena pošiljka le v linearnem SDR; preskočeno za oblike HDR.
grade.cas_strength = Moč CAS
grade.cas_strength.tip = Količina izostrovanja za AMD FidelityFX CAS. 0 ne uporabi izostrovanja, 1 uporabi največje izostrovanje.
grade.chroma_mode = Način kromatičnosti
grade.chroma_mode.saturation = Nasičenost
grade.chroma_mode.saturation.tip = Uravnaj kromatičnost OKLab z istim faktorjem, ob ohranjanju zaznavnega odtenka.
grade.chroma_mode.tip = Kateri algoritem uporablja nasičenost. To so alternativa, ne plasti.
grade.chroma_mode.vibrance = Živost
grade.chroma_mode.vibrance.tip = Močneje povečaj pridušene barve v OKLab, pri čemer se učinek zmanjšuje z naraščanjem kromatičnosti.
grade.contrast = Kontrast
grade.contrast.tip = Zasidrana S-krivulja okoli srednje svetilnosti. Pozitivno poveča kontrast, negativno pa ga zmanjša, pri čemer ostaneta črna in bela sidrani.
grade.edge_softening = Glajenje ob robovih
grade.edge_softening.tip = Zmešaj skupno dvostransko soseščino 3x3 v vhod gradnika. Podobnost svetilnosti zmanjša zabrisanost čez močne robove.
grade.highlights = Svetli poudarki
grade.highlights.tip = Prilagodi svetle poudarke z gladko krivuljo, ki polegovi pred črno.
grade.luma_mode.exposure = Izpostavljenost
grade.luma_mode.exposure.tip = Množi RGB linearne svetlobe z 2^količina (koraki); preslikava gamuta zaščiti barve, ko rezultat preseže izhodni obseg.
grade.luma_mode.gain = Ojačanje
grade.luma_mode.gain.tip = Uravnava svetilnost OKLab z omejeno množilno krivuljo.
grade.luma_mode.gamma = Gama
grade.luma_mode.gamma.tip = Uporabi predznačeno potenčno krivuljo na svetilnosti OKLab. Nevtralna črna in bela ostaneta sidrani, učinek se osredotoči na srednje tone.
grade.luma_mode.soft = Mehko
grade.luma_mode.soft.tip = Gladka prilagoditev svetilnosti, ki polegovi proti nič blizu črne in bele.
grade.saturation = Nasičenost
grade.saturation.tip = Prilagodi zaznavno kromatičnost v OKLab. Barve zunaj gamuta so stisnjene proti nevtralni osi, da se izogne artefaktom odrezanja kanalov.
grade.shadows = Sence
grade.shadows.tip = Prilagodi sence z gladko krivuljo, ki polegovi pred belo.
grade.softening_strength = Moč glajenja
grade.softening_strength.tip = Količina glajenja 3x3, ki upošteva robove.
grade.white_level = Raven beline
grade.white_level.tip = Vrednost svetilnosti OKLab, preslikana v belo. Dvig točke zniža sliko; barve zunaj gamuta so stisnjene namesto odrezane po kanalih.

