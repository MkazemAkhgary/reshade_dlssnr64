# debug
debug.title = Razhroščevanje
debug.view = Razhroščevalni pogled
debug.view.depth = Globina
debug.view.depth.tip = Medpomnilnik globine, ki ga je igra posredovala v DLSS. Prikazano v sivinah.
debug.view.exposure_mask = Maska izpostavljenosti
debug.view.exposure_mask.tip = Maska trenutne sličice iz dejanskega vhoda modela (vključno z vhodnim gradnikom in lokalno izpostavljenostjo) v primerjavi z neobdelanim izhodom modela. Objavljena je za uporabo izpostavljenosti v naslednji sličici.
debug.view.gain_map = Zemljevid ojačanja
debug.view.gain_map.tip = Surovi f32 množitelj rekonstrukcije nosilca-v-HDR, prikazan v log2 korakih od -4 (črna) do +6 (bela).
debug.view.game_exposure = Izpostavljenost igre
debug.view.game_exposure.tip = Izpostavljenost NGX igre v korakih: 1.0x (0 korakov) je srednje siva; svetlejše/temnejše vrednosti se premaknejo proti beli/črni. Magenta pomeni, da ni bila prebrana nobena veljavna vrednost.
debug.view.hdr_local_exposure = Lokalna izpostavljenost HDR
debug.view.hdr_local_exposure.tip = Lokalni faktor izpostavljenosti v korakih, preslikan tako, da je 0 korakov srednje siva, -2 korakov črna in +2 korakov bela.
debug.view.hdr_roundtrip_diagnostic = Diagnostika HDR povratne poti
debug.view.hdr_roundtrip_diagnostic.tip = Primerjava 2x2: dejanski pripravljeni vhod modela | izhod modela / sestavljen HDR, preslikan nazaj v neocenjeni domeni modela | razlika sestave glede na neocenjeni izhod modela. Neničelni robovi so pričakovani, ker se podrobnosti vira polne ločljivosti ohranijo; delovna lestvica vpliva na to primerjavo. Za preverjanje izolirane rekonstrukcije nosilca uporabite Napako HDR povratne poti.
debug.view.hdr_roundtrip_error = Napaka HDR povratne poti
debug.view.hdr_roundtrip_error.tip = Relativna napaka z lažnimi barvami med izvirnim dekodiranim virom HDR in neposredno rekonstrukcijo float32 iz nosilca RGBA32F in množitelja nosilec-v-HDR. To potrjuje le prenos nosilca, ne urejanja modela ali končne sestave; neodvisno od delovne lestvice in vhodnega gradnika.
debug.view.hint = Pogled upodablja trenutno izbrani pass na spodnjih zavihkih in začne veljati le, ko je ta pass omogočen.
debug.view.model_input_pre_grade = Vhod modela (pred gradnikom)
debug.view.model_input_pre_grade.tip = Barva vhoda modela natanko takšna, kakršna je bila, preden se je zagnal vhodni gradnik. Gradnik se uporabi na mestu, zato cevovod za vas posname to teksturo, ko je pogled izbran; če je vhodni gradnik omogočen, jo primerjajte z Vhodom modela (pripravljeno).
debug.view.model_input_prepared = Vhod modela (pripravljeno)
debug.view.model_input_prepared.tip = Slika, ki je dejansko podana modelu, po spremembi velikosti na delovno lestvico, pripravi HDR in vhodnem gradniku, če je omogočen.
debug.view.model_input_source = Vhod modela (vir)
debug.view.model_input_source.tip = Sličica, kot je bila zajeta, pred kakršnim koli obdelovanjem. To je izhod DLSS, iz katerega bo model delal, v njegovi izvirni ločljivosti.
debug.view.model_output_composed = Izhod modela (sestavljeno)
debug.view.model_output_composed.tip = Končni rezultat tega pass-a, potem ko je bilo urejanje modela sestavljeno z virom. To se zapiše v cilj.
debug.view.model_output_post_grade = Izhod modela (po gradniku)
debug.view.model_output_post_grade.tip = Izhod modela po zagonu izhodnega gradnika, v lastni SDR domeni modela, kodirani z sRGB - simetrično z vhodnim gradnikom na vhodu modela. Vse nadaljnje (sestava, maska izpostavljenosti, povratek) to porabi, kot da bi model to ustvaril.
debug.view.model_output_raw = Izhod modela (surovo)
debug.view.model_output_raw.tip = Izhod modela natanko takšen, kot ga je ustvaril NGX, preden se uporabi izhodni gradnik. Posnetek je nastal v cevovodu, ker se gradnik izvaja na mestu; če je izhodni gradnik omogočen, ga primerjajte z Izhodom modela (po gradniku).
debug.view.motion_vectors = Vektorji gibanja
debug.view.motion_vectors.tip = Gibalno polje, s katerim ta pass ocenjuje: vektorji igre ali polje, ki ga je ustvaril Pravilni vektorji gibanja. Prikazano kot R = smer x, G = smer y.
debug.view.off = Izklop
debug.view.off.tip = Onemogoči razhroščevalni pogled in prikaži običajni sestavljeni izhod.
debug.view.sdr_base_pre_model = Osnova SDR (pred modelom)
debug.view.sdr_base_pre_model.tip = Linearna nosilna SDR polne ločljivosti, ki jo ustvari razdelitev BT.2446C. To je tovor RGB, iz katerega je model podvzorčen.
debug.view.temporal_candidate_status = Stanje začasnega kandidata
debug.view.temporal_candidate_status.tip = Zaupanje o reprojekciji pred preverjanjem globine, prikazano v sivinah (bela = popolnoma zaupanja vredno, črna = zavrnjeno). Zaupanje združuje lokalno soglasje pri prijemljaju urejanja, fotometrično soglasje in prejšnje zaupanje. Ni na voljo, dokler prejšnje urejanje ni mogoče reprojicirati.
debug.view.temporal_reprojected_edit = Časovno reprojicirano urejanje
debug.view.temporal_reprojected_edit.tip = Potrjen log-ojačanje na kanal iz prejšnje sličice, preslikano tako, da je nevtralno ojačanje sivo, močnejša pozitivna/negativna urejanja pa se premaknejo proti beli/črni. Zavrnjeni piksli so temni.
debug.view.temporal_validation_status = Stanje časovnega preverjanja
debug.view.temporal_validation_status.tip = Zaupanje po preverjanju globine, prikazano v sivinah. Zaupanje uravnava utež uporabljenega urejanja; nizke vrednosti urejanje polegovejo proti vhodu.
debug.view.tip = Za pregled cevovoda zamenjaj končno sliko z notranjim medpomnilnikom.

