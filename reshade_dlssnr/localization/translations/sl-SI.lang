pass.chroma_strength = Moč krome
pass.chroma_strength.tip = Mešanje med izvirno in urejeno kromo.
pass.correct_motion = Popravi vektorje gibanja
pass.correct_motion.tip = Ustvari polje gibanja, ki mu ta pas lahko zaupa. Prvi pre-/po-DLSS pas sličice ohrani vektorje igre takšne, kot so, ker obdeluje sliko, za katero so bili ustvarjeni. Vsak pas po njem in vsak pas zadnjega medpomnilnika dobi popravljeno polje: iskanje je omejeno na nekaj slikovnih pik okoli vektorja igre in usmerjeno proti prejšnjemu polju. Brez vektorjev igre pas namesto tega sintetizira iz barve in globine. Nahrani model in časovno reprojekcijo; stane en GPU odpošiljanje na pas in potrebuje uporaben vodnik globine.
pass.edit_strength = Moč urejanja
pass.edit_strength.tip = Prilagodi velikost urejanja modela, preden se prenese na vir.
pass.enabled = Omogoči
pass.enabled.tip = Omogoči ali onemogoči ta profil pasu. Onemogočeni pasovi ne ovrednotijo modela.
pass.grade_input.apply_to_pre_grade = Uporabi urejanje na sliko pred stopnjo
pass.grade_input.apply_to_pre_grade.tip = Uporabi urejanje modela na sliko pred stopnjo, da stopnja ne doseže izhoda. Izključeno, se uporabi stopnjevani izhod modela tak, kot je.
pass.grade_input.enabled = Stopnjuj vhod modela
pass.grade_input.enabled.tip = Stopnjuj sliko, ki jo model bere, pred ovrednotenjem modela.
