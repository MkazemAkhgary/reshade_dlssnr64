hdr.diag.game_texture = texture: %ux%u fmt=%d
hdr.diag.game_value = value: %.4f
hdr.diag.guides = DLSS guides: %s
hdr.diag.histogram = Histogram (log2 luminance)
hdr.diag.histogram.tip = Histogram zmierzonej luminancji log2. Populacja zależy od aktywnych filtrów ekspozycji.
hdr.diag.histogram_missing = Histogram: not ready
hdr.diag.metering_source = Metering source: %s
hdr.diag.post_blocked = Post-DLSS blocked: %s
hdr.diag.reference_luma = reference luma: %.4f
hdr.diag.samples = Samples: %u - frames since measure: %u
