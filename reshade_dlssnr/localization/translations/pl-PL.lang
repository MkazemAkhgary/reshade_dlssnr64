# debug
debug.title = Debugowanie
debug.view = Widok debugowania
debug.view.depth = Głębia
debug.view.depth.tip = Bufor głębi dostarczony przez grę do DLSS. Wyświetlany w skali szarości.
debug.view.exposure_mask = Maska ekspozycji
debug.view.exposure_mask.tip = Maska bieżącej klatki z rzeczywistego wejścia modelu (w tym gradacji wejścia i Ekspozycji Lokalnej) względem surowego wyjścia modelu. Jest publikowana do użycia jako ekspozycja w następnej klatce.
debug.view.gain_map = Mapa wzmocnienia
debug.view.gain_map.tip = Surowy mnożnik rekonstrukcji nośnik-do-HDR typu f32, wyświetlany w log2 stopach od -4 (czerń) do +6 (biel).
debug.view.game_exposure = Ekspozycja gry
debug.view.game_exposure.tip = Ekspozycja gry NGX w stopach: 1.0x (0 stopów) to średnia szarość; jaśniejsze/ciemniejsze wartości zbliżają się do bieli/czerni. Magenta oznacza, że nie odczytano poprawnej wartości.
debug.view.hdr_local_exposure = Lokalna ekspozycja HDR
debug.view.hdr_local_exposure.tip = Współczynnik ekspozycji lokalnej w stopach, mapowany tak, że 0 stopów to średnia szarość, -2 stopy to czerń, a +2 stopy to biel.
debug.view.hdr_roundtrip_diagnostic = Diagnostyka obiegu HDR
debug.view.hdr_roundtrip_diagnostic.tip = Porównanie 2x2: rzeczywiste przygotowane wejście modelu | wyjście modelu / złożone HDR odwzorowane z powrotem do niegradowanej domeny modelu | różnica złożenia względem niegradowanego wyjścia modelu. Niezerowe krawędzie są oczekiwane, ponieważ zachowywane są szczegóły źródła w pełnej rozdzielczości; skala pracy wpływa na to porównanie. Do izolowanej weryfikacji rekonstrukcji nośnika użyj Błędu obiegu HDR.
debug.view.hdr_roundtrip_error = Błąd obiegu HDR
debug.view.hdr_roundtrip_error.tip = Błąd względny w fałszywym kolorze między oryginalnym zdekodowanym źródłem HDR a bezpośrednią rekonstrukcją float32 z nośnika RGBA32F i mnożnika nośnik-do-HDR. Sprawdza tylko transfer nośnika, a nie edycję modelu ani końcowe złożenie; niezależne od Skali pracy i gradacji wejścia.
debug.view.hint = Widok jest renderowany przez aktualnie wybrany pas na poniższych kartach i działa tylko, gdy ten pas jest włączony.
debug.view.model_input_pre_grade = Wejście modelu (przed gradacją)
debug.view.model_input_pre_grade.tip = Kolor wejścia modelu dokładnie taki, jak przed wykonaniem Gradacji wejścia. Gradacja jest stosowana w miejscu, więc potok tworzy migawkę tej tekstury po wybraniu widoku; przy włączonej Gradacji wejścia porównaj ją z Wejściem modelu (przygotowanym).
debug.view.model_input_prepared = Wejście modelu (przygotowane)
debug.view.model_input_prepared.tip = Obraz faktycznie podawany do modelu, po zmianie rozmiaru do Skali pracy, przygotowaniu HDR i gradacji wejścia (gdy włączona).
debug.view.model_input_source = Wejście modelu (źródło)
debug.view.model_input_source.tip = Klatka przechwycona przed jakąkolwiek obróbką. To wyjście DLSS, na którym będzie pracował model, w jego natywnej rozdzielczości.
debug.view.model_output_composed = Wyjście modelu (złożone)
debug.view.model_output_composed.tip = Wynik końcowy tego pasa, po złożeniu edycji modelu z źródłem. To jest zapisywane do celu.
debug.view.model_output_post_grade = Wyjście modelu (po gradacji)
debug.view.model_output_post_grade.tip = Wyjście modelu po wykonaniu Gradacji wyjścia, we własnej domenie SDR z kodowaniem sRGB modelu - symetryczne do Gradacji wejścia na wejściu modelu. Wszystko poniżej (złożenie, maska ekspozycji, zapis) zużywa to tak, jakby wyprodukował to model.
debug.view.model_output_raw = Wyjście modelu (surowe)
debug.view.model_output_raw.tip = Wyjście modelu dokładnie takie, jak wyprodukował je NGX, przed zastosowaniem Gradacji wyjścia. Migawka wykonana przez potok, ponieważ gradacja działa w miejscu; przy włączonej Gradacji wyjścia porównaj ją z Wyjściem modelu (po gradacji).
debug.view.motion_vectors = Wektory ruchu
debug.view.motion_vectors.tip = Pole ruchu, z którym ten pas się liczy: wektory gry lub pole wygenerowane przez Popraw wektory ruchu. Wyświetlane jako R = kierunek x, G = kierunek y.
debug.view.off = Wyłącz
debug.view.off.tip = Wyłącza widok debugowania i pokazuje normalne złożone wyjście.
debug.view.sdr_base_pre_model = Baza SDR (przed modelem)
debug.view.sdr_base_pre_model.tip = Pełnorozdzielcze liniowe nośnik SDR wygenerowany przez podział BT.2446C. To ładunek RGB, z którego model jest próbkowany w dół.
debug.view.temporal_candidate_status = Status kandydata tymczasowego
debug.view.temporal_candidate_status.tip = Pewność reproyekcji przed walidacją głębi, wyświetlana w skali szarości (białe = w pełni ufane, czarne = odrzucone). Pewność łączy zgodność lokalnego zacisku edycji, zgodność fotometryczną i poprzednią pewność. Niedostępne, dopóki poprzednia edycja nie może zostać reproyektowana.
debug.view.temporal_reprojected_edit = Reproyektowana edycja tymczasowa
debug.view.temporal_reprojected_edit.tip = Zweryfikowany log-wzmocnienie na kanał z poprzedniej klatki, mapowane tak, że neutralne wzmocnienie to szarość, a silniejsze dodatnie/ujemne edycje zbliżają się do bieli/czerni. Odrzucone piksele są ciemne.
debug.view.temporal_validation_status = Status walidacji tymczasowej
debug.view.temporal_validation_status.tip = Pewność po walidacji głębi, wyświetlana w skali szarości. Pewność skaluje stosowaną wagę edycji; niskie wartości zanikają edycję w kierunku wejścia.
debug.view.tip = Zastępuje końcowy obraz buforem wewnętrznym w celu inspekcji potoku.

# exposure_mask
exposure_mask.chroma_threshold = Próg chrominancji
exposure_mask.chroma_threshold.tip = Minimalna różnica tylko chrominancji do oznaczenia edycji modelu.
exposure_mask.edit_strength = Siła edycji
exposure_mask.edit_strength.tip = Skaluje zmierzony różnicę wejścia/wyjścia modelu przed progowaniem.
exposure_mask.enabled = Włączone
exposure_mask.enabled.tip = Ten pas buduje swoją Maskę ekspozycji po ocenie modelu. Maska wpływa tylko na pomiary HDR w następnej klatce tego pasa.
exposure_mask.luma_relative = Względna luminancja
exposure_mask.luma_relative.tip = Minimalna różnica luminancji względem jaśniejszego wejścia/wyjścia luminancji.
exposure_mask.luma_threshold = Próg luminancji
exposure_mask.luma_threshold.tip = Minimalna bezwzględna różnica luminancji do oznaczenia edycji modelu.
exposure_mask.response = Odpowiedź tymczasowa
exposure_mask.response.tip = Łączy nowe głosy maski z maską z poprzedniej klatki.
exposure_mask.smoothing = Wygładzanie przestrzenne
exposure_mask.smoothing.tip = Filtruje większościowo binarne głosy ekspozycji w małym sąsiedztwie.
exposure_mask.title = Maska ekspozycji

# grade
grade.black_level = Poziom czerni
grade.black_level.tip = Wartość jasności OKLab mapowana na czerń. Dodatnie wartości przyciemniają tylko najgłębsze cienie; ujemne podnoszą stopę.
grade.brightness = Jasność
grade.brightness.tip = W trybie Ekspozycji wartość jest w stopach (-1 połowę światła liniowego; +1 podwaja je). Inne tryby używają własnej krzywej jasności.
grade.brightness_mode = Tryb jasności
grade.brightness_mode.tip = Który algorytm używa jasność. To są alternatywy, a nie warstwy.
grade.cas = Wyostrzanie CAS
grade.cas.tip = Włącza AMD FidelityFX Contrast Adaptive Sharpening na gradowanym wyniku. Działa jako oddzielne wywołanie tylko w liniowym SDR; pomijane dla formatów HDR.
grade.cas_strength = Siła CAS
grade.cas_strength.tip = Ilość wyostrzania dla AMD FidelityFX CAS. 0 nie stosuje wyostrzania, 1 stosuje maksymalne wyostrzanie.
grade.chroma_mode = Tryb chrominancji
grade.chroma_mode.saturation = Nasycenie
grade.chroma_mode.saturation.tip = Skaluje chrominancję OKLab tym samym czynnikiem, zachowując postrzeganą barwę.
grade.chroma_mode.tip = Który algorytm używa nasycenia. To są alternatywy, a nie warstwy.
grade.chroma_mode.vibrance = Żywość
grade.chroma_mode.vibrance.tip = Mocniej wzmacnia stłumione kolory w OKLab, zmniejszając efekt wraz ze wzrostem chrominancji.
grade.contrast = Kontrast
grade.contrast.tip = Zakotwiczona wokół średniej jasności krzywa S. Dodatnia zwiększa kontrast, ujemna go zmniejsza, zachowując czern i biel.
grade.edge_softening = Łagodzenie krawędzi
grade.edge_softening.tip = Miesza sąsiedztwo złączone dwustronnie 3x3 do wejścia gradacji. Podobieństwo luminancji zmniejsza rozmycie przez silne krawędzie.
grade.highlights = Podświetlenia
grade.highlights.tip = Reguluje podświetlenia gładką krzywą zanikającą przed czernią.
grade.luma_mode.exposure = Ekspozycja
grade.luma_mode.exposure.tip = Mnoży liniowe światło RGB przez 2^amount (stopy); mapowanie przestrzeni barw chroni kolory, gdy wynik przekracza zakres wyjścia.
grade.luma_mode.gain = Wzmocnienie
grade.luma_mode.gain.tip = Skaluje jasność OKLab ograniczoną krzywą multiplikatywną.
grade.luma_mode.gamma = Gamma
grade.luma_mode.gamma.tip = Stosuje krzywą potęgową ze znakiem do jasności OKLab. Neutralna czerń i biel pozostają zakotwiczone, koncentrując efekt w średnich tonach.
grade.luma_mode.soft = Miękkie
grade.luma_mode.soft.tip = Gładka regulacja jasności zanikająca do zera w pobliżu czerni i bieli.
grade.saturation = Nasycenie
grade.saturation.tip = Reguluje postrzeganą chrominancję w OKLab. Kolory poza przestrzenią barw są kompresowane w kierunku osi neutralnej, aby uniknąć artefaktów obcinania kanałów.
grade.shadows = Cienie
grade.shadows.tip = Reguluje cienie gładką krzywą zanikającą przed bielą.
grade.softening_strength = Siła łagodzenia
grade.softening_strength.tip = Ilość łagodzenia krawędzi 3x3 świadomego krawędzi.
grade.white_level = Poziom bieli
grade.white_level.tip = Wartość jasności OKLab mapowana na biel. Podniesienie punktu obniża obraz; kolory poza przestrzenią barw są kompresowane zamiast obcinania kanałów.

# grade_backbuffer
grade_backbuffer.enabled = Włączone
grade_backbuffer.enabled.tip = Gradacji końcowego obrazu łańcucha wymiany po każdym pasie, bezpośrednio przed prezentacją. Jest to niezależne od gradacji wejścia i wyjścia modelu każdego pasa.
grade_backbuffer.title = Gradacja bufora wymiany

# hdr
hdr.adaptive.enabled = Adaptacyjna ekspozycja
hdr.adaptive.enabled.tip = Przy wyłączonej Ekspozycji gry zapewnia globalną ekspozycję z pomiaru histogramu. Przy włączonej Ekspozycji gry stosuje Siłę nad grą jako ograniczoną korektę (brak efektu przy 0). Brak efektu do czasu nadejścia pierwszego pomiaru.
hdr.adaptive.max_correction = Maks. korekta w stopach
hdr.adaptive.max_correction.tip = Maksymalna regulacja wokół Ekspozycji gry, gdy obie warstwy są włączone.
hdr.adaptive.midtone = Cel średnich tonów
hdr.adaptive.midtone.tip = Docelowa luminancja dla wybranej populacji.
hdr.adaptive.speed_down = Prędkość ściemniania
hdr.adaptive.speed_down.tip = Maksymalny spadek ekspozycji w stopach na sekundę.
hdr.adaptive.speed_up = Prędkość rozjaśniania
hdr.adaptive.speed_up.tip = Maksymalny wzrost ekspozycji w stopach na sekundę.
hdr.adaptive.strength_over_game = Siła nad grą
hdr.adaptive.strength_over_game.tip = Gdy aktywna jest Ekspozycja gry, dodaj ten ułamek korekty stopniowej celu adaptacyjnego. Gdy gra jest wyłączona, Adaptacyjna jest bazową ekspozycją.
hdr.bt2446_ip = Punkt przegięcia BT.2446C
hdr.bt2446_ip.tip = Pozycja kolana w domenie krzywej BT.2446C. Zawartość powyżej tego punktu jest kompresowana logarytmicznie; poniżej jest liniowa. Suwak obejmuje użyteczny zakres dla rzeczywistej zawartości HDR. Wartości poza nim można nadal wpisać: 10000 wyłącza kompresję.
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = Nachylenie w obszarze liniowym: Y_SDR = k1 * Y_HDR dla zawartości poniżej punktu przegięcia. Także nachylenie, z którym zgadza się odgałęzienie logarytmiczne w kolanie.
hdr.bt2446_k2 = BT.2446C k2 (pochodne)
hdr.bt2446_k2.tip = Nachylenie w obszarze logarytmicznym krzywej BT.2446C. Pochodzi z k1, k3 i punktu przegięcia, więc odgałęzienie logarytmiczne zgadza się z nachyleniem odgałęzienia liniowego w kolanie.
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = Siła kompresji ramienia. Większe wartości mocniej ściągają odgałęzienie logarytmiczne w dół, bardziej przyciemniając podświetlenia. k2 i k4 pochodzą z tego, więc krzywa pozostaje gładka w kolanie.
hdr.bt2446_k4 = BT.2446C k4 (pochodne)
hdr.bt2446_k4.tip = Odcięcie w obszarze logarytmicznym krzywej BT.2446C. Pochodzi z k1, k3 i punktu przegięcia, więc odgałęzienie logarytmiczne zgadza się z wartością odgałęzienia liniowego w kolanie.
