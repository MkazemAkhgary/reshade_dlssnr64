hdr.diag.warming = Warming up - no exposure measurement yet.
hdr.enabled = Włączone
hdr.enabled.tip = Mierzy obraz HDR bezpośrednio przed tym pasem. Późniejsze pasy mierzą obraz złożony przez poprzedni pas, chyba że włączono ponowne użycie pomiaru. Pasy bufora wymiany używają składania SDR.
hdr.format = Format
hdr.format.auto = Automatyczny
hdr.format.auto.tip = Automatycznie wykrywa format z aktywnego źródła Pre/Post-DLSS.
hdr.format.hdr10 = HDR10
hdr.format.hdr10.tip = Traktuje źródło jako HDR10 PQ (ST.2084).
hdr.format.scrgb = scRGB
hdr.format.scrgb.tip = Traktuje źródło jako liniowe scRGB (1.0 = 80 nitów).
hdr.format.sdr = SDR
hdr.format.sdr.tip = Traktuje źródło jako SDR sRGB.
hdr.format.tip = Jak zakodowany jest obraz źródłowy. Automatycznie wykrywa z formatu DXGI wyjścia DLSS.
hdr.gain_max = Maks. wzmocnienia
hdr.gain_max.tip = Oczekiwane maksymalne wzmocnienie nośnik-do-HDR w stopach log2. Używane tylko przez diagnostyczne statystyki mapy wzmocnienia i widoki debugowania; nie wpływa na składanie.
hdr.gain_min = Min. wzmocnienia
hdr.gain_min.tip = Oczekiwane minimalne wzmocnienie nośnik-do-HDR w stopach log2. Używane tylko przez diagnostyczne statystyki mapy wzmocnienia i widoki debugowania; nie wpływa na składanie.
hdr.game.bias = Odchylenie ekspozycji
hdr.game.bias.tip = Ręczne odchylenie względem ekspozycji gry, w stopach. Zero pozostawia wartość gry nietkniętą.
hdr.game.enabled = Ekspozycja gry
hdr.game.enabled.tip = Używa tekstury Ekspozycji NGX gry jako bazowej ekspozycji. Jeśli gra jej nie dostarcza, ta warstwa przepuszcza, a Ekspozycja adaptacyjna może dostarczyć bazę.
hdr.highlight_headroom = Rezerwa podświetleń
hdr.highlight_headroom.tip = Skaluje efektywny szczyt HDR używany przez BT.2446C. Nie zmienia to sposobu interpretacji ekspozycji.
hdr.layer.adaptive = Adaptacyjna ekspozycja
hdr.layer.adaptive.tip = Globalna ekspozycja oparta na histogramie lub ograniczona korekta nad Ekspozycją gry.
hdr.layer.game = Ekspozycja gry
hdr.layer.game.tip = Konfiguruje ekspozycję gry jako warstwę bazową.
hdr.layers.stack_order = Kolejność warstw: baza Ekspozycji gry, następnie korekta adaptacyjna. Ekspozycja Lokalna to osobna sekcja i stosuje się po obu.
hdr.measure_interval = Interwał pomiaru
hdr.measure_interval.tip = Jak często pomiary histogramu ekspozycji są wykonywane, w klatkach.
hdr.metering_density = Gęstość pomiaru
hdr.metering_density.tip = Ile pikseli próbkuje histogram HDR. Pełna gęstość przechwytuje każdy piksel; grubsze gęstości próbkują mniej pikseli przy niższym koszcie GPU.
hdr.reuse_previous_pass = Ponowne użycie pomiaru HDR poprzedniego pasa
hdr.reuse_previous_pass.tip = Dla późniejszych pasów w tym samym łańcuchu Pre/Post-DLSS ponownie używa pomiaru HDR poprzedniego pasa zamiast wysyłać nowy histogram. Pierwszy pas nadal mierzy źródło gry.
hdr.source.filtered = Filtrowana populacja
hdr.source.full_frame = Pełna klatka
hdr.source.game_exposure = Ekspozycja gry (NGX)
hdr.source.unknown = Nieznane
hdr.title = HDR

# hdr_filters
hdr_filters.depth = Głębia
hdr_filters.depth.tip = Ogranicza tę warstwę do wybranego znormalizowanego przedziału głębi.
hdr_filters.depth_far = Głębia daleka
hdr_filters.depth_far.tip = Daleki koniec akceptowanego znormalizowanego przedziału głębi.
hdr_filters.depth_near = Głębia bliska
hdr_filters.depth_near.tip = Bliski koniec akceptowanego znormalizowanego przedziału głębi.
hdr_filters.exposure_mask = Maska ekspozycji
hdr_filters.exposure_mask.tip = Mierzy lub koryguje tylko piksele ważone trwałą maską Ekspozycji.
hdr_filters.percentile_high = Górny percentyl
hdr_filters.percentile_high.tip = Górna granica percentyla dla tej warstwy.
hdr_filters.percentile_low = Dolny percentyl
hdr_filters.percentile_low.tip = Dolna granica percentyla. Gra/Adaptacyjna używają pasma do pomiaru; Lokalna używa go jako pasma ochrony luminancji.
hdr_filters.percentile_range = Zakres percentyla
hdr_filters.percentile_range.tip = Dla Gry/Adaptacyjnej wybiera pasmo percentyla histogramu tej warstwy. Dla Ekspozycji Lokalnej zanika korektę lokalną poza zmierzonym pasmem luminancji.

# local_exposure
local_exposure.bright_detail_protection = Ochrona jasnych szczegółów
local_exposure.bright_detail_protection.tip = Steruje, czy ciemne sąsiedztwo może podnieść piksele powyżej punktu obrotu. 1 utrzymuje jasne punkty zakotwiczone; 0 pozwala na korektę poza punktem obrotu.
local_exposure.cat.advanced = Zaawansowane
local_exposure.dark_detail_protection = Ochrona ciemnych szczegółów
local_exposure.dark_detail_protection.tip = Steruje, czy jasne sąsiedztwo może przyciemnić piksele poniżej punktu obrotu. 1 utrzymuje ciemne szczegóły zakotwiczone; 0 pozwala na korektę poza punktem obrotu.
local_exposure.detail_retention = Zachowanie szczegółów
local_exposure.detail_retention.tip = Zachowuje szczegóły log-luminancji piksela względem jego lokalnej bazy. 1 zachowuje wszystkie względne szczegóły; niższe wartości je kompresują.
local_exposure.edge_protection = Ochrona krawędzi
local_exposure.edge_protection.tip = Zmniejsza wpływ próbek w poprzek silnych krawędzi log-luminancji. 0 używa tylko wag przestrzennych; wyższe wartości zmniejszają halo, ale mogą bardziej zlokalizować adaptację.
local_exposure.enabled = Ekspozycja lokalna
local_exposure.enabled.tip = Stosuje przestrzennie zmienną korektę ekspozycji, obracając wokół średniego tonu odniesionego do wyświetlacza. Działa na każdym źródle: ścieżka HDR dociera do punktu obrotu przez swoją krzywą tonów, ścieżka odniesiona do wyświetlacza odczytuje go z obrazu.
local_exposure.highlight_reduction = Redukcja podświetleń
local_exposure.highlight_reduction.tip = Niezależny mnożnik redukcji podświetleń. Ustaw na zero, aby zostawić jasne obszary tam, gdzie są, jednocześnie podnosząc cienie.
local_exposure.highlight_transition = Przejście podświetleń
local_exposure.highlight_transition.tip = Stopy powyżej punktu obrotu średniego tonu, w których redukcja podświetleń narasta do pełnej siły. Mniejsza wartość działa agresywniej.
local_exposure.max_brighten = Maks. rozjaśnienie
local_exposure.max_brighten.tip = Maksymalne podniesienie cieni w stopach. Przy pełnej ochronie jasnych szczegółów piksele powyżej punktu obrotu nie są podnoszone, nawet gdy ich sąsiedztwo jest ciemne.
local_exposure.max_darken = Maks. ściemnienie
local_exposure.max_darken.tip = Maksymalna redukcja podświetleń w stopach. Przy pełnej ochronie ciemnych szczegółów piksele poniżej punktu obrotu nie są ściemniane, nawet gdy ich sąsiedztwo jest jasne.
local_exposure.midtone = Lokalny średni ton
local_exposure.midtone.tip = Docelowa luminancja punktu obrotu w domenie SDR modelu. Piksele blisko tego punktu otrzymują niewielką korektę; cienie idą w górę, a podświetlenia w dół ku niemu.
local_exposure.radius = Lokalny promień
local_exposure.radius.tip = Promień w pikselach źródła. Promień 1 wyłącza wielowyjściowe próbkowanie sąsiedztwa i używa tylko piksela środkowego. Większe promienie reagują na szersze ciemne/jasne obszary zamiast szumu pojedynczych pikseli.
local_exposure.restore = Przywróć ekspozycję modelu
local_exposure.restore.tip = Stosuje korektę do wyjścia modelu po ocenie. Gdy wyłączone, zrekonstruowane lokalne cieniowanie modelu pozostaje nietknięte.
local_exposure.restore_scale = Przestrzenna skala przywracania
local_exposure.restore_scale.tip = Steruje przestrzenną skalą przywracania ekspozycji: 0 = dokładne anulowanie piksel po pikselu lokalnego podniesienia, 1 = jednolita korekta globalna, z mieszaniem w przestrzeni logarytmicznej między nimi. Globalne przywrócenie zachowuje więcej relacji jasności zrekonstruowanych przez model.
local_exposure.restore_strength = Siła przywracania
local_exposure.restore_strength.tip = Ilość przywracania ekspozycji: 0 = brak korekty, 1 = pełna korekta. Wartości pośrednie mieszają wybrane przywrócenie w przestrzeni logarytmicznej ekspozycji.
local_exposure.samples = Próbki sąsiedztwa
local_exposure.samples.tip = Żądane przestrzenne próbki w lokalnym szacunku log-luminancji. Efektywna liczba zaokrągla się do grup po cztery, aby zachować przestrzenną równowagę próbkowania.
local_exposure.shadow_lift = Podniesienie cieni
local_exposure.shadow_lift.tip = Niezależny mnożnik podnoszenia cieni. Ustaw na zero, aby zostawić ciemne obszary tam, gdzie są, jednocześnie redukując podświetlenia.
local_exposure.shadow_transition = Przejście cieni
local_exposure.shadow_transition.tip = Stopy od punktu obrotu średniego tonu, w których podniesienie cieni narasta do pełnej siły. Mniejsza wartość działa agresywniej na ciemne obszary.
local_exposure.strength = Siła
local_exposure.strength.tip = Ogólna ilość lokalnej korekty ekspozycji.
local_exposure.title = Ekspozycja lokalna

# pass
pass.auto_mask = Automatyczna maska
pass.auto_mask.tip = Pozwala modelowi wykrywać skórę postaci i stosować jej edycje osobno.
pass.cat.model = Model
pass.cat.residual_edits = Edycje resztkowe
pass.cat.strength = Siła
pass.cat.temporal = Reprojekcja tymczasowa
pass.cheap_preset.auto = Automatyczny
pass.cheap_preset.auto.tip = Używa własnego ustawienia Render Preset tego pasa. Jedna funkcja NGX obsługuje oba modele.
pass.cheap_preset.performance = Wydajność
pass.cheap_preset.performance.tip = Tworzy funkcję taniego modelu z podpowiedzią 2.
pass.cheap_preset.quality = Jakość
pass.cheap_preset.quality.tip = Tworzy funkcję taniego modelu z podpowiedzią 1.
pass.chroma_strength = Siła chrominancji
pass.chroma_strength.tip = Miesza między oryginalną a edytowaną chrominancją.
pass.correct_motion = Popraw wektory ruchu
pass.correct_motion.tip = Wytwarza pole ruchu, któremu ten pas może ufać. Pierwszy pas Pre/Post-DLSS klatki zachowuje wektory gry bez zmian, ponieważ przetwarza obraz, dla którego zostały stworzone. Każdy pas po nim oraz każdy pas bufora wymiany otrzymuje poprawione pole: wyszukiwanie jest ograniczone do kilku pikseli wokół wektora gry i przesunięte w stronę poprzedniego pola. Bez wektorów gry pas syntetyzuje je z koloru i głębi. Zasila model i reprojekcję tymczasową; kosztuje jedno wywołanie GPU na pas i wymaga użytkowalnego przewodnika głębi.
pass.edit_strength = Siła edycji
pass.edit_strength.tip = Skaluje edycję modelu, zanim zostanie przeniesiona na źródło.
pass.enabled = Włączone
pass.enabled.tip = Włącza lub wyłącza ten profil pasa. Wyłączone pasy nie oceniają modelu.
pass.grade_input.apply_to_pre_grade = Zastosuj edycję do obrazu przed gradacją
pass.grade_input.apply_to_pre_grade.tip = Stosuje edycję modelu do obrazu przed gradacją, tak aby gradacja nie docierała do wyjścia. Wyłączone - używane jest zgradowane wyjście modelu tak, jak jest.
pass.grade_input.enabled = Gradacja wejścia modelu
pass.grade_input.enabled.tip = Gradacja obrazu czytanego przez model, przed oceną modelu.
pass.grade_input.title = Gradacja wejścia modelu
pass.grade_output.enabled = Gradacja wyjścia modelu
pass.grade_output.enabled.tip = Gradacja wyprodukowanego przez model, przed jego publikacją.
pass.grade_output.title = Gradacja wyjścia modelu
pass.intensity = Intensywność
pass.intensity.tip = Jak silnie model jest instruowany do edycji obrazu.\n0 całkowicie pomija ocenę modelu
pass.local_structure = Lokalna struktura
pass.local_structure.tip = Ile szczegółów lokalnej struktury modelu zastosować.
pass.local_tone = Lokalny ton
pass.local_tone.tip = Ile lokalnych korekt tonów modelu zastosować.
pass.luma_strength = Siła luminancji
pass.luma_strength.tip = Miesza między oryginalną a edytowaną luminancją.
pass.menu.copy_from_next = Kopiuj z następnego pasa
pass.menu.copy_from_previous = Kopiuj z poprzedniego pasa
pass.name = Nazwa
pass.name.tip = Etykieta wyświetlana na karcie tego pasa. Pusta pokazuje domyślną pozycyjną, \"Pass N\".
pass.order = Kolejność pasów
pass.preset = Preset
pass.preset.a = A
pass.preset.a.tip = Używa presetu modelu A. Zmiany są stosowane przy każdej ocenie i resetują wewnętrzną historię modelu bez przebudowy funkcji.
pass.preset.b = B
pass.preset.b.tip = Używa presetu modelu B. Zmiany są stosowane przy każdej ocenie i resetują wewnętrzną historię modelu bez przebudowy funkcji.
pass.preset.c = C
pass.preset.c.tip = Używa presetu modelu C. Zmiany są stosowane przy każdej ocenie i resetują wewnętrzną historię modelu bez przebudowy funkcji.
pass.preset.tip = Wybiera preset jakości/zachowania modelu dla tego pasa.
pass.ratio_brighten = Stosunek rozjaśniania
pass.ratio_brighten.tip = Górna granica resztkowego stosunku na kanał, gdy włączone są Klamry stosunku. Dotyczy zarówno składania SDR, jak i HDR.
pass.ratio_clamps = Klamry stosunku
pass.ratio_clamps.tip = Ogranicza resztkowy stosunek logarytmiczny na kanał do zakresu [Ściemnianie stosunku, Rozjaśnianie stosunku] przed kształtowaniem. Dotyczy zarówno składania SDR, jak i HDR.
pass.ratio_darken = Stosunek ściemniania
pass.ratio_darken.tip = Dolna granica resztkowego stosunku na kanał, gdy włączone są Klamry stosunku. Dotyczy zarówno składania SDR, jak i HDR.
pass.ratio_eps = Eps stosunku
pass.ratio_eps.tip = Ogranicznik mianownika dla resztkowego stosunku logarytmicznego na kanał. Utrzymuje resztkę skończoną, gdy kanał jest bliski zera. Dotyczy zarówno składania SDR, jak i HDR.
pass.render_preset = Render Preset
pass.render_preset.performance = Wydajność
pass.render_preset.performance.tip = Podpowiedź 2: preset zorientowany na wydajność.
pass.render_preset.quality = Jakość
pass.render_preset.quality.tip = Podpowiedź 1: preset zorientowany na jakość.
pass.render_preset.tip = Podpowiedź DLSSNR.Hint.Render.Preset dla tego pasa. NGX zatrzaskuje ją przy tworzeniu funkcji, więc jej zmiana przebudowuje funkcję tego pasa.
pass.residual_chroma = Siła chrominancji
pass.residual_chroma.tip = W jakim stopniu chrominancja edycji ląduje względem jej jasności.
pass.residual_gamma = Gamma edycji
pass.residual_gamma.tip = Kształtuje krzywą odpowiedzi edycji.
pass.residual_highlight = Ochrona podświetleń
pass.residual_highlight.tip = Zanika edycję powyżej średnio-wysokiej jasności.
pass.residual_shadow = Ochrona cieni
pass.residual_shadow.tip = Zanika edycję poniżej średnio-niskiej jasności.
pass.skin_structure = Struktura skóry
pass.skin_structure.tip = Steruje, jak silnie model stosuje swoje edycje specyficzne dla skóry. Wyłączone, gdy opcja automatycznego maskowania modelu jest wyłączona.
pass.target = Cel
pass.target.backbuffer = Bufor wymiany
pass.target.backbuffer.tip = Działa na końcowym buforze wymiany (swapchain) przy Prezentacji ReShade. Działa nawet, gdy gra nie używa DLSS; nie jest uporządkowany z pasami Pre/Post-DLSS, chyba że te etapy są dostępne.
pass.target.post_dlss = Post-DLSS
pass.target.post_dlss.tip = Działa po ocenie DLSS gry na jej skalowanym wyjściu, przed późniejszym przetwarzaniem końcowym i UI.
pass.target.pre_dlss = Pre-DLSS
pass.target.pre_dlss.tip = Działa przed oceną DLSS gry na jej zasobie wejściowym Color. Gra następnie skaluje zmodyfikowany obraz. Wymaga pełnoekranowego zasobu Color.
pass.target.tip = Każdy pas może niezależnie celować w Pre-DLSS, Post-DLSS lub Bufor wymiany. Kolejność wykonania jest grupowana według etapu; pasy w każdym etapie podążają za kolejnością kart pasów. Zmiana celu resetuje wewnętrzną historię modelu przy następnej ocenie.
pass.temporal.adaptive = Adaptacyjna
pass.temporal.adaptive.tip = Ponownie używa reproyektowanej edycji tak daleko, jak pozwala pewność na piksel, wymuszając odświeżenie co najmniej co N klatek, gdzie N to suwak Cadence. Efektywna kadencja zmniejsza się o połowę, gdy frakcja nieprawidłowych pikseli jest wysoka.
pass.temporal.cadence = Kadencja
pass.temporal.cadence.tip = Liczba klatek między ocenami modelu. W trybie Adaptacyjnym to maksimum; efektywna kadencja zmniejsza się o połowę, gdy frakcja nieprawidłowych pikseli jest wysoka. W trybie Stałym to dokładna kadencja.
pass.temporal.cheap = Tani model
pass.temporal.cheap.tip = Uruchamia drugi, tańszy model na klatkach między pełnymi ocenami i pobiera jego edycję tam, gdzie pewność reprojekcji jest niska. Wyłączone - te klatki są rekonstruowane tylko z historii, co nic nie kosztuje dodatkowo, ale pozostawia deokluzje i szybki ruch nierozwiązane do następnej pełnej oceny.
pass.temporal.cheap_preset = Preset taniego modelu
pass.temporal.cheap_preset.tip = Render Preset dla własnej funkcji taniego modelu. Auto podąża za tym pasem, co nie wymaga drugiej funkcji; pozostałe tworzą ją, ponieważ NGX zatrzaskuje podpowiedź przy tworzeniu.
pass.temporal.cheap_scale = Skala taniego modelu
pass.temporal.cheap_scale.tip = Rozdzielczość tańszego modelu jako ułamek skali pracy. 0.5 oznacza 50% rozdzielczości skali pracy. Niższe wartości są szybsze, ale wypełniają obszary reprojekcji o niskiej pewności mniejszą ilością szczegółów.
pass.temporal.depth_abs = Głębia abs.
pass.temporal.depth_abs.tip = Dozwolona bezwzględna różnica głębi po reprojekcji ruchu.
pass.temporal.depth_rel = Głębia wzgl.
pass.temporal.depth_rel.tip = Dozwolony ułamek różnicy głębi względnej. Próg to większa z tego ustępstwa i Głębi abs.
pass.temporal.fixed = Stała
pass.temporal.fixed.tip = Ponownie używa reproyektowanej edycji przez stałą liczbę klatek między ocenami modelu, niezależnie od pewności. Suwak Cadence to dokładna kadencja.
pass.temporal.fp16_history = Historia edycji FP16
pass.temporal.fp16_history.tip = Przechowuje tekstury tymczasowej edycji/kandydata w FP16. Zmniejsza przepustowość i pamięć historii kosztem małych różnic kwantyzacji na ponownie używanych edycjach.
pass.temporal.max_invalid = Maks. nieprawidłowych %
pass.temporal.max_invalid.tip = Maksymalna dozwolona frakcja pikseli nieprawidłowych lub fotometrycznie niezgodnych przed odświeżeniem modelu.
pass.temporal.max_motion = Maks. ruchu
pass.temporal.max_motion.tip = Odrzuca reprojekcję, gdy ruch przekracza tę liczbę pikseli w rozdzielczości roboczej.
pass.temporal.mode = Tryb
pass.temporal.mode.tip = Ponownie używa mnożnikowej edycji modelu z reprojekcją ruchu zamiast oceniać model w każdej klatce. Wymaga głębi bieżącej klatki i pola ruchu - tej z gry lub wygenerowanej przez Correct Motion Vectors; niepewna historia wymusza świeżą ocenę.
pass.temporal.off = Wył.
pass.temporal.off.tip = Ocenia model neuronowy w każdej klatce.
pass.temporal.photo_abs = Foto bezwzgl.
pass.temporal.photo_abs.tip = Bezwzględna różnica luminancji wejścia modelu dozwolona między bieżącym pikselem a jego dopasowaniem z poprzedniej klatki po reprojekcji ruchu.
pass.temporal.photo_rel = Foto wzgl.
pass.temporal.photo_rel.tip = Względny dopust różnicy luminancji, skalowany przez większą bezwzględną luminancję bieżącą lub poprzednią. Dodawany do Foto bezwzgl.
pass.ui_correction = Korekcja UI
pass.ui_correction.tip = Zmniejsza edycje modelu tam, gdzie wykrywa elementy UI.
pass.upsample_sharpness = Ostrość upsamplingu
pass.upsample_sharpness.tip = Wykładnik zachowania krawędzi dla stałej rekonstrukcji joint-bilateral 3x3 wejścia i wyjścia modelu. Wyższe wartości śledzą krawędzie pełnej rozdzielczości ostrzej; niższe wygładzają bardziej w poprzek sąsiedztwa o niskiej rozdzielczości. To nie skaluje edycji modelu.
pass.working_scale = Skala robocza
pass.working_scale.reset_tip = Resetuj Skalę roboczą i x2 do wartości domyślnych.
pass.working_scale.slider_tip = Rozdzielczość robocza modelu jako ułamek klatki.\n\nBardzo niskie wartości są podnoszone do minimum 180p pionowej rozdzielczości, więc reprojekcja tymczasowa zawsze ma użyteczną historię. Zmiana tej wartości resetuje wewnętrzną historię modelu przy następnej ocenie.
pass.working_scale.tip = Rozdzielczość, w której działa model, jako ułamek klatki. Zaznacz x2, aby ją podwoić dla nadpróbkowania. Składanie i backbuffer pozostają w rozdzielczości klatki.
pass.working_scale.x2_off_tip = Obecnie podwajasz rozdzielczość roboczą modelu dla nadpróbkowania. Odznacz, aby wrócić do wartości suwaka. Zmiana tego ustawienia resetuje wewnętrzną historię modelu przy następnej ocenie.\n\nPierwsza klatka po odznaczeniu może też na chwilę zamarznąć, gdy mniejsze zasoby są alokowane, a poprzednie wycofywane na GPU.
pass.working_scale.x2_on_tip = Podwój rozdzielczość roboczą modelu dla nadpróbkowania. To resetuje wewnętrzną historię modelu przy następnej ocenie.\n\nOSTRZEŻENIE: włączenie tego może zamrozić grę na krótki moment w pierwszej klatce po przełączeniu, gdy większe zasoby skali roboczej (wejście/wyjście robocze, historia tymczasowa, odniesienie niepodniesione) są alokowane, a bufory będące w locie wycofywane na GPU.\n\nInne zagrożenia:\n  - Użycie VRAM mniej więcej czterokrotnie rośnie dla zasobów skali roboczej.\n  - Ocena modelu i składanie są wolniejsze przy 2x.\n  - Tani model ponownie używany w klatkach ponownego użycia rośnie wraz ze skalą roboczą, więc klatki ponownego użycia są też droższe.\n  - Zamrożenie dłuższe niż sekunda lub dwie zwykle oznacza, że urządzenie wyczerpało VRAM; przełącz to wyłącz, aby odzyskać.

# prefs
prefs.clone_resources = Klonuj zasoby gry
prefs.clone_resources.tip = Wył. (domyślnie): czyta bieżące zasoby głębi/ruchu gry oraz wyjście DLSS bezpośrednio. Wł.: kopiuje głębię/ruch bieżącej klatki oraz wyjście DLSS, gdy włączone jest Post-DLSS, do tekstur należących do dodatku. Ta jedna opcja dotyczy wszystkich etapów, w tym Backbuffer; żądany tryb jest bezpiecznie zatrzaskiwany przy nowej ocenie DLSS.
prefs.fp16_storage = Potok FP16
prefs.fp16_storage.tip = Przechowuje nośnik mapy wzmocnienia HDR, tekstury robocze modelu oraz odniesienie niepodniesionego składu w RGBA16F zamiast RGBA32F. Pozwala na połowę przepustowości i rozmiaru potoku HDR kosztem kwantyzacji w mnożniku nośnik-do-HDR i deltach domeny modelu. Ścieżki SDR nie są dotknięte. Przełączanie resetuje historię tymczasową i przebudowuje funkcję NGX.
prefs.invert_fallback_depth = Odwróć zapasową głębię
prefs.invert_fallback_depth.tip = Odwraca wartości ReShade Generic Depth, gdy są używane, ponieważ ocena DLSS nie dostarczyła zasobu głębi. Nie zmienia głębi dostarczonej przez DLSS.
prefs.language = Język
prefs.language.auto = Automatycznie (ReShade)
prefs.language.tip = Język interfejsu dodatku. Automatycznie podąża za ustawieniem języka ReShade.
prefs.show_tooltips = Pokaż podpowiedzi
prefs.show_tooltips.tip = Pokazuj kontekstowe opisy po najechaniu na kontrolki i nagłówki sekcji.
prefs.title = Preferencje

# status
status.block.hooks_missing = Post-DLSS wyłączone: haki listy poleceń D3D12 nie są zainstalowane
status.block.ray_reconstruction = Ray Reconstruction: gra podaje DLSS podprostokąt większej alokacji, więc Pre-DLSS nie może bezpiecznie przepisać jego Color. Użyj Post-DLSS.

# ui
ui.enable = Włącz DLSSNR
ui.enable.tip = Główny przełącznik. Gdy wyłączony, żadne pasy nie działają i nie jest nagrywana żadna praca GPU DLSSNR.
ui.grade_backbuffer.reset.tip = Resetuj wszystkie ustawienia Grade Backbuffer do wartości domyślnych.
ui.pass.label.tip = Oryginalny indeks pasa %u. Kolejność wyświetlania jest pogrupowana Pre-DLSS, Post-DLSS, a następnie Backbuffer, zachowując kolejność pasów wewnątrz każdej grupy.
ui.pass.status.blocked = %s - zablokowany%s
ui.pass.status.disabled = Wyłączony
ui.pass.status.failed = %s - BŁĄD: %s%s
ui.pass.status.initializing = %s - inicjalizacja%s
