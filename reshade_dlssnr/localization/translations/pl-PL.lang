hdr.crosstalk = Przekładanie
hdr.crosstalk.tip = Ilość przed-desaturacji BT.2446C.
hdr.density.full = Pełna
hdr.density.full.tip = Próbkuje każdy piksel. Pełny histogram gęstości, najwyższa dokładność.
hdr.density.quarter = 1/4
hdr.density.quarter.tip = Próbkuje co 2. piksel w każdej osi (1/4 klatki). Małe izolowane podświetlenia mogą zostać pominięte.
hdr.density.sixteenth = 1/16
hdr.density.sixteenth.tip = Próbkuje co 4. piksel w każdej osi (1/16 klatki). Izolowane podświetlenia i drobne szczegóły mogą zostać pominięte.
hdr.density.sixty_fourth = 1/64
hdr.density.sixty_fourth.tip = Próbkuje co 8. piksel w każdej osi (1/64 klatki). Odpowiednie tylko dla w przybliżeniu jednolitej zawartości.
hdr.detailed_statistics = Szczegółowe statystyki HDR
hdr.detailed_statistics.tip = Zbiera pełną statystykę zakresu mapy wzmocnienia i wychyleń. Dodaje dwa wywołania GPU, gdy włączone.
hdr.diag.adaptive_scene_white = adaptive scene white: %.4f
hdr.diag.async_note = Wartości aktualizują się asynchronicznie. Ekspozycja i histogram odzwierciedlają najnowszy pomiar, który GPU zakończył zapis.
