# An empty value means the English text is used.

# ctl
ctl.category.toggle = Déplier ou réduire la sous-section %s.
ctl.menu.copy = Copier
ctl.menu.paste = Coller
ctl.reset.default.tip = Réinitialiser à la valeur par défaut déclarée.
ctl.section.toggle = Activer ou désactiver %s.

# debug
debug.title = Débogage
debug.view = Vue de débogage
debug.view.depth = Profondeur
debug.view.depth.tip = Le tampon de profondeur fourni par le jeu à DLSS. Affiché en niveaux de gris.
debug.view.exposure_mask = Masque d'exposition
debug.view.exposure_mask.tip = Le masque de la trame courante issu de l'entrée réelle du modèle (y compris le gradage d'entrée et l'exposition locale) par rapport à la sortie brute du modèle. Il est publié pour une utilisation de l'exposition à la trame suivante.
debug.view.gain_map = Gain map
debug.view.gain_map.tip = Multiplicateur de reconstruction porteur-vers-HDR f32 brut, affiché en stops log2 de -4 (noir) à +6 (blanc).
debug.view.game_exposure = Exposition du jeu
debug.view.game_exposure.tip = Exposition NGX du jeu en stops : 1,0x (0 stop) est le gris moyen ; les valeurs plus claires/plus sombres se rapprochent du blanc/noir. Magenta signifie qu'aucune valeur valide n'a été lue.
debug.view.hdr_local_exposure = Exposition HDR locale
debug.view.hdr_local_exposure.tip = Facteur d'exposition local en stops, associé afin que 0 stop soit le gris moyen, -2 stops le noir et +2 stops le blanc.
debug.view.hdr_roundtrip_diagnostic = Diagnostic aller-retour HDR
debug.view.hdr_roundtrip_diagnostic.tip = Comparaison 2x2 : entrée de modèle préparée réelle | sortie du modèle / HDR composé remappé vers le domaine de modèle non gradé | différence de composition par rapport à la sortie de modèle non gradée. Des bords non nuls sont attendus car le détail source en pleine résolution est préservé ; l'échelle de travail affecte cette comparaison. Utilisez Erreur aller-retour HDR pour le contrôle isolé de la reconstruction du porteur.
debug.view.hdr_roundtrip_error = Erreur aller-retour HDR
debug.view.hdr_roundtrip_error.tip = Erreur relative en fausses couleurs entre la source HDR décodée d'origine et la reconstruction float32 directe à partir du porteur RGBA32F et du multiplicateur porteur-vers-HDR. Cela ne valide que le transfert du porteur, pas l'édition du modèle ni la composition finale ; indépendant de l'échelle de travail et du gradage d'entrée.
debug.view.hint = La vue est rendue par le passe actuellement sélectionné dans les onglets ci-dessous, et ne prend effet que tant que ce passe est activé.
debug.view.model_input_pre_grade = Entrée du modèle (pré-gradage)
debug.view.model_input_pre_grade.tip = La couleur d'entrée du modèle exactement telle qu'elle était avant l'exécution du gradage d'entrée. Le gradage est appliqué sur place, le pipeline capture donc cette texture pour vous lorsque la vue est sélectionnée ; avec le gradage d'entrée activé, comparez-la à Entrée du modèle (préparée).
debug.view.model_input_prepared = Entrée du modèle (préparée)
debug.view.model_input_prepared.tip = L'image réellement fournie au modèle, après redimensionnement à l'échelle de travail, préparation HDR et gradage d'entrée si activé.
debug.view.model_input_source = Entrée du modèle (source)
debug.view.model_input_source.tip = La trame telle que capturée, avant tout traitement. C'est la sortie DLSS à partir de laquelle le modèle travaillera, à sa résolution native.
debug.view.model_output_composed = Sortie du modèle (composée)
debug.view.model_output_composed.tip = Le résultat final de ce passe, après que l'édition du modèle a été composée avec la source. C'est ce qui est écrit dans la cible.
debug.view.model_output_post_grade = Sortie du modèle (post-gradage)
debug.view.model_output_post_grade.tip = La sortie du modèle après l'exécution du gradage de sortie, dans le domaine SDR codé en sRGB propre au modèle - symétrique au gradage d'entrée sur l'entrée du modèle. Tout ce qui suit (composition, masque d'exposition, réécriture) la consomme comme si le modèle l'avait produite.
debug.view.model_output_raw = Sortie du modèle (brute)
debug.view.model_output_raw.tip = La sortie du modèle exactement telle que NGX l'a produite, avant l'application du gradage de sortie. Capture prise par le pipeline car le gradage s'exécute sur place ; avec le gradage de sortie activé, comparez-la à Sortie du modèle (post-gradage).
debug.view.motion_vectors = Vecteurs de mouvement
debug.view.motion_vectors.tip = Le champ de mouvement que ce passe évalue : les vecteurs du jeu, ou le champ produit par Correct Motion Vectors. Affiché avec R = direction x, G = direction y.
debug.view.off = Désactivée
debug.view.off.tip = Désactiver la vue de débogage et afficher la sortie composée normale.
debug.view.sdr_base_pre_model = Base SDR (pré-modèle)
debug.view.sdr_base_pre_model.tip = Porteur SDR linéaire en pleine résolution produit par la séparation BT.2446C. C'est la charge utile RVB à partir de laquelle le modèle est sous-échantillonné.
debug.view.temporal_candidate_status = État du candidat temporel
debug.view.temporal_candidate_status.tip = Confiance de reprojection avant validation de profondeur, affichée en niveaux de gris (blanc = entièrement fiable, noir = rejeté). La confiance combine l'accord de serrage d'édition local, l'accord photométrique et la confiance précédente. Indisponible tant qu'une édition précédente peut être reprojetée.
debug.view.temporal_reprojected_edit = Édition reprojetée temporelle
debug.view.temporal_reprojected_edit.tip = Gain log par canal validé de la trame précédente, associé afin que le gain neutre soit gris et que les éditions positives/négatives plus fortes se rapprochent du blanc/noir. Les pixels rejetés sont sombres.
debug.view.temporal_validation_status = État de validation temporelle
debug.view.temporal_validation_status.tip = Confiance après validation de profondeur, affichée en niveaux de gris. La confiance met à l'échelle le poids d'édition appliqué ; les valeurs faibles estompent l'édition vers l'entrée.
debug.view.tip = Remplacer l'image finale par une mémoire interne, pour inspecter le pipeline.

# exposure_mask
exposure_mask.chroma_threshold = Seuil de chroma
exposure_mask.chroma_threshold.tip = Différence minimale de chroma seule pour marquer une édition du modèle.
exposure_mask.edit_strength = Force d'édition
exposure_mask.edit_strength.tip = Met à l'échelle la différence entrée/sortie du modèle mesurée avant le seuillage.
exposure_mask.enabled = Activer
exposure_mask.enabled.tip = Ce passe construit son masque d'exposition après l'évaluation du modèle. Le masque n'affecte que la mesure HDR de la trame suivante de ce passe.
exposure_mask.luma_relative = Luma relative
exposure_mask.luma_relative.tip = Différence de luma minimale relative au luma d'entrée/sortie le plus clair.
exposure_mask.luma_threshold = Seuil de luma
exposure_mask.luma_threshold.tip = Différence de luma absolue minimale pour marquer une édition du modèle.
exposure_mask.response = Réponse temporelle
exposure_mask.response.tip = Mélanger les nouveaux votes du masque avec le masque de la trame précédente.
exposure_mask.smoothing = Lissage spatial
exposure_mask.smoothing.tip = Filtrer par majorité les votes d'exposition binaires dans un petit voisinage.
exposure_mask.title = Masque d'exposition

# grade
grade.black_level = Niveau de noir
grade.black_level.tip = La valeur de clarté OKLab associée au noir. Les valeurs positives assombrissent uniquement les ombres les plus profondes ; les valeurs négatives relèvent le point de pied.
grade.brightness = Luminosité
grade.brightness.tip = En mode Exposition, la valeur est en stops (-1 réduit de moitié la lumière linéaire ; +1 la double). Les autres modes utilisent leur propre courbe de luminosité.
grade.brightness_mode = Mode de luminosité
grade.brightness_mode.tip = Algorithme utilisé par la luminosité. Ce sont des alternatives, pas des couches.
grade.cas = Netteté CAS
grade.cas.tip = Activer AMD FidelityFX Contrast Adaptive Sharpening sur le résultat gradé. S'exécute comme une passe séparée en SDR linéaire uniquement ; ignoré pour les formats HDR.
grade.cas_strength = Force CAS
grade.cas_strength.tip = Intensité de netteté pour AMD FidelityFX CAS. 0 n'applique aucune netteté, 1 applique la netteté maximale.
grade.chroma_mode = Mode de chroma
grade.chroma_mode.saturation = Saturation
grade.chroma_mode.saturation.tip = Mettre à l'échelle le chroma OKLab par le même facteur tout en préservant la teinte perçue.
grade.chroma_mode.tip = Algorithme utilisé par la saturation. Ce sont des alternatives, pas des couches.
grade.chroma_mode.vibrance = Vibrance
grade.chroma_mode.vibrance.tip = Renforcer davantage les couleurs atténuées en OKLab, en réduisant l'effet à mesure que le chroma augmente.
grade.contrast = Contraste
grade.contrast.tip = Une courbe en S pivotée autour de la clarté moyenne. Positif augmente le contraste et négatif le réduit tout en gardant le noir et le blanc ancrés.
grade.edge_softening = Adoucissement conscient des bords
grade.edge_softening.tip = Mélanger un voisinage bilatéral conjoint 3x3 dans l'entrée du gradage. La similarité de luminance réduit le flou à travers les bords marqués.
grade.highlights = Hautes lumières
grade.highlights.tip = Ajuste les hautes lumières avec une courbe douce qui s'estompe avant le noir.
grade.luma_mode.exposure = Exposition
grade.luma_mode.exposure.tip = Multiplier le RVB en lumière linéaire par 2^montant (stops) ; le mappage de gamut protège les couleurs lorsque le résultat dépasse la plage de sortie.
grade.luma_mode.gain = Gain
grade.luma_mode.gain.tip = Met à l'échelle la clarté OKLab par une courbe multiplicative bornée.
grade.luma_mode.gamma = Gamma
grade.luma_mode.gamma.tip = Appliquer une courbe de puissance signée à la clarté OKLab. Le noir et le blanc neutres restent ancrés, concentrant l'effet dans les tons moyens.
grade.luma_mode.soft = Doux
grade.luma_mode.soft.tip = Un ajustement de clarté doux qui s'annule près du noir et du blanc.
grade.saturation = Saturation
grade.saturation.tip = Ajuste le chroma perçu en OKLab. Les couleurs hors gamut sont compressées vers l'axe neutre pour éviter les artefacts de recouvrement de canal.
grade.shadows = Ombres
grade.shadows.tip = Ajuste les ombres avec une courbe douce qui s'estompe avant le blanc.
grade.softening_strength = Force d'adoucissement
grade.softening_strength.tip = Quantité d'adoucissement bilatéral 3x3 conscient des bords.
grade.white_level = Niveau de blanc
grade.white_level.tip = La valeur de clarté OKLab associée au blanc. Élever le point abaisse l'image ; les couleurs hors gamut sont compressées plutôt que recoupées par canal.

# grade_backbuffer
grade_backbuffer.enabled = Activer
grade_backbuffer.enabled.tip = Gradier l'image finale du swapchain après chaque passe, juste avant la présentation. Cela est indépendant des gradages d'entrée et de sortie du modèle de chaque passe.
grade_backbuffer.title = Gradier le backbuffer

# hdr
hdr.adaptive.enabled = Exposition adaptative
hdr.adaptive.enabled.tip = Avec l'exposition du jeu désactivée, fournit une exposition globale à partir d'une mesure d'histogramme. Avec l'exposition du jeu activée, applique Strength Over Game comme correction bornée (aucun effet à 0). N'a aucun effet tant qu'une première mesure n'arrive pas.
hdr.adaptive.max_correction = Correction max (stops)
hdr.adaptive.max_correction.tip = Ajustement maximal autour de l'exposition du jeu lorsque les deux couches sont activées.
hdr.adaptive.midtone = Cible des tons moyens
hdr.adaptive.midtone.tip = Luminance cible pour la population sélectionnée.
hdr.adaptive.speed_down = Vitesse d'assombrissement
hdr.adaptive.speed_down.tip = Diminution maximale de l'exposition en stops par seconde.
hdr.adaptive.speed_up = Vitesse d'éclaircissement
hdr.adaptive.speed_up.tip = Augmentation maximale de l'exposition en stops par seconde.
hdr.adaptive.strength_over_game = Force sur le jeu
hdr.adaptive.strength_over_game.tip = Lorsque l'exposition du jeu est active, ajoute cette fraction de la correction en stops de la cible adaptive. Avec le jeu désactivé, Adaptive est l'exposition de base.
hdr.bt2446_ip = Genou BT.2446C
hdr.bt2446_ip.tip = Position du genou dans le domaine de la courbe BT.2446C. Le contenu au-dessus de ce point est compressé en log ; le contenu en dessous est linéaire. Le curseur couvre la plage utile pour un contenu HDR réel. Des valeurs en dehors peuvent tout de même être saisies : 10000 désactive la compression.
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = Pente de la région linéaire : Y_SDR = k1 * Y_HDR pour le contenu sous le point de genou. Aussi la pente que la branche log appaire au genou.
hdr.bt2446_k2 = BT.2446C k2 (dérivé)
hdr.bt2446_k2.tip = Pente de la région log de la courbe BT.2446C. Dérivée de k1, k3 et du point de genou, afin que la branche log appaire la pente de la branche linéaire au genou.
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = Force de compression des hautes lumières. Les valeurs plus grandes tirent la branche log plus bas, assombrissant davantage les hautes lumières. k2 et k4 en sont dérivés afin que la courbe reste lisse au genou.
hdr.bt2446_k4 = BT.2446C k4 (dérivé)
hdr.bt2446_k4.tip = Ordonnée à l'origine de la région log de la courbe BT.2446C. Dérivée de k1, k3 et du point de genou, afin que la branche log appaire la valeur de la branche linéaire au genou.
hdr.cat.advanced = Avancé
hdr.cat.diagnostics = Diagnostics
hdr.cat.filters = Filtres
hdr.common.available = disponible
hdr.common.no = non
hdr.common.not_seen = non vu
hdr.common.pending = en attente
hdr.common.ready = prêt
hdr.common.unavailable = indisponible
hdr.common.valid = valide
hdr.common.yes = oui
hdr.crosstalk = Diaphonie
hdr.crosstalk.tip = Quantité de prédésaturation BT.2446C.
hdr.density.full = Complet
hdr.density.full.tip = Échantillonner chaque pixel. Histogramme à densité complète, précision maximale.
hdr.density.quarter = 1/4
hdr.density.quarter.tip = Échantillonner un pixel sur deux sur chaque axe (1/4 de la trame). De petites hautes lumières isolées peuvent être manquées.
hdr.density.sixteenth = 1/16
hdr.density.sixteenth.tip = Échantillonner un pixel sur quatre sur chaque axe (1/16 de la trame). Les hautes lumières isolées et les détails fins peuvent être manqués.
hdr.density.sixty_fourth = 1/64
hdr.density.sixty_fourth.tip = Échantillonner un pixel sur huit sur chaque axe (1/64 de la trame). Convient uniquement à un contenu approximativement uniforme.
hdr.detailed_statistics = Statistiques HDR détaillées
hdr.detailed_statistics.tip = Collecter des statistiques complètes de plage et d'excursion de la gain map. Ajoute deux dispatches GPU lorsqu'activé.
hdr.diag.adaptive_scene_white = blanc de scène adaptatif : %.4f
hdr.diag.async_note = Les valeurs se mettent à jour de façon asynchrone. L'exposition et l'histogramme reflètent la mesure la plus récente que le GPU a fini d'écrire en retour.
hdr.diag.exposure = Exposition : %.4f
hdr.diag.format = Format : %s - resolved=%s
hdr.diag.gain_excursions = excursions SDR : %u
hdr.diag.gain_map = Gain map : %s
hdr.diag.gain_out_of_range = hors plage : %u
hdr.diag.gain_range = plage (log2) : %.3f .. %.3f
hdr.diag.game_exposure = Exposition du jeu : %s
hdr.diag.game_texture = texture : %ux%u fmt=%d
hdr.diag.game_value = valeur : %.4f
hdr.diag.guides = Guides DLSS : %s
hdr.diag.histogram = Histogramme (luminance log2)
hdr.diag.histogram.tip = Histogramme de la luminance log2 mesurée. La population dépend des filtres d'exposition actifs.
hdr.diag.histogram_missing = Histogramme : non prêt
hdr.diag.metering_source = Source de mesure : %s
hdr.diag.post_blocked = Post-DLSS bloqué : %s
hdr.diag.reference_luma = luma de référence : %.4f
hdr.diag.samples = Échantillons : %u - trames depuis la mesure : %u
hdr.diag.scene_white = blanc de scène : %.4f
hdr.diag.warming = Échauffage - aucune mesure d'exposition pour l'instant.
hdr.enabled = Activer
hdr.enabled.tip = Mesure l'image HDR juste avant ce passe. Les passes ultérieures mesurent l'image composée par la passe précédente, sauf si la réutilisation de mesure est activée. Les passes backbuffer utilisent une composition SDR.
hdr.format = Format
hdr.format.auto = Auto
hdr.format.auto.tip = Détecter le format automatiquement à partir de la source Pre/Post-DLSS active.
hdr.format.hdr10 = HDR10
hdr.format.hdr10.tip = Traiter la source comme HDR10 PQ (ST.2084).
hdr.format.scrgb = scRGB
hdr.format.scrgb.tip = Traiter la source comme scRGB linéaire (1,0 = 80 nits).
hdr.format.sdr = SDR
hdr.format.sdr.tip = Traiter la source comme SDR sRGB.
hdr.format.tip = Comment l'image source est encodée. Auto détecte à partir du format DXGI de la sortie DLSS.
hdr.gain_max = Gain max
hdr.gain_max.tip = Gain porteur-vers-HDR maximal attendu en stops log2. Utilisé uniquement par les statistiques de gain map de diagnostic et les vues de débogage ; n'affecte pas la composition.
hdr.gain_min = Gain min
hdr.gain_min.tip = Gain porteur-vers-HDR minimal attendu en stops log2. Utilisé uniquement par les statistiques de gain map de diagnostic et les vues de débogage ; n'affecte pas la composition.
hdr.game.bias = Biais d'exposition
hdr.game.bias.tip = Biais manuel relatif à l'exposition du jeu, en stops. Zéro laisse la valeur du jeu intacte.
hdr.game.enabled = Exposition du jeu
hdr.game.enabled.tip = Utiliser la ExposureTexture NGX du jeu comme exposition de base. Si le jeu n'en fournit pas, cette couche cède et l'exposition adaptative peut fournir la base à la place.
hdr.highlight_headroom = Réserve de hautes lumières
hdr.highlight_headroom.tip = Met à l'échelle le pic HDR effectif utilisé par BT.2446C. Cela ne change pas la manière dont l'exposition est interprétée.
hdr.layer.adaptive = Exposition adaptative
hdr.layer.adaptive.tip = Exposition globale basée sur l'histogramme ou une correction bornée sur l'exposition du jeu.
hdr.layer.game = Exposition du jeu
hdr.layer.game.tip = Configurer l'exposition du jeu comme couche de base.
hdr.layers.stack_order = Ordre de la pile : exposition du jeu en base, puis correction adaptative. L'exposition locale est sa propre section et s'applique après les deux.
hdr.measure_interval = Intervalle de mesure
hdr.measure_interval.tip = Fréquence de mesure des histogrammes HDR, en trames.
hdr.metering_density = Densité de mesure
hdr.metering_density.tip = Nombre de pixels échantillonnés par l'histogramme HDR. La densité complète capture chaque pixel ; les densités plus grossières échantillonnent moins de pixels à un coût GPU moindre.
hdr.reuse_previous_pass = Réutiliser la mesure HDR de la passe précédente
hdr.reuse_previous_pass.tip = Pour les passes suivantes dans la même chaîne Pre/Post-DLSS, réutiliser la mesure HDR de la passe précédente au lieu de lancer un nouvel histogramme. La première passe mesure encore la source du jeu.
hdr.source.filtered = Population filtrée
hdr.source.full_frame = Image entière
hdr.source.game_exposure = Exposition du jeu (NGX)
hdr.source.unknown = Inconnu
hdr.title = HDR

# hdr_filters
hdr_filters.depth = Profondeur
hdr_filters.depth.tip = Restreindre cette couche à l'intervalle de profondeur normalisé sélectionné.
hdr_filters.depth_far = Profondeur lointaine
hdr_filters.depth_far.tip = Extrémité lointaine de l'intervalle de profondeur normalisé accepté.
hdr_filters.depth_near = Profondeur proche
hdr_filters.depth_near.tip = Extrémité proche de l'intervalle de profondeur normalisé accepté.
hdr_filters.exposure_mask = Masque d'exposition
hdr_filters.exposure_mask.tip = Mesurer ou corriger uniquement les pixels pondérés par le masque d'exposition persistant.
hdr_filters.percentile_high = Percentile élevé
hdr_filters.percentile_high.tip = Limite de percentile supérieure pour cette couche.
hdr_filters.percentile_low = Percentile bas
hdr_filters.percentile_low.tip = Limite de percentile inférieure. Game/Adaptive utilisent la bande pour la mesure ; Local l'utilise comme bande de protection de luminance.
hdr_filters.percentile_range = Plage de percentiles
hdr_filters.percentile_range.tip = Pour Game/Adaptive, sélectionner une bande de percentiles de l'histogramme de cette couche. Pour l'exposition locale, estomper la correction locale hors de sa bande de luminance mesurée.

# local_exposure
local_exposure.bright_detail_protection = Protection des détails clairs
local_exposure.bright_detail_protection.tip = Contrôle si un voisinage sombre peut élever les pixels au-dessus du pivot. 1 garde les zones claires ancrées ; 0 autorise la correction au-delà du pivot.
local_exposure.cat.advanced = Avancé
local_exposure.dark_detail_protection = Protection des détails sombres
local_exposure.dark_detail_protection.tip = Contrôle si un voisinage clair peut assombrir les pixels sous le pivot. 1 garde les détails sombres ancrés ; 0 autorise la correction au-delà du pivot.
local_exposure.detail_retention = Rétention des détails
local_exposure.detail_retention.tip = Conserve le détail de log-luminance du pixel par rapport à sa base locale. 1 préserve tous les détails relatifs ; les valeurs plus faibles les compressent.
local_exposure.edge_protection = Protection des bords
local_exposure.edge_protection.tip = Réduit l'influence des échantillons à travers les bords marqués de log-luminance. 0 utilise uniquement des poids spatiaux ; des valeurs plus élevées réduisent les halos mais peuvent rendre l'adaptation plus locale.
local_exposure.enabled = Exposition locale
local_exposure.enabled.tip = Appliquer une correction d'exposition variant spatialement, pivotant sur un ton moyen référencé à l'affichage. Fonctionne sur toute source : le chemin HDR atteint le pivot via sa courbe de ton, un chemin référencé à l'affichage le lit dans l'image.
local_exposure.highlight_reduction = Réduction des hautes lumières
local_exposure.highlight_reduction.tip = Multiplicateur indépendant pour la réduction des hautes lumières. Mettre à zéro pour laisser les zones claires où elles sont tout en élevant encore les ombres.
local_exposure.highlight_transition = Transition des hautes lumières
local_exposure.highlight_transition.tip = Stops au-dessus du pivot des tons moyens sur lesquels la réduction des hautes lumières monte à pleine force. Une valeur plus petite agit plus agressivement.
local_exposure.max_brighten = Élévation max
local_exposure.max_brighten.tip = Élévation maximale des ombres en stops. Avec une protection complète des détails clairs, les pixels au-dessus du pivot des tons moyens ne sont pas élevés, même si leur voisinage est sombre.
local_exposure.max_darken = Assombrissement max
local_exposure.max_darken.tip = Réduction maximale des hautes lumières en stops. Avec une protection complète des détails sombres, les pixels sous le pivot ne sont pas assombris, même si leur voisinage est clair.
local_exposure.midtone = Ton moyen local
local_exposure.midtone.tip = Luminance pivot cible dans le domaine SDR du modèle. Les pixels près de ce pivot reçoivent peu de correction ; les ombres montent et les hautes lumières descendent vers lui.
local_exposure.radius = Rayon local
local_exposure.radius.tip = Rayon en pixels source. Un rayon de 1 désactive l'échantillonnage multi-tap du voisinage et n'utilise que le pixel central. Des rayons plus grands réagissent à des zones sombres/claires plus larges plutôt qu'au bruit d'un pixel individuel.
local_exposure.restore = Restaurer l'exposition du modèle
local_exposure.restore.tip = Appliquer une correction à la sortie du modèle après l'évaluation. Lorsque désactivé, la reconstruction locale de l'ombrage du modèle est laissée intacte.
local_exposure.restore_scale = Échelle spatiale de restauration
local_exposure.restore_scale.tip = Contrôle l'échelle spatiale de la restauration d'exposition : 0 = annulation exacte par pixel de l'élévation locale, 1 = correction globale uniforme, avec un mélange dans l'espace log entre elles. La restauration globale conserve davantage des relations de luminance reconstruites du modèle.
local_exposure.restore_strength = Force de restauration
local_exposure.restore_strength.tip = Quantité de restauration d'exposition : 0 = aucune correction, 1 = correction complète. Les valeurs intermédiaires mélangent la restauration sélectionnée dans l'espace du log-exposition.
local_exposure.samples = Échantillons du voisinage
local_exposure.samples.tip = Tap spatial demandé dans l'estimation de la log-luminance locale. Le compte effectif arrondit à des groupes de quatre pour garder l'échantillonnage spatialement équilibré.
local_exposure.shadow_lift = Élévation des ombres
local_exposure.shadow_lift.tip = Multiplicateur indépendant pour l'élévation des ombres. Mettre à zéro pour laisser les zones sombres où elles sont tout en réduisant encore les hautes lumières.
local_exposure.shadow_transition = Transition des ombres
local_exposure.shadow_transition.tip = Stops à partir du pivot des tons moyens sur lesquels l'élévation des ombres monte à pleine force. Une valeur plus petite agit plus agressivement sur les zones sombres.
local_exposure.strength = Force
local_exposure.strength.tip = Quantité globale de correction d'exposition locale.
local_exposure.title = Exposition locale

# pass
pass.auto_mask = Masque auto
pass.auto_mask.tip = Laisse le modèle détecter la peau des personnages et appliquer ses éditions séparément.
pass.cat.model = Modèle
pass.cat.residual_edits = Éditions résiduelles
pass.cat.strength = Force
pass.cat.temporal = Reprojection temporelle
pass.cheap_preset.auto = Auto
pass.cheap_preset.auto.tip = Utiliser le Render Preset propre à cette passe. Une seule fonctionnalité NGX sert les deux modèles.
pass.cheap_preset.performance = Performance
pass.cheap_preset.performance.tip = Créer la fonctionnalité du modèle économique avec l'indice 2.
pass.cheap_preset.quality = Qualité
pass.cheap_preset.quality.tip = Créer la fonctionnalité du modèle économique avec l'indice 1.
pass.chroma_strength = Force de chroma
pass.chroma_strength.tip = Fondre entre le chroma d'origine et le chroma édité.
pass.correct_motion = Corriger les vecteurs de mouvement
pass.correct_motion.tip = Produire un champ de mouvement à la confiance duquel cette passe peut se fier. La première passe Pre/Post-DLSS d'une trame conserve les vecteurs du jeu tels quels, car elle traite l'image pour laquelle ils ont été créés. Chaque passe suivante, et chaque passe backbuffer, reçoit un champ corrigé : la recherche est limitée à quelques pixels autour du vecteur du jeu et biaisée vers le champ précédent. Sans vecteurs du jeu, la passe les synthétise à partir de la couleur et de la profondeur. Alimente à la fois le modèle et la reprojection temporelle ; coûte un dispatch GPU par passe et nécessite un guide de profondeur utilisable.
pass.edit_strength = Force d'édition
pass.edit_strength.tip = Met à l'échelle l'édition du modèle avant de la reporter sur la source.
pass.enabled = Activer
pass.enabled.tip = Activer ou désactiver ce profil de passe. Les passes désactivées n'évaluent pas le modèle.
pass.grade_input.apply_to_pre_grade = Appliquer l'édition à l'image pré-gradage
pass.grade_input.apply_to_pre_grade.tip = Appliquer l'édition du modèle à l'image avant le gradage, afin que le gradage n'atteigne pas la sortie. Désactivé, la sortie du modèle gradée est utilisée telle quelle.
pass.grade_input.enabled = Gradier l'entrée du modèle
pass.grade_input.enabled.tip = Gradier l'image lue par le modèle, avant l'évaluation du modèle.
pass.grade_input.title = Gradier l'entrée du modèle
pass.grade_output.enabled = Gradier la sortie du modèle
pass.grade_output.enabled.tip = Gradier ce que le modèle a produit, avant d'être publié.
pass.grade_output.title = Gradier la sortie du modèle
pass.intensity = Intensité
pass.intensity.tip = À quel point le modèle est invité à éditer l'image.\n0 ignore totalement l'évaluation du modèle
pass.local_structure = Structure locale
pass.local_structure.tip = Quelle part du détail de structure locale du modèle appliquer.
pass.local_tone = Ton local
pass.local_tone.tip = Quelle part des ajustements de ton local du modèle appliquer.
pass.luma_strength = Force de luma
pass.luma_strength.tip = Fondre entre la luminance d'origine et la luminance éditée.
pass.menu.copy_from_next = Copier depuis la passe suivante
pass.menu.copy_from_previous = Copier depuis la passe précédente
pass.name = Nom
pass.name.tip = Étiquette affichée sur l'onglet de cette passe. Vide affiche la valeur par défaut positionnelle, \"Pass N\".
pass.order = Ordre des passes
pass.preset = Préréglage
pass.preset.a = A
pass.preset.a.tip = Utiliser le préréglage de modèle A. Les changements sont appliqués par évaluation et réinitialisent l'historique interne du modèle sans reconstruire la fonctionnalité.
pass.preset.b = B
pass.preset.b.tip = Utiliser le préréglage de modèle B. Les changements sont appliqués par évaluation et réinitialisent l'historique interne du modèle sans reconstruire la fonctionnalité.
pass.preset.c = C
pass.preset.c.tip = Utiliser le préréglage de modèle C. Les changements sont appliqués par évaluation et réinitialisent l'historique interne du modèle sans reconstruire la fonctionnalité.
pass.preset.tip = Sélectionner le préréglage de qualité/comportement du modèle pour cette passe.
pass.ratio_brighten = Ratio d'éclaircissement
pass.ratio_brighten.tip = Borne supérieure du ratio résiduel par canal lorsque Ratio Clamps est activé. S'applique à la composition SDR et HDR.
pass.ratio_clamps = Ratio Clamps
pass.ratio_clamps.tip = Borner le ratio log résiduel par canal à la plage [Ratio assombri, Ratio éclairci] avant la mise en forme. S'applique à la composition SDR et HDR.
pass.ratio_darken = Ratio assombri
pass.ratio_darken.tip = Borne inférieure du ratio résiduel par canal lorsque Ratio Clamps est activé. S'applique à la composition SDR et HDR.
pass.ratio_eps = Ratio Eps
pass.ratio_eps.tip = Plancher de dénominateur pour le ratio log résiduel par canal. Garde le résiduel fini lorsqu'un canal est proche de zéro. S'applique à la composition SDR et HDR.
pass.render_preset = Render Preset
pass.render_preset.performance = Performance
pass.render_preset.performance.tip = Indice 2 : le préréglage orienté performance.
pass.render_preset.quality = Qualité
pass.render_preset.quality.tip = Indice 1 : le préréglage orienté qualité.
pass.render_preset.tip = Indice DLSSNR.Hint.Render.Preset pour cette passe. NGX le verrouille à la création de la fonctionnalité, donc le changer reconstruit la fonctionnalité de cette passe.
pass.residual_chroma = Force de chroma
pass.residual_chroma.tip = Quelle part du chroma de l'édition atterrit par rapport à sa luminance.
pass.residual_gamma = Gamma d'édition
pass.residual_gamma.tip = Met en forme la courbe de réponse de l'édition.
pass.residual_highlight = Protection des hautes lumières
pass.residual_highlight.tip = Estompe l'édition au-dessus de la luminance moyenne à haute.
pass.residual_shadow = Protection des ombres
pass.residual_shadow.tip = Estompe l'édition en dessous de la luminance moyenne à basse.
pass.skin_structure = Structure de peau
pass.skin_structure.tip = Contrôle à quel point le modèle applique ses éditions spécifiques à la peau. Désactivé lorsque l'option de masquage automatique du modèle est désactivée.
pass.target = Cible
pass.target.backbuffer = Backbuffer
pass.target.backbuffer.tip = S'exécute sur le backbuffer final du swapchain lors de la présentation ReShade. Fonctionne même lorsque le jeu n'utilise pas DLSS ; il n'est pas ordonné avec les passes Pre/Post-DLSS sauf si ces étapes sont disponibles.
pass.target.post_dlss = Post-DLSS
pass.target.post_dlss.tip = S'exécute après l'évaluation DLSS du jeu sur sa sortie suréchantillonnée, avant la post-traitement ultérieur et l'UI.
pass.target.pre_dlss = Pre-DLSS
pass.target.pre_dlss.tip = S'exécute avant l'évaluation DLSS du jeu sur sa ressource Color d'entrée. Le jeu suréchantillonne ensuite l'image modifiée. Nécessite une entrée Color en pleine résolution.
pass.target.tip = Chaque passe peut cibler indépendamment Pre-DLSS, Post-DLSS ou Backbuffer. L'ordre d'exécution est groupé par étape ; les passes au sein de chaque étape suivent leur ordre d'onglet. Changer la cible réinitialise l'historique interne du modèle lors de sa prochaine évaluation.
pass.temporal.adaptive = Adaptatif
pass.temporal.adaptive.tip = Réutiliser l'édition reprojetée autant que la confiance par pixel le permet, en forçant un rafraîchissement au moins tous les N trames où N est le curseur Cadence. La cadence effective est divisée par deux lorsque la fraction de pixels invalides est élevée.
pass.temporal.cadence = Cadence
pass.temporal.cadence.tip = Nombre de trames entre les évaluations du modèle. En mode Adaptatif, c'est le maximum ; la cadence effective est divisée par deux lorsque la fraction de pixels invalides est élevée. En mode Fixe, c'est la cadence exacte.
pass.temporal.cheap = Modèle économique
pass.temporal.cheap.tip = Exécuter un second modèle moins coûteux sur les trames entre les évaluations complètes et prendre son édition là où la confiance de reprojection est faible. Désactivé, ces trames sont reconstruites à partir de l'historique seul, ce qui ne coûte rien de plus mais laisse les déocclusions et les mouvements rapides non résolus jusqu'à la prochaine évaluation complète.
pass.temporal.cheap_preset = Préréglage du modèle économique
pass.temporal.cheap_preset.tip = Render preset pour la fonctionnalité propre du modèle économique. Auto suit celle de cette passe, qui n'a besoin d'aucune seconde fonctionnalité ; les autres en créent une, car NGX verrouille l'indice à la création.
pass.temporal.cheap_scale = Échelle du modèle économique
pass.temporal.cheap_scale.tip = Résolution du modèle moins coûteux, en fraction de l'échelle de travail. 0,5 signifie 50 % de la résolution de l'échelle de travail. Les valeurs plus faibles sont plus rapides mais remplissent les zones de reprojection à faible confiance avec moins de détail.
pass.temporal.depth_abs = Prof. abs.
pass.temporal.depth_abs.tip = Différence de profondeur absolue autorisée après la reprojection du mouvement.
pass.temporal.depth_rel = Prof. rel.
pass.temporal.depth_rel.tip = Marge de différence de profondeur relative. Le seuil est le plus grand de cette marge et de Prof. abs.
pass.temporal.fixed = Fixe
pass.temporal.fixed.tip = Réutiliser l'édition reprojetée pour un nombre fixe de trames entre les évaluations du modèle, indépendamment de la confiance. Le curseur Cadence est la cadence exacte.
pass.temporal.fp16_history = Historique d'édition FP16
pass.temporal.fp16_history.tip = Stocker les textures d'édition/candidat temporelles en FP16. Réduit la bande passante et la mémoire de l'historique avec de petites différences de quantification sur les éditions réutilisées.
pass.temporal.max_invalid = % invalides max
pass.temporal.max_invalid.tip = Fraction maximale de pixels invalides ou en défaut de correspondance photométrique autorisée avant d'actualiser le modèle.
pass.temporal.max_motion = Mouvement max
pass.temporal.max_motion.tip = Rejeter la reprojection lorsque le mouvement dépasse ce nombre de pixels en résolution de travail.
pass.temporal.mode = Mode
pass.temporal.mode.tip = Réutilise une édition multiplicative du modèle reprojetée par le mouvement au lieu d'évaluer le modèle à chaque image. Nécessite la profondeur de l'image actuelle et un champ de mouvement - celui du jeu, ou produit par Correct Motion Vectors ; une histoire incertaine force une nouvelle évaluation.
pass.temporal.off = Désactivé
pass.temporal.off.tip = Évalue le modèle neuronal à chaque image.
pass.temporal.photo_abs = Photo Abs.
pass.temporal.photo_abs.tip = Différence de luminance d'entrée du modèle absolue autorisée entre le pixel actuel et son correspondant de l'image précédente reprojetée par le mouvement.
pass.temporal.photo_rel = Photo Rel.
pass.temporal.photo_rel.tip = Marge de différence de luminance relative, mise à l'échelle par la plus grande luminance absolue actuelle ou précédente. Ajoutée à Photo Abs.
pass.ui_correction = Correction UI
pass.ui_correction.tip = Réduit les éditions du modèle là où il détecte des éléments d'interface.
pass.upsample_sharpness = Netteté de Suréchantillonnage
pass.upsample_sharpness.tip = Exposant de préservation des bords pour la reconstruction bilatérale conjointe fixe 3x3 de l'entrée et de la sortie du modèle. Des valeurs plus élevées suivent les bords du guide en pleine résolution plus nettement ; des valeurs plus faibles mélangent plus doucement à travers le voisinage basse résolution. Cela n'échelonne pas l'édition du modèle.
pass.working_scale = Échelle de Travail
pass.working_scale.reset_tip = Réinitialise Échelle de Travail et x2 à leurs valeurs par défaut.
pass.working_scale.slider_tip = La résolution de travail du modèle en fraction de l'image.\n\nDes valeurs très basses sont élevées à un minimum de 180p de résolution verticale, afin que la reprojection temporelle dispose toujours d'une histoire utilisable. Changer cette valeur réinitialise l'histoire interne du modèle lors de sa prochaine évaluation.
pass.working_scale.tip = La résolution à laquelle le modèle s'exécute, en fraction de l'image. Cochez x2 pour la doubler pour le suréchantillonnage. La composition et le backbuffer restent à la résolution de l'image.
pass.working_scale.x2_off_tip = Double actuellement la résolution de travail du modèle pour le suréchantillonnage. Décochez pour revenir à la valeur du curseur. Changer ce réglage réinitialise l'histoire interne du modèle lors de sa prochaine évaluation.\n\nLa première image après le décochement peut également geler brièvement pendant l'allocation de ressources plus petites et la mise au rebut des précédentes sur le GPU.
pass.working_scale.x2_on_tip = Double la résolution de travail du modèle pour le suréchantillonnage. Cela réinitialise l'histoire interne du modèle lors de sa prochaine évaluation.\n\nAVERTISSEMENT : activer ceci peut geler le jeu pendant un bref moment sur la première image après basculement, pendant que les ressources de l'échelle de travail plus grandes (entrée/sortie de travail, histoire temporelle, référence non relevée) sont allouées et que les tampons précédemment en vol sont mis au rebut sur le GPU.\n\nAutres dangers :\n  - L'utilisation de VRAM est multipliée par environ quatre pour les ressources de l'échelle de travail.\n  - L'évaluation du modèle et la composition sont plus lentes à 2x.\n  - Le modèle économique réutilisé sur les images de réutilisation croît avec l'échelle de travail, donc les images de réutilisation sont aussi plus coûteuses.\n  - Un gel de plus d'une ou deux secondes signifie généralement que le périphérique a manqué de VRAM ; basculez ceci pour récupérer.

# prefs
prefs.clone_resources = Cloner les Ressources du Jeu
prefs.clone_resources.tip = Désactivé (par défaut) : lit les ressources de profondeur/mouvement actuelles du jeu et la sortie DLSS directement. Activé : copie la profondeur/mouvement de l'image actuelle, et la sortie DLSS lorsque Post-DLSS est activé, dans des textures appartenant à l'addon. Cette seule option s'applique à toutes les étapes, y compris Backbuffer ; le mode demandé est verrouillé en toute sécurité lors d'une nouvelle évaluation DLSS.
prefs.fp16_storage = Pipeline FP16
prefs.fp16_storage.tip = Stocke le porteur de carte de gain HDR, les textures de travail du modèle et la référence de composition non relevée en RGBA16F au lieu de RGBA32F. Réduit de moitié la bande passante et l'empreinte du pipeline HDR au coût d'une quantification dans le multiplicateur porteur-vers-HDR et les deltas du domaine du modèle. Les chemins SDR ne sont pas affectés. Le basculement réinitialise l'histoire temporelle et reconstruit la fonctionnalité NGX.
prefs.invert_fallback_depth = Inverser la Profondeur de Repli
prefs.invert_fallback_depth.tip = Inverse les valeurs de Profondeur Générique ReShade lorsqu'elles sont utilisées parce que l'évaluation DLSS n'a pas fourni de ressource de profondeur. N'altère pas la profondeur fournie par DLSS.
prefs.language = Langue
prefs.language.auto = Auto (ReShade)
prefs.language.tip = Langue de l'interface de l'addon. Auto suit le réglage de langue de ReShade.
prefs.show_tooltips = Afficher les Infobulles
prefs.show_tooltips.tip = Affiche les descriptions contextuelles en survolant les contrôles et les en-têtes de section.
prefs.title = Préférences

