# debug
debug.title = Debug
debug.view = Debug-Ansicht
debug.view.depth = Tiefe
debug.view.depth.tip = Der Tiefenpuffer, den das Spiel für DLSS bereitgestellt hat. Als Graustufen dargestellt.
debug.view.exposure_mask = Belichtungsmaske
debug.view.exposure_mask.tip = Die Maske des aktuellen Frames aus dem tatsächlichen Modelleingang (einschließlich Eingangs-Grading und lokaler Belichtung) gegenüber dem rohen Modellausgang. Sie wird für die Belichtung im nächsten Frame bereitgestellt.
debug.view.gain_map = Gain-Map
debug.view.gain_map.tip = Roher f32-Multiplikator für die Träger-zu-HDR-Rekonstruktion, dargestellt in log2-Blendenstufen von -4 (schwarz) bis +6 (weiß).
debug.view.game_exposure = Spielbelichtung
debug.view.game_exposure.tip = Spiel-NGX-Belichtung in Blendenstufen: 1,0x (0 Stufen) ist Mittelgrau; hellere/dunklere Werte bewegen sich Richtung Weiß/Schwarz. Magenta bedeutet, dass kein gültiger Wert gelesen wurde.
debug.view.hdr_local_exposure = Lokale HDR-Belichtung
debug.view.hdr_local_exposure.tip = Lokaler Belichtungsfaktor in Blendenstufen, zugeordnet sodass 0 Stufen Mittelgrau, -2 Stufen Schwarz und +2 Stufen Weiß sind.
debug.view.hdr_roundtrip_diagnostic = HDR-Hin- und Rückweg-Diagnose
debug.view.hdr_roundtrip_diagnostic.tip = 2x2-Vergleich: tatsächlicher vorbereiteter Modelleingang | Modellausgang / komponiertes HDR zurück auf den ungradierten Modellbereich abgebildet | Kompositionsdifferenz gegenüber dem ungradierten Modellausgang. Nicht-Null-Kanten sind zu erwarten, da vollauflösende Quelldetails erhalten bleiben; der Working Scale beeinflusst diesen Vergleich. Verwenden Sie HDR-Hin- und Rückweg-Fehler für die isolierte Trägerrekonstruktionsprüfung.
debug.view.hdr_roundtrip_error = HDR-Hin- und Rückweg-Fehler
debug.view.hdr_roundtrip_error.tip = Fehler in falschen Farben zwischen der ursprünglich decodierten HDR-Quelle und der direkten float32-Rekonstruktion aus dem RGBA32F-Träger und dem Träger-zu-HDR-Multiplikator. Dies validiert nur die Trägerübertragung, nicht die Modellbearbeitung oder die endgültige Komposition; unabhängig von Working Scale und Eingangs-Grading.
debug.view.hint = Die Ansicht wird von dem Pass gerendert, der aktuell in den unten stehenden Registerkarten ausgewählt ist, und greift nur, während dieser Pass aktiviert ist.
debug.view.model_input_pre_grade = Modelleingang (vor Grading)
debug.view.model_input_pre_grade.tip = Die Modelleingangsfarbe exakt so, wie sie vor dem Eingangs-Grading vorlag. Das Grading wird an Ort und Stelle angewendet, daher erstellt die Pipeline diesen Texturschnappschuss für Sie, wenn die Ansicht ausgewählt ist; mit aktiviertem Eingangs-Grading vergleichen Sie sie mit Modelleingang (vorbereitet).
debug.view.model_input_prepared = Modelleingang (vorbereitet)
debug.view.model_input_prepared.tip = Das tatsächlich dem Modell übergebene Bild, nach der Größenänderung auf den Working Scale, der HDR-Vorbereitung und dem Eingangs-Grading (falls aktiviert).
debug.view.model_input_source = Modelleingang (Quelle)
debug.view.model_input_source.tip = Der Frame beim Erfassen, vor jeglicher Verarbeitung. Dies ist der DLSS-Ausgang, mit dem das Modell arbeitet, in seiner nativen Auflösung.
debug.view.model_output_composed = Modellausgang (komponiert)
debug.view.model_output_composed.tip = Das Endergebnis dieses Passes, nachdem die Bearbeitung des Modells mit der Quelle komponiert wurde. Dies wird in das Ziel geschrieben.
debug.view.model_output_post_grade = Modellausgang (nach Grading)
debug.view.model_output_post_grade.tip = Der Modellausgang nach dem Output-Grading, im eigenen sRGB-kodierten SDR-Bereich des Modells – symmetrisch zum Eingangs-Grading am Modelleingang. Alles nachgelagerte (Komposition, Belichtungsmaske, Rückschreiben) verarbeitet dies, als hätte das Modell es erzeugt.
debug.view.model_output_raw = Modellausgang (roh)
debug.view.model_output_raw.tip = Der Modellausgang exakt so, wie NGX ihn erzeugt hat, vor der Anwendung des Output-Gradings. Schnappschuss durch die Pipeline, da das Grading an Ort und Stelle läuft; mit aktiviertem Output-Grading vergleichen Sie ihn mit Modellausgang (nach Grading).
debug.view.motion_vectors = Bewegungsvektoren
debug.view.motion_vectors.tip = Das Bewegungsfeld, das dieser Pass auswertet: die Vektoren des Spiels oder das Feld, das Correct Motion Vectors dafür erzeugt hat. Dargestellt als R = x-Richtung, G = y-Richtung.
debug.view.off = Aus
debug.view.off.tip = Die Debug-Ansicht deaktivieren und die normale komponierte Ausgabe anzeigen.
debug.view.sdr_base_pre_model = SDR-Basis (vor Modell)
debug.view.sdr_base_pre_model.tip = Vollauflösender linearer SDR-Träger, erzeugt durch die BT.2446C-Split. Dies ist die RGB-Nutzlast, aus der das Modell heruntergerechnet wird.
debug.view.temporal_candidate_status = Status des zeitlichen Kandidaten
debug.view.temporal_candidate_status.tip = Reprojektionsvertrauen vor der Tiefenvalidierung, dargestellt als Graustufen (weiß = voll vertraut, schwarz = verworfen). Das Vertrauen kombiniert lokale Edit-Clamp-Übereinstimmung, photometrische Übereinstimmung und vorheriges Vertrauen. Nicht verfügbar, bis ein vorheriger Edit reprojiziert werden kann.
debug.view.temporal_reprojected_edit = Zeitlich reprojizierte Bearbeitung
debug.view.temporal_reprojected_edit.tip = Validierter kanalweiser Log-Gain des vorherigen Frames, zugeordnet sodass neutraler Gain grau ist und stärkere positive/negative Bearbeitungen Richtung Weiß/Schwarz gehen. Verworfene Pixel sind dunkel.
debug.view.temporal_validation_status = Status der zeitlichen Validierung
debug.view.temporal_validation_status.tip = Vertrauen nach der Tiefenvalidierung, dargestellt als Graustufen. Das Vertrauen skaliert das angewandte Bearbeitungsgewicht; niedrige Werte lassen die Bearbeitung Richtung Eingang ausblenden.
debug.view.tip = Das endgültige Bild durch einen internen Puffer ersetzen, um die Pipeline zu untersuchen.

# exposure_mask
exposure_mask.chroma_threshold = Chroma-Schwelle
exposure_mask.chroma_threshold.tip = Mindest rein chrominanzbasierter Unterschied, um eine Modellbearbeitung zu markieren.
exposure_mask.edit_strength = Bearbeitungsstärke
exposure_mask.edit_strength.tip = Misst den Modell-Eingangs/Ausgangs-Unterschied vor der Schwellenwertbildung.
exposure_mask.enabled = Aktivieren
exposure_mask.enabled.tip = Dieser Pass erstellt seine Belichtungsmaske nach der Modellauswertung. Die Maske beeinflusst nur die HDR-Messung des nächsten Frames dieses Passes.
exposure_mask.luma_relative = Relatives Luma
exposure_mask.luma_relative.tip = Mindest Luma-Unterschied relativ zum helleren Eingangs-/Ausgangs-Luma.
exposure_mask.luma_threshold = Luma-Schwelle
exposure_mask.luma_threshold.tip = Mindest absoluter Luma-Unterschied, um eine Modellbearbeitung zu markieren.
exposure_mask.response = Zeitliche Antwort
exposure_mask.response.tip = Neue Masken-Stimmen mit der Maske des vorherigen Frames mischen.
exposure_mask.smoothing = Räumliche Glättung
exposure_mask.smoothing.tip = Die binären Belichtungs-Stimmen in einer kleinen Nachbarschaft per Mehrheitsfilter glätten.
exposure_mask.title = Belichtungsmaske

# grade
grade.black_level = Schwarzwert
grade.black_level.tip = Der OKLab-Helligkeitswert, der Schwarz zugeordnet wird. Positive Werte verdunkeln nur die tiefsten Schatten; negative Werte heben den Zehenbereich an.
grade.brightness = Helligkeit
grade.brightness.tip = Im Belichtungsmodus liegt der Wert in Blendenstufen (-1 halbiert lineares Licht; +1 verdoppelt es). Andere Modi nutzen ihre eigene Helligkeitskurve.
grade.brightness_mode = Helligkeitsmodus
grade.brightness_mode.tip = Welcher Algorithmus für die Helligkeit verwendet wird. Dies sind Alternativen, keine Ebenen.
grade.cas = CAS-Schärfung
grade.cas.tip = AMD FidelityFX Contrast Adaptive Sharpening auf dem gradierten Ergebnis aktivieren. Läuft als separate Ausführung nur in linearem SDR; für HDR-Formate übersprungen.
grade.cas_strength = CAS-Stärke
grade.cas_strength.tip = Schärfungsstärke für AMD FidelityFX CAS. 0 wendet keine Schärfung an, 1 die maximale Schärfung.
grade.chroma_mode = Chroma-Modus
grade.chroma_mode.saturation = Sättigung
grade.chroma_mode.saturation.tip = OKLab-Chroma um denselben Faktor skalieren, unter Beibehaltung des wahrgenommenen Farbtons.
grade.chroma_mode.tip = Welcher Algorithmus für die Sättigung verwendet wird. Dies sind Alternativen, keine Ebenen.
grade.chroma_mode.vibrance = Brillanz
grade.chroma_mode.vibrance.tip = Gedämpfte Farben in OKLab stärker anheben, wobei der Effekt mit steigendem Chroma abnimmt.
grade.contrast = Kontrast
grade.contrast.tip = Eine pivotierte S-Kurve um die mittlere Helligkeit. Positiv erhöht den Kontrast, negativ verringert ihn, während Schwarz und Weiß verankert bleiben.
grade.edge_softening = Kantenbewusstes Weichzeichnen
grade.edge_softening.tip = Ein gemeinsames bilaterales 3x3-Umfeld in den Grade-Eingang einblenden. Helligkeitsähnlichkeit verringert Unschärfe über starken Kanten.
grade.highlights = Lichter
grade.highlights.tip = Passt die Lichter mit einer weichen Kurve an, die vor Schwarz ausklingt.
grade.luma_mode.exposure = Belichtung
grade.luma_mode.exposure.tip = Lineares RGB-Licht mit 2^Betrag (Blendenstufen) multiplizieren; Gamut-Mapping schützt Farben, wenn das Ergebnis den Ausgabebereich überschreitet.
grade.luma_mode.gain = Gain
grade.luma_mode.gain.tip = OKLab-Helligkeit mit einer begrenzten multiplikativen Kurve skalieren.
grade.luma_mode.gamma = Gamma
grade.luma_mode.gamma.tip = Eine vorzeichenbehaftete Potenzkurve auf OKLab-Helligkeit anwenden. Neutrales Schwarz und Weiß bleiben verankert, der Effekt konzentriert sich auf die Mitten.
grade.luma_mode.soft = Weich
grade.luma_mode.soft.tip = Eine weiche Helligkeitsanpassung, die nahe Schwarz und Weiß auf null ausklingt.
grade.saturation = Sättigung
grade.saturation.tip = Passt die wahrgenommene Chroma in OKLab an. Außerhalb des Gamuts liegende Farben werden Richtung Neutralachse komprimiert, um Kanalübersteuerungs-Artefakte zu vermeiden.
grade.shadows = Schatten
grade.shadows.tip = Passt die Schatten mit einer weichen Kurve an, die vor Weiß ausklingt.
grade.softening_strength = Weichzeichnungsstärke
grade.softening_strength.tip = Menge des kantenbewussten 3x3-Weichzeichnens.
grade.white_level = Weißwert
grade.white_level.tip = Der OKLab-Helligkeitswert, der Weiß zugeordnet wird. Das Anheben des Punkts senkt das Bild; außerhalb des Gamuts liegende Farben werden komprimiert statt kanalüberschnitten.

# grade_backbuffer
grade_backbuffer.enabled = Aktiviert
grade_backbuffer.enabled.tip = Den finalen Swapchain-Bild nach jedem Pass gradieren, unmittelbar vor der Präsentation. Dies ist unabhängig von den Modelleingangs- und Modellausgangs-Grades jedes Passes.
grade_backbuffer.title = Backbuffer gradieren

# hdr
hdr.adaptive.enabled = Adaptive Belichtung
hdr.adaptive.enabled.tip = Bei deaktivierter Spielbelichtung liefert eine globale Belichtung aus einer Histogramm-Messung. Bei aktivierter Spielbelichtung wendet Strength Over Game als begrenzte Korrektur an (bei 0 kein Effekt). Hat keinen Effekt, bis die erste Messung eintrifft.
hdr.adaptive.max_correction = Maximale Korrektur (Blendenstufen)
hdr.adaptive.max_correction.tip = Maximale Anpassung um die Spielbelichtung, wenn beide Ebenen aktiviert sind.
hdr.adaptive.midtone = Mitten-Ziel
hdr.adaptive.midtone.tip = Ziel-Luminanz für die ausgewählte Population.
hdr.adaptive.speed_down = Abdunklungsgeschwindigkeit
hdr.adaptive.speed_down.tip = Maximale Belichtungsabnahme in Blendenstufen pro Sekunde.
hdr.adaptive.speed_up = Aufhellungsgeschwindigkeit
hdr.adaptive.speed_up.tip = Maximale Belichtungszunahme in Blendenstufen pro Sekunde.
hdr.adaptive.strength_over_game = Stärke über Spiel
hdr.adaptive.strength_over_game.tip = Wenn die Spielbelichtung aktiv ist, diesen Bruchteil der Stopp-Korrektur des adaptiven Ziels hinzufügen. Bei deaktiviertem Spiel ist Adaptive die Basibelichtung.
hdr.bt2446_ip = BT.2446C-Knicks
hdr.bt2446_ip.tip = Knieposition im BT.2446C-Kurvenbereich. Inhalte oberhalb dieses Punkts werden log-komprimiert; Inhalte darunter sind linear. Der Regler deckt den nützlichen Bereich für echtes HDR-Material ab. Werte außerhalb lassen sich dennoch eingeben: 10000 deaktiviert die Kompression.
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = Steigung des linearen Bereichs: Y_SDR = k1 * Y_HDR für Inhalte unter dem Knickpunkt. Auch die Steigung, die der Log-Zweig am Knie abgleicht.
hdr.bt2446_k2 = BT.2446C k2 (abgeleitet)
hdr.bt2446_k2.tip = Steigung des Log-Bereichs der BT.2446C-Kurve. Abgeleitet aus k1, k3 und dem Knickpunkt, sodass der Log-Zweig die Steigung des linearen Zweigs am Knie abgleicht.
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = Schulter-Komprimierungsstärke. Größere Werte ziehen den Log-Zweig stärker nach unten, dunkeln die Lichter stärker ab. k2 und k4 werden daraus abgeleitet, sodass die Kurve am Knie glatt bleibt.
hdr.bt2446_k4 = BT.2446C k4 (abgeleitet)
hdr.bt2446_k4.tip = Achsenabschnitt des Log-Bereichs der BT.2446C-Kurve. Abgeleitet aus k1, k3 und dem Knickpunkt, sodass der Log-Zweig den Wert des linearen Zweigs am Knie abgleicht.
hdr.cat.advanced = Erweitert
hdr.cat.diagnostics = Diagnose
hdr.cat.filters = Filter
hdr.common.available = verfügbar
hdr.common.no = nein
hdr.common.not_seen = nicht gesehen
hdr.common.pending = ausstehend
hdr.common.ready = bereit
hdr.common.unavailable = nicht verfügbar
hdr.common.valid = gültig
hdr.common.yes = ja
hdr.crosstalk = Übersprechen
hdr.crosstalk.tip = BT.2446C-Vorentsättigungsmenge.
hdr.density.full = Voll
hdr.density.full.tip = Jeden Pixel abtasten. Volldichten-Histogramm, höchste Genauigkeit.
hdr.density.quarter = 1/4
hdr.density.quarter.tip = Jeden 2. Pixel in jeder Achse abtasten (1/4 des Frames). Kleine isolierte Lichter können übersehen werden.
hdr.density.sixteenth = 1/16
hdr.density.sixteenth.tip = Jeden 4. Pixel in jeder Achse abtasten (1/16 des Frames). Isolierte Lichter und feine Details können übersehen werden.
hdr.density.sixty_fourth = 1/64
hdr.density.sixty_fourth.tip = Jeden 8. Pixel in jeder Achse abtasten (1/64 des Frames). Nur für grob gleichförmige Inhalte geeignet.
hdr.detailed_statistics = Detaillierte HDR-Statistiken
hdr.detailed_statistics.tip = Volle-Frame-Gain-Map-Bereichs- und Auslenkungsstatistiken erfassen. Fügt bei Aktivierung zwei GPU-Dispatches hinzu.
hdr.diag.adaptive_scene_white = adaptive scene white: %.4f
hdr.diag.async_note = Werte aktualisieren sich asynchron. Belichtung und Histogramm spiegeln die neueste Messung wider, die die GPU zurückgeschrieben hat.
hdr.diag.exposure = Belichtung: %.4f
hdr.diag.format = Format: %s - resolved=%s
hdr.diag.gain_excursions = SDR-Auslenkungen: %u
hdr.diag.gain_map = Gain-Map: %s
hdr.diag.gain_out_of_range = außerhalb des Bereichs: %u
hdr.diag.gain_range = Bereich (log2): %.3f .. %.3f
hdr.diag.game_exposure = Spielbelichtung: %s
hdr.diag.game_texture = Textur: %ux%u fmt=%d
hdr.diag.game_value = Wert: %.4f
hdr.diag.guides = DLSS-Guides: %s
hdr.diag.histogram = Histogramm (log2-Luminanz)
hdr.diag.histogram.tip = Histogramm der gemessenen log2-Luminanz. Die Population hängt von den aktiven Belichtungsfiltern ab.
hdr.diag.histogram_missing = Histogramm: nicht bereit
hdr.diag.metering_source = Messquelle: %s
hdr.diag.post_blocked = Post-DLSS blockiert: %s
hdr.diag.reference_luma = reference luma: %.4f
hdr.diag.samples = Samples: %u - Frames seit Messung: %u
hdr.diag.scene_white = Scene white: %.4f
hdr.diag.warming = Warmlauf - noch keine Belichtungsmessung.
hdr.enabled = Aktivieren
hdr.enabled.tip = Misst das HDR-Bild unmittelbar vor diesem Pass. Spätere Passes messen das vom vorherigen Pass komponierte Bild, sofern Messwiederverwendung nicht aktiviert ist. Backbuffer-Passes verwenden SDR-Komposition.
hdr.format = Format
hdr.format.auto = Auto
hdr.format.auto.tip = Das Format automatisch aus der aktiven Pre/Post-DLSS-Quelle erkennen.
hdr.format.hdr10 = HDR10
hdr.format.hdr10.tip = Die Quelle als HDR10 PQ (ST.2084) behandeln.
hdr.format.scrgb = scRGB
hdr.format.scrgb.tip = Die Quelle als lineares scRGB behandeln (1.0 = 80 nits).
hdr.format.sdr = SDR
hdr.format.sdr.tip = Die Quelle als SDR sRGB behandeln.
hdr.format.tip = Wie das Quellbild codiert ist. Auto erkennt aus dem DXGI-Format des DLSS-Ausgangs.
hdr.gain_max = Gain Max
hdr.gain_max.tip = Maximal erwartbarer Träger-zu-HDR-Gain in log2-Blendenstufen. Wird nur von den diagnostischen Gain-Map-Statistiken und Debug-Ansichten genutzt; beeinflusst die Komposition nicht.
hdr.gain_min = Gain Min
hdr.gain_min.tip = Minimal erwartbarer Träger-zu-HDR-Gain in log2-Blendenstufen. Wird nur von den diagnostischen Gain-Map-Statistiken und Debug-Ansichten genutzt; beeinflusst die Komposition nicht.
hdr.game.bias = Belichtungsbias
hdr.game.bias.tip = Manueller Bias relativ zur Spielbelichtung, in Blendenstufen. Null lässt den Wert des Spiels unverändert.
hdr.game.enabled = Spielbelichtung
hdr.game.enabled.tip = Die NGX-ExposureTexture des Spiels als Basibelichtung verwenden. Stellt das Spiel keine bereit, greift diese Ebene durch und Adaptive Belichtung kann stattdessen die Basis liefern.
hdr.highlight_headroom = Highlight-Spielraum
hdr.highlight_headroom.tip = Skaliert den effektiven HDR-Spitzenwert, der von BT.2446C genutzt wird. Dies ändert nicht, wie die Belichtung interpretiert wird.
hdr.layer.adaptive = Adaptive Belichtung
hdr.layer.adaptive.tip = Histogrammbasierte globale Belichtung oder eine begrenzte Korrektur über der Spielbelichtung.
hdr.layer.game = Spielbelichtung
hdr.layer.game.tip = Die Spielbelichtung als Basisebene konfigurieren.
hdr.layers.stack_order = Stapelreihenfolge: Spielbelichtung als Basis, dann Adaptive-Korrektur. Lokale Belichtung ist ein eigener Abschnitt und greift nach beiden.
hdr.measure_interval = Messintervall
hdr.measure_interval.tip = Wie oft HDR-Histogramme gemessen werden, in Frames.
hdr.metering_density = Messdichte
hdr.metering_density.tip = Wie viele Pixel das HDR-Histogramm abtastet. Volle Dichte erfasst jeden Pixel; gröbere Dichten tasten weniger Pixel bei geringeren GPU-Kosten ab.
hdr.reuse_previous_pass = HDR-Messung des vorherigen Passes wiederverwenden
hdr.reuse_previous_pass.tip = Für spätere Passes in derselben Pre-DLSS- oder Post-DLSS-Kette die HDR-Messung des vorherigen Passes wiederverwenden, anstatt ein neues Histogramm zu starten. Der erste Pass misst weiterhin die Quelle des Spiels.
hdr.source.filtered = Gefilterte Population
hdr.source.full_frame = Vollbild
hdr.source.game_exposure = Spielbelichtung (NGX)
hdr.source.unknown = Unbekannt
hdr.title = HDR

# hdr_filters
hdr_filters.depth = Tiefe
hdr_filters.depth.tip = Diese Ebene auf das ausgewählte normalisierte Tiefenintervall beschränken.
hdr_filters.depth_far = Tiefe Fern
hdr_filters.depth_far.tip = Fernes Ende des akzeptierten normalisierten Tiefenintervalls.
hdr_filters.depth_near = Tiefe Nah
hdr_filters.depth_near.tip = Nahes Ende des akzeptierten normalisierten Tiefenintervalls.
hdr_filters.exposure_mask = Belichtungsmaske
hdr_filters.exposure_mask.tip = Nur Pixel messen oder korrigieren, die mit der persistenten Belichtungsmaske gewichtet sind.
hdr_filters.percentile_high = Oberes Perzentil
hdr_filters.percentile_high.tip = Obere Perzentilgrenze für diese Ebene.
hdr_filters.percentile_low = Unteres Perzentil
hdr_filters.percentile_low.tip = Untere Perzentilgrenze. Game/Adaptive nutzen das Band zum Messen; Local nutzt es als Luminanz-Schutzbereich.
hdr_filters.percentile_range = Perzentilbereich
hdr_filters.percentile_range.tip = Für Game/Adaptive eine Perzentilband des Histogramms dieser Ebene auswählen. Für Lokale Belichtung den lokalen Korrektur außerhalb des gemessenen Luminanzbands ausblenden.

# local_exposure
local_exposure.bright_detail_protection = Heller-Detail-Schutz
local_exposure.bright_detail_protection.tip = Steuert, ob eine dunkle Nachbarschaft Pixel über den Pivot anheben darf. 1 verankert helle Stellen; 0 erlaubt Korrektur über den Pivot hinweg.
local_exposure.cat.advanced = Erweitert
local_exposure.dark_detail_protection = Dunkel-Detail-Schutz
local_exposure.dark_detail_protection.tip = Steuert, ob eine helle Nachbarschaft Pixel unter den Pivot abdunkeln darf. 1 verankert dunkle Details; 0 erlaubt Korrektur über den Pivot hinweg.
local_exposure.detail_retention = Detailerhalt
local_exposure.detail_retention.tip = Behält die log-Luminanz-Details des Pixels relativ zu seiner lokalen Basis. 1 bewahrt alle relativen Details; niedrigere Werte komprimieren sie.
local_exposure.edge_protection = Kantenschutz
local_exposure.edge_protection.tip = Reduziert den Einfluss von Samples über starken log-Luminanz-Kanten. 0 nutzt nur räumliche Gewichte; höhere Werte reduzieren Halos, können die Adaptation aber lokaler machen.
local_exposure.enabled = Lokale Belichtung
local_exposure.enabled.tip = Eine räumlich variierende Belichtungskorrektur anwenden, die auf einem anzeigebezogenen Mittenwert pivotiert. Funktioniert mit jeder Quelle: der HDR-Pfad erreicht den Pivot über seine Tonkurve, ein anzeigebezogener Pfad liest ihn aus dem Bild.
local_exposure.highlight_reduction = Highlight-Reduktion
local_exposure.highlight_reduction.tip = Unabhängiger Multiplikator für die Highlight-Reduktion. Auf null setzen, um helle Bereiche dort zu belassen, wo sie sind, während Schatten weiter angehoben werden.
local_exposure.highlight_transition = Highlight-Übergang
local_exposure.highlight_transition.tip = Blendenstufen oberhalb des Mitten-Pivots, über die die Highlight-Reduktion auf volle Stärke ansteigt. Ein kleinerer Wert wirkt aggressiver.
local_exposure.max_brighten = Max Anheben
local_exposure.max_brighten.tip = Maximale Schattenanhebung in Blendenstufen. Bei vollem hellen Detail-Schutz werden Pixel über dem Mitten-Pivot nicht angehoben, selbst wenn ihre Nachbarschaft dunkel ist.
local_exposure.max_darken = Max Abdunkeln
local_exposure.max_darken.tip = Maximale Highlight-Reduktion in Blendenstufen. Bei vollem dunklen Detail-Schutz werden Pixel unter dem Pivot nicht abgedunkelt, selbst wenn ihre Nachbarschaft hell ist.
local_exposure.midtone = Lokale Mitte
local_exposure.midtone.tip = Ziel-Luminanz-Pivot im SDR-Bereich des Modells. Pixel nahe diesem Pivot erhalten wenig Korrektur; Schatten steigen auf und Highlights sinken auf ihn zu.
local_exposure.radius = Lokaler Radius
local_exposure.radius.tip = Radius in Quellpixeln. Ein Radius von 1 deaktiviert die Mehrfach-Abtastung der Nachbarschaft und nutzt nur das Zentrumspixel. Größere Radien reagieren auf breitere dunkle/helle Bereiche statt auf einzelnes Pixelrauschen.
local_exposure.restore = Model-Belichtung wiederherstellen
local_exposure.restore.tip = Eine Korrektur auf den Modellausgang nach der Auswertung anwenden. Wenn deaktiviert, bleibt die rekonstruierte lokale Schattierung des Modells unangetastet.
local_exposure.restore_scale = Räumlicher Wiederherstellungsmaßstab
local_exposure.restore_scale.tip = Steuert den räumlichen Maßstab der Belichtungswiederherstellung: 0 = exakte pixelgenaue Aufhebung des lokalen Lifts, 1 = einheitliche globale Korrektur, mit log-Raum-Mischung dazwischen. Globale Wiederherstellung behält mehr der rekonstruierten Helligkeitsverhältnisse des Modells bei.
local_exposure.restore_strength = Wiederherstellungsstärke
local_exposure.restore_strength.tip = Menge der Belichtungswiederherstellung: 0 = keine Korrektur, 1 = volle Korrektur. Zwischenwerte mischen die ausgewählte Wiederherstellung im log-Belichtungsraum.
local_exposure.samples = Nachbarschafts-Samples
local_exposure.samples.tip = Angefragte räumliche Tap-Werte in der lokalen log-Luminanz-Schätzung. Die effektive Anzahl rundet auf Gruppen von vier, um die Abtastung räumlich ausgewogen zu halten.
local_exposure.shadow_lift = Schattenanhebung
local_exposure.shadow_lift.tip = Unabhängiger Multiplikator für die Schattenanhebung. Auf null setzen, um dunkle Bereiche dort zu belassen, wo sie sind, während Highlights weiter reduziert werden.
local_exposure.shadow_transition = Schatten-Übergang
local_exposure.shadow_transition.tip = Blendenstufen ab dem Mitten-Pivot, über die die Schattenanhebung auf volle Stärke ansteigt. Ein kleinerer Wert wirkt aggressiver auf dunkle Bereiche.
local_exposure.strength = Stärke
local_exposure.strength.tip = Gesamtmenge der lokalen Belichtungskorrektur.
local_exposure.title = Lokale Belichtung

# pass
pass.auto_mask = Auto-Maske
pass.auto_mask.tip = Lässt das Modell Charakterhaut erkennen und seine Bearbeitungen separat darauf anwenden.
pass.cat.model = Modell
pass.cat.residual_edits = Residual-Bearbeitungen
pass.cat.strength = Stärke
pass.cat.temporal = Zeitliche Reprojektion
pass.cheap_preset.auto = Auto
pass.cheap_preset.auto.tip = Den eigenen Render-Preset dieses Passes verwenden. Ein NGX-Feature bedient beide Modelle.
pass.cheap_preset.performance = Performance
pass.cheap_preset.performance.tip = Das Feature des günstigen Modells mit Hint 2 erzeugen.
pass.cheap_preset.quality = Qualität
pass.cheap_preset.quality.tip = Das Feature des günstigen Modells mit Hint 1 erzeugen.
pass.chroma_strength = Chroma-Stärke
pass.chroma_strength.tip = Zwischen ursprünglichem und bearbeitetem Chroma mischen.
pass.correct_motion = Bewegungsvektoren korrigieren
pass.correct_motion.tip = Ein Bewegungsfeld erzeugen, dem dieser Pass vertrauen kann. Der erste Pre/Post-DLSS-Pass eines Frames behält die Vektoren des Spiels unverändert, da er das Bild verarbeitet, für das sie erstellt wurden. Jeder Pass danach und jeder Backbuffer-Pass erhält ein korrigiertes Feld: die Suche ist auf wenige Pixel um den Spielvektor begrenzt und zum vorherigen Feld hin verschoben. Ohne Spielvektoren synthetisiert der Pass sie stattdessen aus Farbe und Tiefe. Speist sowohl das Modell als auch die zeitliche Reprojektion; kostet einen GPU-Dispatch pro Pass und benötigt eine nutzbare Tiefenführung.
pass.edit_strength = Bearbeitungsstärke
pass.edit_strength.tip = Skaliert die Bearbeitung des Modells, bevor sie auf die Quelle übertragen wird.
pass.enabled = Aktivieren
pass.enabled.tip = Dieses Pass-Profil aktivieren oder deaktivieren. Deaktivierte Passes werten das Modell nicht aus.
pass.grade_input.apply_to_pre_grade = Bearbeitung auf Vorgrade-Bild anwenden
pass.grade_input.apply_to_pre_grade.tip = Die Bearbeitung des Modells auf das Bild vor dem Grade anwenden, sodass der Grade das Ausgangsbild nicht erreicht. Aus, das gradierte Modellausgangsbild wird wie vorgegeben verwendet.
pass.grade_input.enabled = Modelleingang gradieren
pass.grade_input.enabled.tip = Das Bild, das das Modell liest, vor der Modellauswertung gradieren.
pass.grade_input.title = Modelleingang gradieren
pass.grade_output.enabled = Modellausgang gradieren
pass.grade_output.enabled.tip = Das vom Modell erzeugte Bild gradieren, bevor es veröffentlicht wird.
pass.grade_output.title = Modellausgang gradieren
pass.intensity = Intensität
pass.intensity.tip = Wie stark das Modell angewiesen wird, das Bild zu bearbeiten.\n0 überspringt die Modellauswertung vollständig
pass.local_structure = Lokale Struktur
pass.local_structure.tip = Wie viel von der lokalen Strukturdetail des Modells angewendet wird.
pass.local_tone = Lokaler Ton
pass.local_tone.tip = Wie viel von den lokalen Tonanpassungen des Modells angewendet wird.
pass.luma_strength = Luma-Stärke
pass.luma_strength.tip = Zwischen ursprünglicher und bearbeiteter Luminanz mischen.
pass.menu.copy_from_next = Von nächstem Pass kopieren
pass.menu.copy_from_previous = Von vorherigem Pass kopieren
pass.name = Name
pass.name.tip = Beschriftung auf der Pass-Registerkarte. Leer zeigt den positionsabhängigen Standard "Pass N" an.
pass.order = Pass-Reihenfolge
pass.preset = Preset
pass.preset.a = A
pass.preset.a.tip = Modell-Preset A verwenden. Änderungen werden pro Auswertung angewendet und setzen die interne Historie des Modells zurück, ohne das Feature neu aufzubauen.
pass.preset.b = B
pass.preset.b.tip = Modell-Preset B verwenden. Änderungen werden pro Auswertung angewendet und setzen die interne Historie des Modells zurück, ohne das Feature neu aufzubauen.
pass.preset.c = C
pass.preset.c.tip = Modell-Preset C verwenden. Änderungen werden pro Auswertung angewendet und setzen die interne Historie des Modells zurück, ohne das Feature neu aufzubauen.
pass.preset.tip = Das Qualitäts-/Verhaltens-Preset des Modells für diesen Pass auswählen.
pass.ratio_brighten = Ratio Anheben
pass.ratio_brighten.tip = Obere Grenze für das kanalweise Residualverhältnis, wenn Ratio Clamps aktiviert ist. Gilt sowohl für SDR- als auch HDR-Komposition.
pass.ratio_clamps = Ratio Clamps
pass.ratio_clamps.tip = Das kanalweise log-Residualverhältnis vor der Formung auf den Bereich [Ratio Dunkeln, Ratio Anheben] begrenzen. Gilt sowohl für SDR- als auch HDR-Komposition.
pass.ratio_darken = Ratio Dunkeln
pass.ratio_darken.tip = Untere Grenze für das kanalweise Residualverhältnis, wenn Ratio Clamps aktiviert ist. Gilt sowohl für SDR- als auch HDR-Komposition.
pass.ratio_eps = Ratio Eps
pass.ratio_eps.tip = Nenner-Boden für das kanalweise log-Residualverhältnis. Hält das Residual endlich, wenn ein Kanal nahe null liegt. Gilt sowohl für SDR- als auch HDR-Komposition.
pass.render_preset = Render-Preset
pass.render_preset.performance = Performance
pass.render_preset.performance.tip = Hint 2: das performance-orientierte Preset.
pass.render_preset.quality = Qualität
pass.render_preset.quality.tip = Hint 1: das qualitäts-orientierte Preset.
pass.render_preset.tip = DLSSNR.Hint.Render.Preset-Hinweis für diesen Pass. NGX verriegelt ihn bei der Feature-Erstellung, daher baut eine Änderung das Feature dieses Passes neu auf.
pass.residual_chroma = Chroma-Stärke
pass.residual_chroma.tip = Wie viel von der Chroma der Bearbeitung relativ zu ihrer Helligkeit landet.
pass.residual_gamma = Bearbeitungs-Gamma
pass.residual_gamma.tip = Formt die Antwortkurve der Bearbeitung.
pass.residual_highlight = Highlight-Schutz
pass.residual_highlight.tip = Lässt die Bearbeitung oberhalb von mittlerer bis hoher Helligkeit ausklingen.
pass.residual_shadow = Schatten-Schutz
pass.residual_shadow.tip = Lässt die Bearbeitung unterhalb von mittlerer bis niedriger Helligkeit ausklingen.
pass.skin_structure = Hautstruktur
pass.skin_structure.tip = Steuert, wie stark das Modell seine hautspezifischen Bearbeitungen anwendet. Deaktiviert, wenn die automatische Maskierungsoption des Modells aus ist.
pass.target = Ziel
pass.target.backbuffer = Backbuffer
pass.target.backbuffer.tip = Auf dem finalen Swapchain-Backbuffer bei ReShade Present ausführen. Funktioniert sogar, wenn das Spiel kein DLSS verwendet; es wird nicht mit Pre/Post-DLSS-Passes angeordnet, sofern diese Stufen nicht verfügbar sind.
pass.target.post_dlss = Post-DLSS
pass.target.post_dlss.tip = Nach der DLSS-Auswertung des Spiels auf dessen hochgerechnetem Ausgang ausführen, vor späterer Nachbearbeitung und UI.
pass.target.pre_dlss = Pre-DLSS
pass.target.pre_dlss.tip = Vor der DLSS-Auswertung des Spiels auf dessen Eingabe-Color-Ressource ausführen. Das Spiel rechnet dann das modifizierte Bild hoch. Erfordert eine Color-Eingabe in voller Auflösung.
pass.target.tip = Jeder Pass kann unabhängig Pre-DLSS, Post-DLSS oder Backbuffer als Ziel wählen. Die Ausführungsreihenfolge wird nach Stufe gruppiert; Passes innerhalb jeder Stufe folgen ihrer Pass-Registerkarten-Reihenfolge. Eine Änderung des Ziels setzt die interne Historie des Modells bei seiner nächsten Auswertung zurück.
pass.temporal.adaptive = Adaptiv
pass.temporal.adaptive.tip = Die reprojizierte Bearbeitung so weit wiederverwenden, wie es das Pixel-Vertrauen zulässt, und mindestens alle N Frames eine Aktualisierung erzwingen, wobei N der Cadence-Regler ist. Die effektive Cadence halbiert sich, wenn der Anteil ungültiger Pixel hoch ist.
pass.temporal.cadence = Cadence
pass.temporal.cadence.tip = Anzahl der Frames zwischen Modellauswertungen. Im Adaptiv-Modus ist dies das Maximum; die effektive Cadence halbiert sich, wenn der Anteil ungültiger Pixel hoch ist. Im Fest-Modus ist dies die genaue Cadence.
pass.temporal.cheap = Günstiges Modell
pass.temporal.cheap.tip = Ein zweites, günstigeres Modell auf den Frames zwischen vollen Auswertungen ausführen und dessen Bearbeitung dort übernehmen, wo das Reprojektionsvertrauen niedrig ist. Aus, diese Frames werden allein aus der Historie rekonstruiert, was nichts Extras kostet, aber Freistellungen und schnelle Bewegung bis zur nächsten vollen Auswertung unaufgelöst lässt.
pass.temporal.cheap_preset = Günstiges-Modell-Preset
pass.temporal.cheap_preset.tip = Render-Preset für das eigene Feature des günstigen Modells. Auto folgt dem dieses Passes, was kein zweites Feature benötigt; die anderen erstellen eines, da NGX den Hint bei der Erstellung verriegelt.
pass.temporal.cheap_scale = Günstiges-Modell-Skalierung
pass.temporal.cheap_scale.tip = Auflösung des günstigeren Modells, als Bruchteil des Working Scale. 0,5 bedeutet 50 % der Working-Scale-Auflösung. Niedrigere Werte sind schneller, füllen aber Bereiche mit niedrigem Reprojektionsvertrauen mit weniger Detail.
pass.temporal.depth_abs = Tiefe Abs.
pass.temporal.depth_abs.tip = Absoluter Tiefenunterschied, der nach der Bewegungsreprojektion erlaubt ist.
pass.temporal.depth_rel = Tiefe Rel.
pass.temporal.depth_rel.tip = Relativer Tiefenunterschied-Spielraum. Die Schwelle ist der Größere aus diesem Spielraum und Tiefe Abs.
pass.temporal.fixed = Fest
pass.temporal.fixed.tip = Die reprojizierte Bearbeitung für eine feste Anzahl von Frames zwischen Modellauswertungen wiederverwenden, unabhängig vom Vertrauen. Der Cadence-Regler ist die genaue Cadence.
pass.temporal.fp16_history = FP16-Bearbeitungshistorie
pass.temporal.fp16_history.tip = Zeitliche Bearbeitungs-/Kandidaten-Texturen in FP16 speichern. Reduziert Historie-Bandbreite und -speicher mit kleinen Quantisierungsunterschieden bei wiederverwendeten Bearbeitungen.
pass.temporal.max_invalid = Max Ungültig %
pass.temporal.max_invalid.tip = Maximal erlaubter Anteil ungültiger oder photometrisch nicht übereinstimmender Pixel, bevor das Modell aktualisiert wird.
pass.temporal.max_motion = Max Bewegung
pass.temporal.max_motion.tip = Reprojektion ablehnen, wenn die Bewegung diese Anzahl an Working-Resolution-Pixeln überschreitet.
pass.temporal.mode = Modus
pass.temporal.mode.tip = Eine bewegungsreprojizierte multiplikative Modellbearbeitung wiederverwenden, anstatt das Modell jeden Frame auszuwerten. Benötigt Tiefe des aktuellen Frames und ein Bewegungsfeld - das des Spiels oder eines, das Correct Motion Vectors erzeugt; unsichere Historie erzwingt eine neue Auswertung.
pass.temporal.off = Aus
pass.temporal.off.tip = Das neuronale Modell jeden Frame auswerten.
pass.temporal.photo_abs = Photo Abs.
pass.temporal.photo_abs.tip = Absoluter Modell-Eingangs-Luma-Unterschied, der zwischen dem aktuellen Pixel und seinem bewegungsreprojizierten Vor-Frame-Treffer erlaubt ist.
pass.temporal.photo_rel = Photo Rel.
pass.temporal.photo_rel.tip = Relativer Luma-Unterschied-Spielraum, skaliert mit dem größeren absoluten aktuellen oder vorherigen Luma. Zu Photo Abs. addiert.
pass.ui_correction = UI-Korrektur
pass.ui_correction.tip = Die Bearbeitungen des Modells dort reduzieren, wo es UI-Elemente erkennt.
pass.upsample_sharpness = Hochrechnungs-Schärfe
pass.upsample_sharpness.tip = Kantenerhaltungsexponent für die feste gemeinsame bilaterale 3x3-Rekonstruktion von Modelleingang und -ausgang. Höhere Werte folgen den Volldetail-Führungskanten schärfer; niedrigere Werte mischen sanfter über die Niedrigauflösungs-Nachbarschaft. Dies skaliert die Modellbearbeitung nicht.
pass.working_scale = Working Scale
pass.working_scale.reset_tip = Working Scale und x2 auf ihre Standardwerte zurücksetzen.
pass.working_scale.slider_tip = Die Arbeitsauflösung des Modells als Bruchteil des Frames.\n\nSehr niedrige Werte werden auf ein Minimum von 180p vertikaler Auflösung angehoben, sodass die zeitliche Reprojektion immer nutzbare Historie hat. Eine Änderung dieses Werts setzt die interne Historie des Modells bei seiner nächsten Auswertung zurück.
pass.working_scale.tip = Die Auflösung, in der das Modell läuft, als Bruchteil des Frames. Häkchen x2 setzt sie für Übersampling verdoppelt. Komposition und Backbuffer bleiben in Frame-Auflösung.
pass.working_scale.x2_off_tip = Aktuell wird die Working-Auflösung des Modells für Übersampling verdoppelt. Häkchen entfernen, um zum Wert des Reglers zurückzukehren. Eine Änderung dieser Einstellung setzt die interne Historie des Modells bei seiner nächsten Auswertung zurück.\n\nDer erste Frame nach dem Entfernen kann ebenfalls kurz einfrieren, während kleinere Ressourcen zugewiesen und die vorherigen auf der GPU ausgemustert werden.
pass.working_scale.x2_on_tip = Die Working-Auflösung des Modells für Übersampling verdoppeln. Dies setzt die interne Historie des Modells bei seiner nächsten Auswertung zurück.\n\nWARNUNG: Das Aktivieren kann den ersten Frame nach dem Umschalten kurz einfrieren, während die größeren Working-Scale-Ressourcen (Working-Eingang/Ausgang, zeitliche Historie, unlifted Referenz) zugewiesen und die zuvor fliegenden Puffer auf der GPU ausgemustert werden.\n\nWeitere Gefahren:\n  - VRAM-Nutzung der Working-Scale-Ressourcen vervierfacht sich etwa.\n  - Modellauswertung und Komposition sind bei 2x langsamer.\n  - Das auf Wiederverwendungs-Frames wiederverwendete günstige Modell wächst mit dem Working Scale, sodass Wiederverwendungs-Frames ebenfalls teurer sind.\n  - Ein Einfrieren länger als eine oder zwei Sekunden bedeutet meist, dass dem Gerät der VRAM ausgegangen ist; schalten Sie dies aus, um sich zu erholen.

# prefs
prefs.clone_resources = Spielressourcen klonen
prefs.clone_resources.tip = Aus (Standard): liest die aktuellen Tiefen-/Bewegungsressourcen des Spiels und den DLSS-Ausgang direkt. An: kopiert Tiefe/Bewegung des aktuellen Frames und den DLSS-Ausgang (wenn Post-DLSS aktiviert) in addon-eigene Texturen. Diese eine Option gilt für alle Stufen, einschließlich Backbuffer; der angeforderte Modus wird sicher bei einer neuen DLSS-Auswertung verriegelt.
prefs.fp16_storage = FP16-Pipeline
prefs.fp16_storage.tip = Die HDR-Gain-Map-Träger, Modellarbeits-Texturen und die unlifted Kompositionsreferenz in RGBA16F statt RGBA32F speichern. Halbiert Bandbreite und Fußabdruck der HDR-Pipeline auf Kosten der Quantisierung im Träger-zu-HDR-Multiplikator und den Modellbereichs-Deltas. SDR-Pfade sind nicht betroffen. Beim Umschalten wird die zeitliche Historie zurückgesetzt und das NGX-Feature neu aufgebaut.
prefs.invert_fallback_depth = Fallback-Tiefe invertieren
prefs.invert_fallback_depth.tip = Die ReShade Generic Depth-Werte invertieren, wenn sie verwendet werden, weil die DLSS-Auswertung keine Tiefenressource lieferte. Ändert die von DLSS gelieferte Tiefe nicht.
prefs.language = Sprache
prefs.language.auto = Auto (ReShade)
prefs.language.tip = Sprache der Add-on-Oberfläche. Auto folgt der Spracheinstellung von ReShade.
prefs.show_tooltips = Tooltips anzeigen
prefs.show_tooltips.tip = Kontextbezogene Beschreibungen beim Schwebezeigen über Steuerelemente und Abschnittsköpfe anzeigen.
prefs.title = Einstellungen

