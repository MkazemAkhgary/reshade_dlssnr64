# debug
debug.title = تصحيح الأخطاء
debug.view = عرض التصحيح
debug.view.depth = العمق
debug.view.depth.tip = مخزن العمق الذي زوّدت به اللعبة DLSS. يُعرض بتدرّج الرمادي.
debug.view.exposure_mask = قناع التعريض
debug.view.exposure_mask.tip = قناع الإطار الحالي من مدخل النموذج الفعلي (بما في ذلك درجات المدخل والتعريض المحلي) مقابل مخرج النموذج الخام. يُنشر لاستخدام التعريض في الإطار التالي.
debug.view.gain_map = خريطة الكسب
debug.view.gain_map.tip = مضاعف إعادة بناء الحامل إلى HDR خام f32، يُعرض بوحدات log2 من -4 (أسود) إلى +6 (أبيض).
debug.view.game_exposure = تعريض اللعبة
debug.view.game_exposure.tip = تعريض NGX الخاص باللعبة بوحدات التوقف: 1.0x (0 توقف) هو الرمادي المتوسط؛ القيم الأكثر إشراقًا أو ظلامًا تتحرك نحو الأبيض أو الأسود. اللون الأرجواني يعني عدم قراءة قيمة صالحة.
debug.view.hdr_local_exposure = التعريض المحلي HDR
debug.view.hdr_local_exposure.tip = عامل التعريض المحلي بوحدات التوقف، يُعيَّن بحيث 0 توقف هو الرمادي المتوسط، و-2 توقف أسود، و+2 توقف أبيض.
debug.view.hdr_roundtrip_diagnostic = تشخيص رحلة HDR الذهاب والإياب
debug.view.hdr_roundtrip_diagnostic.tip = مقارنة 2x2: مدخل النموذج المُحضَّر الفعلي | مخرج النموذج / HDR المُركَّب المُعاد تخطيطه إلى مجال النموذج غير المُدرَّج | الفرق في التركيب مقابل مخرج النموذج غير المُدرَّج. يمكن توقّع حواف غير صفرية لأن تفاصيل المصدر بدقة كاملة محفوظة؛ مقياس العمل يؤثر على هذه المقارنة. استخدم خطأ رحلة HDR للتحقق المنعزل من إعادة بناء الحامل.
debug.view.hdr_roundtrip_error = خطأ رحلة HDR الذهاب والإياب
debug.view.hdr_roundtrip_error.tip = الخطأ النسبي بألوان زائفة بين مصدر HDR المفكوك الأصلي وإعادة البناء المباشرة float32 من الحامل RGBA32F ومضاعف الحامل إلى HDR. هذا يتحقق من نقل الحامل فقط، لا من تعديل النموذج أو التركيب النهائي؛ ومستقل عن مقياس العمل ودرجة المدخل.
debug.view.hint = يُعرض المشهد بواسطة أي ممر مُحدَّد حاليًا في علامات التبويب أدناه، ولا يسري إلا أثناء تفعيل ذلك الممر.
debug.view.model_input_pre_grade = مدخل النموذج (قبل الدرجة)
debug.view.model_input_pre_grade.tip = لون مدخل النموذج كما كان تمامًا قبل تشغيل درجة المدخل. تُطبَّق الدرجة في مكانها، لذا يلتقط خط الأنابيب هذه القوام عند تحديد العرض؛ مع تفعيل درجة المدخل، قارنها بمدخل النموذج (المُحضَّر).
debug.view.model_input_prepared = مدخل النموذج (المُحضَّر)
debug.view.model_input_prepared.tip = الصورة المُغذّاة فعليًا إلى النموذج، بعد تغيير الحجم إلى مقياس العمل، وتحضير HDR، ودرجات المدخل عند تفعيلها.
debug.view.model_input_source = مدخل النموذج (المصدر)
debug.view.model_input_source.tip = الإطار كما التُقط، قبل أي معالجة. هذا هو مخرج DLSS الذي سيعمل النموذج منه، بدقته الأصلية.
debug.view.model_output_composed = مخرج النموذج (المُركَّب)
debug.view.model_output_composed.tip = النتيجة النهائية لهذا الممر، بعد تركيب تعديل النموذج مع المصدر. هذا ما يُكتب إلى الهدف.
debug.view.model_output_post_grade = مخرج النموذج (بعد الدرجة)
debug.view.model_output_post_grade.tip = مخرج النموذج بعد تشغيل درجة المخرج، في مجال SDR المُرمَّز بـ sRGB الخاص بالنموذج - متماثل مع درجة المدخل على مدخل النموذج. كل ما هو لاحق (التركيب، قناع التعريض، الإعادة) يستهلك هذا كما لو أنتجه النموذج.
debug.view.model_output_raw = مخرج النموذج (خام)
debug.view.model_output_raw.tip = مخرج النموذج تمامًا كما أنتجه NGX، قبل تطبيق درجة المخرج. تلتقط لقطة خط الأنابيب لأن الدرجة تعمل في مكانها؛ مع تفعيل درجة المخرج، قارنها بمخرج النموذج (بعد الدرجة).
debug.view.motion_vectors = متجهات الحركة
debug.view.motion_vectors.tip = حقل الحركة الذي يُقيِّم به هذا الممر: متجهات اللعبة، أو الحقل الذي أنتجه تصحيح متجهات الحركة. يُعرض كـ R = اتجاه x، G = اتجاه y.
debug.view.off = إيقاف
debug.view.off.tip = تعطيل عرض التصحيح وإظهار المخرج المُركَّب العادي.
debug.view.sdr_base_pre_model = قاعدة SDR (قبل النموذج)
debug.view.sdr_base_pre_model.tip = حامل SDR خطي بدقة كاملة ناتج عن انقسام BT.2446C. هذه هي حمولة RGB التي يُخفَّض النموذج منها.
debug.view.temporal_candidate_status = حالة المرشح الزمني
debug.view.temporal_candidate_status.tip = ثقة إعادة الإسقاط قبل التحقق من العمق، تُعرض بتدرّج الرمادي (الأبيض = موثوق تمامًا، الأسود = مرفوض). تجمع الثقة بين اتفاق تثبيت التعديل المحلي، والاتفاق الضوئي، والثقة السابقة. غير متاحة حتى يمكن إعادة إسقاط تعديل سابق.
debug.view.temporal_reprojected_edit = التعديل الزمني المُعاد إسقاطه
debug.view.temporal_reprojected_edit.tip = كسب لوغاريتمي لكل قناة مُتحقَّق منه من الإطار السابق، يُعيَّن بحيث الكسب المحايد رمادي والتعديلات الإيجابية أو السلبية الأقوى تتحرك نحو الأبيض أو الأسود. البكسلات المرفوضة داكنة.
debug.view.temporal_validation_status = حالة التحقق الزمني
debug.view.temporal_validation_status.tip = الثقة بعد التحقق من العمق، تُعرض بتدرّج الرمادي. الثقة تضبط وزن التعديل المُطبَّق؛ القيم المنخفضة تُبهت التعديل نحو المدخل.
debug.view.tip = استبدال الصورة النهائية بمخزن داخلي، لفحص خط الأنابيب.

# exposure_mask
exposure_mask.chroma_threshold = عتبة اللونية
exposure_mask.chroma_threshold.tip = الحد الأدنى للفرق في اللونية فقط لتمييز تعديل النموذج.
exposure_mask.edit_strength = قوة التعديل
exposure_mask.edit_strength.tip = ضبط فرق مدخل ومخرج النموذج المقاس قبل العتبة.
exposure_mask.enabled = تفعيل
exposure_mask.enabled.tip = يُنشئ هذا الممر قناع التعريض الخاص به بعد تقييم النموذج. يؤثر القناع فقط على قياس HDR لإطار هذا الممر التالي.
exposure_mask.luma_relative = الإضاءة النسبية
exposure_mask.luma_relative.tip = الحد الأدنى لفرق الإضاءة بالنسبة إلى إضاءة المدخل أو المخرج الأكثر سطوعًا.
exposure_mask.luma_threshold = عتبة الإضاءة
exposure_mask.luma_threshold.tip = الحد الأدنى المطلق لفرق الإضاءة لتمييز تعديل النموذج.
exposure_mask.response = الاستجابة الزمنية
exposure_mask.response.tip = دمج أصوات القناع الجديدة مع قناع الإطار السابق.
exposure_mask.smoothing = التنعيم المكاني
exposure_mask.smoothing.tip = تصفية الأغلبية لأصوات التعريض الثنائية في حي صغير.
exposure_mask.title = قناع التعريض

# grade
grade.black_level = مستوى الأسود
grade.black_level.tip = قيمة إضاءة OKLab المُعيَّنة إلى الأسود. القيم الموجبة تُعتِم أعمق الظلال فقط؛ القيم السالبة ترفع أصابع الظلال.
grade.brightness = السطوع
grade.brightness.tip = في وضع التعريض، القيمة بوحدات التوقف (-1 يُخفِّض الضوء الخطي إلى النصف؛ +1 يضاعفه). الأوضاع الأخرى تستخدم منحنى السطوع الخاص بها.
grade.brightness_mode = وضع السطوع
grade.brightness_mode.tip = أي خوارزمية يستخدمها السطوع. هذه بدائل، لا طبقات.
grade.cas = تنقية CAS
grade.cas.tip = تفعيل تنقية التباين التكيفي AMD FidelityFX على النتيجة المُدرَّجة. يعمل كإرسال منفصل في SDR خطي فقط؛ ويُتخطَّى لصيغ HDR.
grade.cas_strength = قوة CAS
grade.cas_strength.tip = مقدار التنقية لـ AMD FidelityFX CAS. 0 لا يطبق تنقية، و1 يطبق أقصى تنقية.
grade.chroma_mode = وضع اللونية
grade.chroma_mode.saturation = التشبع
grade.chroma_mode.saturation.tip = ضبط لونية OKLab بنفس العامل مع الحفاظ على درجة اللون المدركة.
grade.chroma_mode.tip = أي خوارزمية يستخدمها التشبع. هذه بدائل، لا طبقات.
grade.chroma_mode.vibrance = الحيوية
grade.chroma_mode.vibrance.tip = تعزيز الألوان الباهتة بقوة أكبر في OKLab، مع تقليل التأثير كلما ارتفعت اللونية.
grade.contrast = التباين
grade.contrast.tip = منحنى S محوري حول منتصف الإضاءة. القيم الموجبة تزيد التباين والسالبة تقلّله مع تثبيت الأسود والأبيض.
grade.edge_softening = تنعيم واعٍ بالحواف
grade.edge_softening.tip = دمج حي ثنائي مشترك 3x3 في مدخل الدرجة. تشابه الإضاءة يقلل الضبابية عبر الحواف القوية.
grade.highlights = الإبرازات
grade.highlights.tip = يضبط الإبرازات بمنحنى ناعم يتلاشى قبل الأسود.
grade.luma_mode.exposure = التعريض
grade.luma_mode.exposure.tip = ضرب RGB بالضوء الخطي في 2^القيمة (توقفات)؛ خريطة النطاق تحمي الألوان عندما تتجاوز النتيجة نطاق المخرج.
grade.luma_mode.gain = الكسب
grade.luma_mode.gain.tip = يضبط إضاءة OKLab بمنحنى ضربي محدود.
grade.luma_mode.gamma = غاما
grade.luma_mode.gamma.tip = تطبيق منحنى قوة موقَّع على إضاءة OKLab. يبقى الأسود والأبيض المحايد مثبَّتين، مع تركيز التأثير في النغمات المتوسطة.
grade.luma_mode.soft = ناعم
grade.luma_mode.soft.tip = ضبط إضاءة ناعم يتلاشى إلى الصفر قرب الأسود والأبيض.
grade.saturation = التشبع
grade.saturation.tip = يضبط اللونية المدركة في OKLab. تُضغط الألوان خارج النطاق نحو المحور المحايد لتجنّب تشوّهات قطع القنوات.
grade.shadows = الظلال
grade.shadows.tip = يضبط الظلال بمنحنى ناعم يتلاشى قبل الأبيض.
grade.softening_strength = قوة التنعيم
grade.softening_strength.tip = مقدار التنعيم الواعي بالحواف 3x3.
grade.white_level = مستوى الأبيض
grade.white_level.tip = قيمة إضاءة OKLab المُعيَّنة إلى الأبيض. رفع النقطة يخفّض الصورة؛ تُضغط الألوان خارج النطاق بدلًا من قطع القنوات.

# grade_backbuffer
grade_backbuffer.enabled = مُفعَّل
grade_backbuffer.enabled.tip = دَرْج صورة سلسلة المبادلة النهائية بعد كل ممر، مباشرة قبل العرض. هذا مستقل عن درجات مدخل ومخرج النموذج لكل ممر.
grade_backbuffer.title = دَرْج Backbuffer

# hdr
hdr.adaptive.enabled = التعريض التكيفي
hdr.adaptive.enabled.tip = مع إيقاف تعريض اللعبة، يوفّر تعريضًا عامًا من قياس المدرَّج. مع تفعيل تعريض اللعبة، يطبّق القوة فوق اللعبة كتصحيح محدود (لا تأثير عند 0). لا تأثير حتى يصل القياس الأول.
hdr.adaptive.max_correction = أقصى توقفات التصحيح
hdr.adaptive.max_correction.tip = الحد الأقصى للضبط حول تعريض اللعبة عند تفعيل الطبقتين.
hdr.adaptive.midtone = هدف النغمات المتوسطة
hdr.adaptive.midtone.tip = الإضاءة المستهدفة للمجموعة المحددة.
hdr.adaptive.speed_down = سرعة التعتيم
hdr.adaptive.speed_down.tip = الحد الأقصى لانخفاض التعريض بوحدات التوقف في الثانية.
hdr.adaptive.speed_up = سرعة الإضاءة
hdr.adaptive.speed_up.tip = الحد الأقصى لزيادة التعريض بوحدات التوقف في الثانية.
hdr.adaptive.strength_over_game = القوة فوق اللعبة
hdr.adaptive.strength_over_game.tip = عند تفعيل تعريض اللعبة، أضف هذا الجزء من تصحيح توقف الهدف التكيفي. مع تعطيل اللعبة، يكون التكيفي هو التعريض الأساسي.
hdr.bt2446_ip = نقطة الانثناء BT.2446C
hdr.bt2446_ip.tip = موضع الركبة في مجال منحنى BT.2446C. المحتوى فوق هذه النقطة مضغوط لوغاريتميًا؛ والمحتوى تحتها خطي. يغطي المنزلق النطاق المفيد لمحتوى HDR الحقيقي. يمكن كتابة قيم خارجه: 10000 يُعطّل الضغط.
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = ميل المنطقة الخطية: Y_SDR = k1 * Y_HDR للمحتوى أسفل نقطة الانثناء. وهو أيضًا الميل الذي يطابقه الفرع اللوغاريتمي عند الركبة.
hdr.bt2446_k2 = BT.2446C k2 (مُشتق)
hdr.bt2446_k2.tip = ميل المنطقة اللوغاريتمية لمنحنى BT.2446C. مُشتق من k1 وk3 ونقطة الانثناء بحيث يطابق الفرع اللوغاريتمي ميل الفرع الخطي عند الركبة.
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = قوة ضغط الكتف. القيم الأكبر تُرجع الفرع اللوغاريتمي للأسفل بقوة أكبر، مُعتِمة الإبرازات أكثر. يُشتق k2 وk4 من هذا لتبقى المنحنى ناعمًا عند الركبة.
hdr.bt2446_k4 = BT.2446C k4 (مُشتق)
hdr.bt2446_k4.tip = نقطة تقاطع المنطقة اللوغاريتمية لمنحنى BT.2446C. مُشتق من k1 وk3 ونقطة الانثناء بحيث يطابق الفرع اللوغاريتمي قيمة الفرع الخطي عند الركبة.
