# debug
debug.title = Hata Ayıklama
debug.view = Hata Ayıklama Görünümü
debug.view.depth = Derinlik
debug.view.depth.tip = Oyunun DLSS'e sağladığı derinlik tamponu. Gri tonlama olarak gösterilir.
debug.view.exposure_mask = Pozlama Maskesi
debug.view.exposure_mask.tip = Gerçek model girişinden (girdi derecelendirmesi ve Yerel Pozlama dahil) gelen ve ham model çıktısına karşı olan geçerli karenin maskesi. Bir sonraki karede pozlama kullanımı için yayınlanır.
debug.view.gain_map = Kazanç Haritası
debug.view.gain_map.tip = Ham f32 taşıyıcıdan-HDR'ye yeniden yapılandırma çarpanı, -4 (siyah) ile +6 (beyaz) arasındaki log2 durakları olarak gösterilir.
debug.view.game_exposure = Oyun Pozlaması
debug.view.game_exposure.tip = Oyun NGX pozlaması durak cinsinden: 1.0x (0 durak) orta gridir; daha parlak/karanlık değerler beyaza/siyaha doğru kayar. Macenta, geçerli bir değer okunmadığını gösterir.
debug.view.hdr_local_exposure = HDR Yerel Pozlama
debug.view.hdr_local_exposure.tip = Durak cinsinden yerel pozlama faktörü; 0 durak orta gri, -2 durak siyah ve +2 durak beyaz olacak şekilde eşlenir.
debug.view.hdr_roundtrip_diagnostic = HDR Gidiş-Dönüş Teşhisi
debug.view.hdr_roundtrip_diagnostic.tip = 2x2 karşılaştırma: gerçek hazırlanmış Model Girişi | Model Çıktısı / bileşik HDR'nin derecelendirilmemiş model etki alanına geri eşlenmesi | derecelendirilmemiş Model Çıktısına karşı bileşim farkı. Tam çözünürlüklü kaynak ayrıntısı korunduğu için sıfır olmayan kenarlar beklenebilir; çalışma ölçeği bu karşılaştırmayı etkiler. Yalıtılmış taşıyıcı yeniden yapılandırma kontrolü için HDR Gidiş-Dönüş Hatası'nı kullanın.
debug.view.hdr_roundtrip_error = HDR Gidiş-Dönüş Hatası
debug.view.hdr_roundtrip_error.tip = Orijinal çözülmüş HDR kaynağı ile RGBA32F taşıyıcısından ve taşıyıcıdan-HDR'ye çarpandan elde edilen doğrudan float32 yeniden yapılandırması arasındaki yanlış renkli bağıl hata. Bu yalnızca taşıyıcı aktarımını doğrular; model düzenlemesini veya nihai bileşimi değil; Çalışma Ölçeği ve girdi derecesinden bağımsızdır.
debug.view.hint = Görünüm, aşağıdaki sekmelerde şu anda seçili olan pass tarafından işlenir ve yalnızca o pass etkinken geçerlidir.
debug.view.model_input_pre_grade = Model Girişi (derecelendirme öncesi)
debug.view.model_input_pre_grade.tip = Giriş Derecesi çalıştırılmadan önceki haliyle model giriş rengi. Derece yerinde uygulandığından, görünüm seçildiğinde ardışık düzen bu dokuyu sizin için anlık görüntüler; Giriş Derecesi etkinse, bunu Model Girişi (hazırlanmış) ile karşılaştırın.
debug.view.model_input_prepared = Model Girişi (hazırlanmış)
debug.view.model_input_prepared.tip = Çalışma Ölçeğine yeniden boyutlandırma, HDR hazırlığı ve etkinse girdi derecelendirmesinden sonra modele gerçekten verilen görüntü.
debug.view.model_input_source = Model Girişi (kaynak)
debug.view.model_input_source.tip = Herhangi bir işleme tabi tutulmadan önce yakalanan kare. Bu, modelin üzerinde çalışacağı, yerel çözünürlüğündeki DLSS çıktısıdır.
debug.view.model_output_composed = Model Çıktısı (bileşik)
debug.view.model_output_composed.tip = Bu pass'in nihai sonucu, modelin düzenlemesi kaynakla birleştirildikten sonra. Hedefe yazılan şey budur.
debug.view.model_output_post_grade = Model Çıktısı (derecelendirme sonrası)
debug.view.model_output_post_grade.tip = Çıktı Derecesi çalıştırıldıktan sonraki model çıktısı, modelin kendi sRGB kodlu SDR etki alanında - model girişindeki Giriş Derecesine simetrik. Akışın geri kalanı (bileşim, pozlama maskesi, geri yazım) bunu model üretmiş gibi tüketir.
debug.view.model_output_raw = Model Çıktısı (ham)
debug.view.model_output_raw.tip = Çıktı Derecesi uygulanmadan önce, NGX'in ürettiği haliyle model çıktısı. Derece yerinde çalıştığı için anlık görüntü ardışık düzen tarafından alınır; Çıktı Derecesi etkinse, bunu Model Çıktısı (derecelendirme sonrası) ile karşılaştırın.
debug.view.motion_vectors = Hareket Vektörleri
debug.view.motion_vectors.tip = Bu pass'in değerlendirdiği hareket alanı: oyunun vektörleri veya Doğru Hareket Vektörleri'nin bunun için ürettiği alan. R = x yönü, G = y yönü olarak gösterilir.
debug.view.off = Kapalı
debug.view.off.tip = Hata ayıklama görünümünü devre dışı bırak ve normal bileşik çıktıyı göster.
debug.view.sdr_base_pre_model = SDR Tabanı (model öncesi)
debug.view.sdr_base_pre_model.tip = BT.2446C ayrımı tarafından üretilen tam çözünürlüklü doğrusal SDR taşıyıcısı. Bu, modelin alt örneklediği RGB yüküdür.
debug.view.temporal_candidate_status = Zamansal Aday Durumu
debug.view.temporal_candidate_status.tip = Derinlik doğrulamasından önceki yeniden projeksiyon güveni, gri tonlama olarak gösterilir (beyaz = tamamen güvenilir, siyah = reddedildi). Güven; yerel düzenleme-kelepçe uyumu, fotometrik uyum ve önceki güveni birleştirir. Önceki bir düzenleme yeniden projekte edilene kadar kullanılamaz.
debug.view.temporal_reprojected_edit = Zamansal Yeniden Projekte Düzenleme
debug.view.temporal_reprojected_edit.tip = Önceki kareden doğrulanmış kanal başına log-kazanç; nötr kazanç gri, daha güçlü pozitif/negatif düzenlemeler beyaza/siyaha doğru kayacak şekilde eşlenir. Reddedilen pikseller koyudur.
debug.view.temporal_validation_status = Zamansal Doğrulama Durumu
debug.view.temporal_validation_status.tip = Derinlik doğrulamasından sonraki güven, gri tonlama olarak gösterilir. Güven, uygulanan düzenleme ağırlığını ölçekler; düşük değerler düzenlemeyi girdiye doğru söndürür.
debug.view.tip = Hattı incelemek için nihai görüntüyü dahili bir tamponla değiştir.

# exposure_mask
exposure_mask.chroma_threshold = Renklilik Eşiği
exposure_mask.chroma_threshold.tip = Bir model düzenlemesini işaretlemek için minimum yalnızca-renklilik farkı.
exposure_mask.edit_strength = Düzenleme Gücü
exposure_mask.edit_strength.tip = Eşiklemeden önce ölçülen model giriş/çıkış farkını ölçekle.
exposure_mask.enabled = Etkinleştir
exposure_mask.enabled.tip = Bu pass, pozlama maskesini model değerlendirmesinden sonra oluşturur. Maske yalnızca bu pass'in bir sonraki kare HDR ölçümünü etkiler.
exposure_mask.luma_relative = Bağıl Parlaklık
exposure_mask.luma_relative.tip = Daha parlak giriş/çıkış parlaklığına göre minimum parlaklık farkı.
exposure_mask.luma_threshold = Parlaklık Eşiği
exposure_mask.luma_threshold.tip = Bir model düzenlemesini işaretlemek için minimum mutlak parlaklık farkı.
exposure_mask.response = Zamansal Tepki
exposure_mask.response.tip = Yeni maske oylarını önceki karenin maskesiyle karıştır.
exposure_mask.smoothing = Uzaysal Yumuşatma
exposure_mask.smoothing.tip = İkili pozlama oylarını küçük bir komşulukta çoğunluk filtresinden geçir.
exposure_mask.title = Pozlama Maskesi

# grade
grade.black_level = Siyah Seviyesi
grade.black_level.tip = Siyaha eşlenen OKLab ışıklılık değeri. Pozitif değerler yalnızca en derin gölgeleri karartır; negatif değerler ayak kısmını yükseltir.
grade.brightness = Parlaklık
grade.brightness.tip = Pozlama modunda değer durak cinsindendir (-1 doğrusal ışığı yarıya indirir; +1 iki katına çıkarır). Diğer modlar kendi parlaklık eğrilerini kullanır.
grade.brightness_mode = Parlaklık Modu
grade.brightness_mode.tip = Parlaklığın hangi algoritmayı kullandığı. Bunlar katman değil, alternatiftir.
grade.cas = CAS Keskinleştirmesi
grade.cas.tip = Derecelendirilmiş sonuçta AMD FidelityFX Contrast Adaptive Sharpening'i etkinleştir. Yalnızca doğrusal SDR'de ayrı bir gönderim olarak çalışır; HDR biçimleri için atlanır.
grade.cas_strength = CAS Gücü
grade.cas_strength.tip = AMD FidelityFX CAS için keskinleştirme miktarı. 0 keskinleştirme uygulamaz, 1 maksimum keskinleştirme uygular.
grade.chroma_mode = Renklilik Modu
grade.chroma_mode.saturation = Doygunluk
grade.chroma_mode.saturation.tip = Algısal tonu koruyarak OKLab renkliliğini aynı faktörle ölçekle.
grade.chroma_mode.tip = Doygunluğun hangi algoritmayı kullandığı. Bunlar katman değil, alternatiftir.
grade.chroma_mode.vibrance = Canlılık
grade.chroma_mode.vibrance.tip = OKLab'de soluk renkleri daha güçlü artırır, renklilik yükseldikçe etkiyi azaltır.
grade.contrast = Kontrast
grade.contrast.tip = Orta ışıklılık çevresinde bir eksenli S-eğrisi. Pozitif kontrastı artırır, negatif azaltır; siyah ve beyaz sabit tutulur.
grade.edge_softening = Kenar Farkında Yumuşatma
grade.edge_softening.tip = Derece girişine ortak çift yönlü 3x3 komşuluk karıştır. Parlaklık benzerliği, güçlü kenarlar boyunca bulanıklığı azaltır.
grade.highlights = Yüksek Işıklar
grade.highlights.tip = Yüksek ışıkları, siyaha ulaşmadan önce sönen düz bir eğriyle ayarlar.
grade.luma_mode.exposure = Pozlama
grade.luma_mode.exposure.tip = Doğrusal ışık RGB'sini 2^amount (durak) ile çarp; sonuç çıkış aralığını aştığında gamut eşleme renkleri korur.
grade.luma_mode.gain = Kazanç
grade.luma_mode.gain.tip = OKLab ışıklılığını sınırlı bir çarpımsal eğriyle ölçekler.
grade.luma_mode.gamma = Gama
grade.luma_mode.gamma.tip = OKLab ışıklılığına işaretli bir kuvvet eğrisi uygula. Nötr siyah ve beyaz sabit kalır, etki orta tonlarda yoğunlaşır.
grade.luma_mode.soft = Yumuşak
grade.luma_mode.soft.tip = Siyaha ve beyaza yakın sıfıra sönen düz bir ışıklılık ayarı.
grade.saturation = Doygunluk
grade.saturation.tip = OKLab'de algısal renkliliği ayarlar. Gamut dışı renkler, kanal kırpma artefaktlarından kaçınmak için nötr eksene doğru sıkıştırılır.
grade.shadows = Gölgeler
grade.shadows.tip = Gölgeleri, beyaza ulaşmadan önce sönen düz bir eğriyle ayarlar.
grade.softening_strength = Yumuşatma Gücü
grade.softening_strength.tip = Kenar farkında 3x3 yumuşatma miktarı.
grade.white_level = Beyaz Seviyesi
grade.white_level.tip = Beyaza eşlenen OKLab ışıklılık değeri. Noktayı yükseltmek görüntüyü düşürür; gamut dışı renkler kanal kırpma yerine sıkıştırılır.

# grade_backbuffer
grade_backbuffer.enabled = Etkin
grade_backbuffer.enabled.tip = Her pass'ten sonra, sunumdan hemen önce son swapchain görüntüsünü derecelendir. Bu, her pass'in model giriş ve model çıkış derecelerinden bağımsızdır.
grade_backbuffer.title = Backbuffer'ı Derecelendir

# hdr
hdr.adaptive.enabled = Uyarlamalı Pozlama
hdr.adaptive.enabled.tip = Oyun Pozlaması kapalıyken bir histogram ölçümünden küresel pozlama sağlar. Oyun Pozlaması açıkkken, Oyun Üstü Güç'ü sınırlı bir düzeltme olarak uygular (0'da etkisiz). İlk ölçüm gelene kadar etkisizdir.
hdr.adaptive.max_correction = Maksimum Düzeltme Durakları
hdr.adaptive.max_correction.tip = Her iki katman etkinleştirildiğinde Oyun Pozlaması çevresindeki maksimum ayar.
hdr.adaptive.midtone = Orta Ton Hedefi
hdr.adaptive.midtone.tip = Seçili popülasyon için hedef ışıklılık.
hdr.adaptive.speed_down = Karartma Hızı
hdr.adaptive.speed_down.tip = Saniye başına durak cinsinden maksimum pozlama azalması.
hdr.adaptive.speed_up = Aydınlatma Hızı
hdr.adaptive.speed_up.tip = Saniye başına durak cinsinden maksimum pozlama artışı.
hdr.adaptive.strength_over_game = Oyun Üstü Güç
hdr.adaptive.strength_over_game.tip = Oyun Pozlaması etkin olduğunda, uyarlamalı hedefin durak düzeltmesinin bu kesrini ekle. Oyun devre dışıyken, Uyarlamalı temel pozlamadır.
hdr.bt2446_ip = BT.2446C Büküm Noktası
hdr.bt2446_ip.tip = BT.2446C eğrisi etki alanındaki diz pozisyonu. Bu noktanın üzerindeki içerik log-sıkıştırılır; altındaki doğrusaldır. Kaydırıcı, gerçek HDR içerik için kullanışlı aralığı kapsar. Bunun dışındaki değerler yine de yazılabilir: 10000 sıkıştırmayı devre dışı bırakır.
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = Doğrusal bölge eğimi: büküm noktasının altındaki içerik için Y_SDR = k1 * Y_HDR. Ayrıca log dalının dizde eşleştiği eğim.
hdr.bt2446_k2 = BT.2446C k2 (türetilmiş)
hdr.bt2446_k2.tip = BT.2446C eğrisinin log bölgesi eğimi. k1, k3 ve büküm noktasından türetilir, böylece log dalı dizde doğrusal dalın eğimiyle eşleşir.
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = Omuz sıkıştırma gücü. Daha büyük değerler log dalını daha sert aşağı çeker, yüksek ışıkları daha çok karartır. k2 ve k4 buna göre türetilir, böylece eğri dizde düzgün kalır.
hdr.bt2446_k4 = BT.2446C k4 (türetilmiş)
hdr.bt2446_k4.tip = BT.2446C eğrisinin log bölgesi kesişimi. k1, k3 ve büküm noktasından türetilir, böylece log dalı dizde doğrusal dalın değeriyle eşleşir.
