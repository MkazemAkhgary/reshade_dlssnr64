# hdr_filters
hdr_filters.depth = Derinlik
hdr_filters.depth.tip = Bu katmanı seçili normalleştirilmiş derinlik aralığıyla sınırla.
hdr_filters.depth_far = Uzak Derinlik
hdr_filters.depth_far.tip = Kabul edilen normalleştirilmiş derinlik aralığının uzak ucu.
hdr_filters.depth_near = Yakın Derinlik
hdr_filters.depth_near.tip = Kabul edilen normalleştirilmiş derinlik aralığının yakın ucu.
hdr_filters.exposure_mask = Pozlama Maskesi
hdr_filters.exposure_mask.tip = Yalnızca kalıcı Pozlama Maskesi tarafından ağırlıklandırılan pikselleri ölç veya düzelt.
hdr_filters.percentile_high = Yüksek Yüzdelik
hdr_filters.percentile_high.tip = Bu katman için üst yüzdelik sınırı.
hdr_filters.percentile_low = Düşük Yüzdelik
hdr_filters.percentile_low.tip = Alt yüzdelik sınırı. Oyun/Uyarlamalı ölçüm için bandı kullanır; Yerel bunu bir parlaklık koruma bandı olarak kullanır.
hdr_filters.percentile_range = Yüzdelik Aralığı
hdr_filters.percentile_range.tip = Oyun/Uyarlamalı için bu katmanın histogramının bir yüzdelik bandını seç. Yerel Pozlama için, ölçülen parlaklık bandının dışındaki yerel düzeltmeyi söndür.

# local_exposure
local_exposure.bright_detail_protection = Parlak Ayrıntı Koruması
local_exposure.bright_detail_protection.tip = Karanlık bir komşuluğun pikselleri eksen üzerine kaldırıp kaldıramayacağını kontrol eder. 1 parlak noktaları sabit tutar; 0 eksen boyunca düzeltmeye izin verir.
local_exposure.cat.advanced = Gelişmiş
local_exposure.dark_detail_protection = Karanlık Ayrıntı Koruması
local_exposure.dark_detail_protection.tip = Parlak bir komşuluğun pikselleri eksen altına karartıp karartamayacağını kontrol eder. 1 karanlık ayrıntıları sabit tutar; 0 eksen boyunca düzeltmeye izin verir.
local_exposure.detail_retention = Ayrıntı Korunması
local_exposure.detail_retention.tip = Pikselin yerel tabanına göre log-parlaklık ayrıntısını korur. 1 tüm bağıl ayrıntıyı korur; daha düşük değerler bunu sıkıştırır.
local_exposure.edge_protection = Kenar Koruması
local_exposure.edge_protection.tip = Güçlü log-parlaklık kenarları boyunca örneklerin etkisini azaltır. 0 yalnızca uzaysal ağırlıkları kullanır; daha yüksek değerler haleleri azaltır ama uyarlamayı daha yerel hale getirebilir.
local_exposure.enabled = Yerel Pozlama
local_exposure.enabled.tip = Uzaysal olarak değişen bir pozlama düzeltmesi uygular, görüntüye başvurulan bir orta ton etrafında eksen alır. Herhangi bir kaynakta çalışır: HDR yolu eksene ton eğrisiyle ulaşır, görüntüye başvurulan yol onu görüntüden okur.
local_exposure.highlight_reduction = Yüksek Işık Azaltma
local_exposure.highlight_reduction.tip = Yüksek ışık azaltma için bağımsız çarpan. Gölgeleri kaldırırken parlak bölgeleri olduğu yerde bırakmak için sıfıra ayarla.
local_exposure.highlight_transition = Yüksek Işık Geçişi
local_exposure.highlight_transition.tip = Yüksek ışık azaltmanın tam güce ulaştığı orta ton ekseninin üzerindeki duraklar. Daha küçük değer daha agresif davranır.
local_exposure.max_brighten = Maksimum Aydınlatma
local_exposure.max_brighten.tip = Durak cinsinden maksimum gölge kaldırma. Tam parlak ayrıntı korumasında, komşuluk karanlık olsa bile orta ton ekseninin üzerindeki pikseller kaldırılmaz.
local_exposure.max_darken = Maksimum Karartma
local_exposure.max_darken.tip = Durak cinsinden maksimum yüksek ışık azaltma. Tam karanlık ayrıntı korumasında, komşuluk parlak olsa bile eksen altındaki pikseller karartılmaz.
local_exposure.midtone = Yerel Orta Ton
local_exposure.midtone.tip = Modelin SDR etki alanında hedef ışıklılık ekseni. Bu eksene yakın pikseller az düzeltme alır; gölgeler yukarı, yüksek ışıklar ona doğru aşağı hareket eder.
local_exposure.radius = Yerel Yarıçap
local_exposure.radius.tip = Kaynak pikselleri cinsinden yarıçap. 1 yarıçap, çok dokunuşlu komşuluk örneklemesini devre dışı bırakır ve yalnızca merkez pikseli kullanır. Daha büyük yarıçaplar, tek tek piksel gürültüsü yerine daha geniş karanlık/parlak bölgelerine yanıt verir.
local_exposure.restore = Model Pozlamasını Geri Yükle
local_exposure.restore.tip = Değerlendirmeden sonra model çıktısına bir düzeltme uygula. Devre dışıyken, modelin yeniden yapılandırılan yerel gölgelemesi dokunulmadan bırakılır.
local_exposure.restore_scale = Geri Yükleme Uzaysal Ölçeği
local_exposure.restore_scale.tip = Pozlama geri yüklemesinin uzaysal ölçeğini kontrol eder: 0 = yerel kaldırmanın piksel başına tam iptali, 1 = tekdüze küresel düzeltme, aralarında log-uzayı karışımıyla. Küresel geri yükleme, modelin yeniden yapılandırılan parlaklık ilişkilerinin daha fazlasını korur.
local_exposure.restore_strength = Geri Yükleme Gücü
local_exposure.restore_strength.tip = Pozlama geri yükleme miktarı: 0 = düzeltme yok, 1 = tam düzeltme. Ara değerler seçili geri yüklemeyi log-pozlama uzayında karıştırır.
local_exposure.samples = Komşuluk Örnekleri
local_exposure.samples.tip = Yerel log-parlaklık tahmininde istenen uzaysal dokunuşlar. Etkili sayı, örneklemeyi uzaysal olarak dengeli tutmak için dörderli gruplara yuvarlanır.
local_exposure.shadow_lift = Gölge Kaldırma
local_exposure.shadow_lift.tip = Gölge kaldırma için bağımsız çarpan. Yüksek ışıkları azaltırken karanlık bölgeleri olduğu yerde bırakmak için sıfıra ayarla.
local_exposure.shadow_transition = Gölge Geçişi
local_exposure.shadow_transition.tip = Gölge kaldırmanın tam güce ulaştığı orta ton ekseninden itibaren duraklar. Daha küçük değer karanlık bölgelere karşı daha agresif davranır.
local_exposure.strength = Güç
local_exposure.strength.tip = Yerel pozlama düzeltmesinin genel miktarı.
local_exposure.title = Yerel Pozlama

# pass
pass.auto_mask = Otomatik Maske
pass.auto_mask.tip = Modelin karakter cildini algılamasına ve düzenlemelerini ona ayrı olarak uygulamasına olanak tanır.
pass.cat.model = Model
pass.cat.residual_edits = Artık Düzenlemeler
pass.cat.strength = Güç
pass.cat.temporal = Zamansal Yeniden Projeksiyon
pass.cheap_preset.auto = Otomatik
pass.cheap_preset.auto.tip = Bu pass'in kendi Render Preset'ini kullan. Tek bir NGX özelliği her iki modele de hizmet eder.
pass.cheap_preset.performance = Performans
pass.cheap_preset.performance.tip = Ucuz modelin özelliğini 2 ipucuyla oluştur.
pass.cheap_preset.quality = Kalite
pass.cheap_preset.quality.tip = Ucuz modelin özelliğini 1 ipucuyla oluştur.
pass.chroma_strength = Renklilik Gücü
pass.chroma_strength.tip = Orijinal ve düzenlenmiş renklilik arasında karıştır.
pass.correct_motion = Hareket Vektörlerini Düzelt
pass.correct_motion.tip = Bu pass'in güvenebileceği bir hareket alanı üret. Bir karenin ilk Pre/Post-DLSS pass'i, oyunun vektörlerini olduğu gibi tutar; çünkü görüntüyü onların için oluşturulduğu haliyle işler. Sonrasındaki her pass ve her Backbuffer pass düzeltilmiş bir alan alır: arama, oyunun vektörü çevresindeki birkaç pikselle sınırlıdır ve önceki alana doğru eğilimlidir. Oyun vektörü yoksa, pass bunları bunun yerine renk ve derinlikten sentezler. Modele ve zamansal yeniden projeksiyona eşit şekilde besler; pass başına bir GPU gönderimi mal eder ve kullanılabilir bir derinlik kılavuzu gerektirir.
pass.edit_strength = Düzenleme Gücü
pass.edit_strength.tip = Düzenleme, kaynağa taşınmadan önce modelin düzenlemesini ölçekler.
pass.enabled = Etkinleştir
pass.enabled.tip = Bu pass profilini etkinleştir veya devre dışı bırak. Devre dışı pass'ler modeli değerlendirmez.
pass.grade_input.apply_to_pre_grade = Düzenlemeyi Derece Öncesi Görüntüye Uygula
pass.grade_input.apply_to_pre_grade.tip = Düzenlemeyi, derecelendirmeden önce görüntüye uygula; böylece derece çıktıya ulaşmaz. Kapalıyken, derecelendirilmiş model çıktısı olduğu gibi kullanılır.
pass.grade_input.enabled = Model Girişini Derecelendir
pass.grade_input.enabled.tip = Modelin okuduğu görüntüyü, model değerlendirmesinden önce derecelendir.
pass.grade_input.title = Model Girişini Derecelendir
pass.grade_output.enabled = Model Çıktısını Derecelendir
pass.grade_output.enabled.tip = Model üretildikten sonra, yayınlanmadan önce derecelendir.
pass.grade_output.title = Model Çıktısını Derecelendir
pass.intensity = Yoğunluk
pass.intensity.tip = Modelin görüntüyü düzenlemesi ne kadar güçlü talimatlandırıldığı.\n0 model değerlendirmesini tamamen atlar
pass.local_structure = Yerel Yapı
pass.local_structure.tip = Modelin yerel yapı ayrıntısının ne kadarının uygulanacağı.
pass.local_tone = Yerel Ton
pass.local_tone.tip = Modelin yerel ton ayarlarının ne kadarının uygulanacağı.
pass.luma_strength = Parlaklık Gücü
pass.luma_strength.tip = Orijinal ve düzenlenmiş parlaklık arasında karıştır.
pass.menu.copy_from_next = Sonraki pass'ten kopyala
pass.menu.copy_from_previous = Önceki pass'ten kopyala
pass.name = Ad
pass.name.tip = Bu pass'in sekmesinde gösterilen etiket. Boşsa konumsal varsayılan olan \"Pass N\" gösterilir.
pass.order = Pass Sırası
pass.preset = Ön Ayar
pass.preset.a = A
pass.preset.a.tip = Model ön ayarı A'yı kullan. Değişiklikler değerlendirme başına uygulanır ve özelliği yeniden oluşturmadan modelin iç geçmişini sıfırlar.
pass.preset.b = B
pass.preset.b.tip = Model ön ayarı B'yi kullan. Değişiklikler değerlendirme başına uygulanır ve özelliği yeniden oluşturmadan modelin iç geçmişini sıfırlar.
pass.preset.c = C
pass.preset.c.tip = Model ön ayarı C'yi kullan. Değişiklikler değerlendirme başına uygulanır ve özelliği yeniden oluşturmadan modelin iç geçmişini sıfırlar.
pass.preset.tip = Bu pass için model kalite/davranış ön ayarını seç.
pass.ratio_brighten = Oran Aydınlatma
pass.ratio_brighten.tip = Oran Kelepçeleri etkinleştirildiğinde kanal başına artık oranının üst sınırı. Hem SDR hem HDR bileşimine uygulanır.
pass.ratio_clamps = Oran Kelepçeleri
pass.ratio_clamps.tip = Şekillendirmeden önce kanal başına model artık log oranını [Ratio Darken, Ratio Brighten] aralığıyla sınırla. Hem SDR hem HDR bileşimine uygulanır.
pass.ratio_darken = Oran Karartma
pass.ratio_darken.tip = Oran Kelepçeleri etkinleştirildiğinde kanal başına artık oranının alt sınırı. Hem SDR hem HDR bileşimine uygulanır.
pass.ratio_eps = Oran Eps
pass.ratio_eps.tip = Kanal başına artık log oranı için payda tabanı. Bir kanal sıfıra yakınken artığı sonlu tutar. Hem SDR hem HDR bileşimine uygulanır.
pass.render_preset = Render Ön Ayarı
pass.render_preset.performance = Performans
pass.render_preset.performance.tip = İpucu 2: performans odaklı ön ayar.
pass.render_preset.quality = Kalite
pass.render_preset.quality.tip = İpucu 1: kalite odaklı ön ayar.
pass.render_preset.tip = Bu pass için DLSSNR.Hint.Render.Preset ipucu. NGX bunu özellik oluştururken kilitler, bu yüzden değiştirmek bu pass'in özelliğini yeniden oluşturur.
pass.residual_chroma = Renklilik Gücü
pass.residual_chroma.tip = Düzenlemenin renkliliğinin parlaklığına göre ne kadarının indiği.
pass.residual_gamma = Düzenleme Gama
pass.residual_gamma.tip = Düzenlemenin yanıt eğrisini şekillendirir.
pass.residual_highlight = Yüksek Işık Koruması
pass.residual_highlight.tip = Düzenlemeyi orta-yüksek parlaklığın üzerinde söndürür.
pass.residual_shadow = Gölge Koruması
pass.residual_shadow.tip = Düzenlemeyi orta-düşük parlaklığın altında söndürür.
pass.skin_structure = Cilt Yapısı
pass.skin_structure.tip = Modelin cilde özgü düzenlemelerini ne kadar güçlü uyguladığını kontrol eder. Modelin otomatik maskeleme seçeneği kapalıyken devre dışıdır.
pass.target = Hedef
pass.target.backbuffer = Backbuffer
pass.target.backbuffer.tip = ReShade Present'da son swapchain backbuffer üzerinde çalış. Oyun DLSS kullanmasa bile çalışır; bu aşamalar mevcut olmadıkça Pre/Post-DLSS pass'leriyle sıralanmaz.
pass.target.post_dlss = Post-DLSS
pass.target.post_dlss.tip = Oyunun DLSS değerlendirmesinden sonra, yükseltilmiş çıktısı üzerinde, sonraki sonrası-işleme ve UI'den önce çalış.
pass.target.pre_dlss = Pre-DLSS
pass.target.pre_dlss.tip = Oyunun DLSS değerlendirmesinden önce, girdi Color kaynağı üzerinde çalış. Oyun daha sonra değiştirilmiş görüntüyü yükseltir. Tam kaynak Color girişi gerektirir.
pass.target.tip = Her pass bağımsız olarak Pre-DLSS, Post-DLSS veya Backbuffer'ı hedefleyebilir. Yürütme sırası aşamaya göre gruplanır; her aşamadaki pass'ler kendi pass-sekme sıralarını izler. Hedefi değiştirmek, modelin iç geçmişini bir sonraki değerlendirmesinde sıfırlar.
pass.temporal.adaptive = Uyarlamalı
pass.temporal.adaptive.tip = Yeniden projekte düzenlemeyi, piksel başına güvenin izin verdiği kadar yeniden kullan; N'in Cadence kaydırıcısı olduğu her N karede en az bir yenilemeye zorlar. Geçersiz piksel oranı yüksekken etkin cadence yarıya iner.
pass.temporal.cadence = Cadence
pass.temporal.cadence.tip = Model değerlendirmeleri arasındaki kare sayısı. Uyarlamalı modda bu maksimumdur; geçersiz piksel oranı yüksekken etkin cadence yarıya iner. Sabit modda bu tam cadence'dir.
pass.temporal.cheap = Ucuz Model
pass.temporal.cheap.tip = Tam değerlendirmeler arasındaki karelerde ikinci, daha ucuz bir model çalıştır ve yeniden projeksiyon güveninin düşük olduğu yerde onun düzenlemesini al. Kapalıyken, bu kareler yalnızca geçmişten yeniden yapılandırılır; bu ekstra maliyet gerektirmez ama ayrılmaları ve hızlı hareketi bir sonraki tam değerlendirmeye kadar çözülmemiş bırakır.
pass.temporal.cheap_preset = Ucuz Model Ön Ayarı
pass.temporal.cheap_preset.tip = Ucuz modelin kendi özelliği için render ön ayarı. Otomatik, bu pass'inkini izler; ikinci özellik gerektirmez; diğerleri bir tane oluşturur, çünkü NGX ipucunu oluştururken kilitler.
pass.temporal.cheap_scale = Ucuz Model Ölçeği
pass.temporal.cheap_scale.tip = Daha ucuz modelin çözünürlüğü, çalışma ölçeğinin bir kesri olarak. 0.5, çalışma ölçeği çözünürlüğünün %50'si anlamına gelir. Daha düşük değerler daha hızlıdır ama düşük güvenli yeniden projeksiyon alanlarını daha az ayrıntıyla doldurur.
pass.temporal.depth_abs = Derinlik Mutlak
pass.temporal.depth_abs.tip = Hareket yeniden projeksiyonundan sonra izin verilen mutlak derinlik farkı.
pass.temporal.depth_rel = Derinlik Bağıl
pass.temporal.depth_rel.tip = Bağıl derinlik-farkı payı. Eşik, bu pay ile Derinlik Mutlak'ın büyüğüdür.
pass.temporal.fixed = Sabit
pass.temporal.fixed.tip = Model değerlendirmeleri arasında, güvene bakılmaksızın sabit sayıda kare için yeniden projekte düzenlemeyi yeniden kullan. Cadence kaydırıcısı tam cadence'dir.
pass.temporal.fp16_history = FP16 Düzenleme Geçmişi
pass.temporal.fp16_history.tip = Zamansal düzenleme/aday dokularını FP16'da depola. Yeniden kullanılan düzenlemelerde küçük niceleme farklarıyla geçmiş bant genişliğini ve belleği azaltır.
pass.temporal.max_invalid = Maksimum Geçersiz %
pass.temporal.max_invalid.tip = Model yenilenmeden önce izin verilen maksimum geçersiz veya fotometrik olarak uyuşmayan piksel oranı.
pass.temporal.max_motion = Maksimum Hareket
pass.temporal.max_motion.tip = Hareket, bu kadar çalışma-çözünürlüğü pikselini aştığında yeniden projeksiyonu reddet.
pass.temporal.mode = Mod
pass.temporal.mode.tip = Modeli her kare değerlendirmek yerine, hareketle yeniden projekte çarpımsal bir model düzenlemesini yeniden kullan. Geçerli karenin derinliğini ve bir hareket alanını gerektirir - oyunununki veya Doğru Hareket Vektörleri tarafından üretilen biri; belirsiz geçmiş yeni bir değerlendirmeye zorlar.
pass.temporal.off = Kapalı
pass.temporal.off.tip = Sinir modelini her kare değerlendir.
pass.temporal.photo_abs = Foto Mutlak
pass.temporal.photo_abs.tip = Geçerli piksel ile onun hareketle yeniden projekte önceki-kare eşi arasında izin verilen mutlak model-giriş parlaklık farkı.
pass.temporal.photo_rel = Foto Bağıl
pass.temporal.photo_rel.tip = Bağıl parlaklık-farkı payı, daha büyük mutlak geçerli veya önceki parlaklıkla ölçeklenir. Foto Mutlak'a eklenir.
pass.ui_correction = UI Düzeltmesi
pass.ui_correction.tip = Modelin düzenlemelerini UI öğelerini algıladığı yerlerde azalt.
pass.upsample_sharpness = Yükseltme Keskinliği
pass.upsample_sharpness.tip = Model giriş ve çıkışının sabit ortak çift yönlü 3x3 yeniden yapılandırması için kenar-koruma üssü. Daha yüksek değerler tam çözünürlüklü kılavuz kenarlarını daha keskin izler; daha düşük değerler düşük çözünürlüklü komşulukta daha pürüzsüz karışır. Bu, model düzenlemesini ölçeklemez.
pass.working_scale = Çalışma Ölçeği
pass.working_scale.reset_tip = Çalışma Ölçeği ve x2'i varsayılanlarına sıfırla.
pass.working_scale.slider_tip = Modelin çalışma çözünürlüğü, çerçevenin bir kesri olarak.\n\nÇok düşük değerler, zamansal yeniden projeksiyonun her zaman kullanılabilir geçmişi olması için en az 180p dikey çözünürlüğe yükseltilir. Bu değeri değiştirmek, modelin iç geçmişini bir sonraki değerlendirmesinde sıfırlar.
pass.working_scale.tip = Modelin çalıştığı çözünürlük, çerçevenin bir kesri olarak. Çoklu örnekleme için onu iki katına çıkarmak üzere x2'yi işaretle. Bileşim ve backbuffer çerçeve çözünürlüğünde kalır.
pass.working_scale.x2_off_tip = Şu anda çoklu örnekleme için modelin çalışma çözünürlüğünü iki katına çıkarıyor. Kaydırıcının değerine dönmek için işareti kaldır. Bu ayarı değiştirmek, modelin iç geçmişini bir sonraki değerlendirmesinde sıfırlar.\n\nİşaret kaldırıldıktan sonraki ilk kare de, daha küçük kaynaklar ayrılırken ve öncekiler GPU'da emekli olurken kısa süre donabilir.
pass.working_scale.x2_on_tip = Çoklu örnekleme için modelin çalışma çözünürlüğünü iki katına çıkar. Bu, modelin iç geçmişini bir sonraki değerlendirmesinde sıfırlar.\n\nUYARI: bunu etkinleştirmek, geçişten sonraki ilk karede oyunu kısa bir an dondurabilir; daha büyük çalışma-ölçeği kaynakları (çalışma giriş/çıkış, zamansal geçmiş, kaldırılmamış referans) ayrılırken ve önceki uçuş halindeki tamponlar GPU'da emekli olurken.\n\nDiğer tehlikeler:\n  - Çalışma-ölçeği kaynakları için VRAM kullanımı kabaca dört katına çıkar.\n  - Model değerlendirmesi ve bileşim 2x'de daha yavaştır.\n  - Yeniden kullanım karelerinde yeniden kullanılan ucuz model, çalışma ölçeğiyle büyür; bu yüzden yeniden kullanım kareleri de daha maliyetlidir.\n  - Bir veya iki saniyeden uzun bir donma genellikle cihazın VRAM'i bitirdiği anlamına gelir; kurtarmak için bunu kapat.

# prefs
prefs.clone_resources = Oyun Kaynaklarını Kopyala
prefs.clone_resources.tip = Kapalı (varsayılan): oyunun geçerli derinlik/hareket kaynaklarını ve DLSS çıktısını doğrudan oku. Açık: geçerli karenin derinlik/hareketini ve Post-DLSS etkinleştirildiğinde DLSS çıktısını, eklentiye ait dokulara kopyala. Bu tek seçenek tüm aşamalara uygulanır, Backbuffer dahil; istenen mod yeni bir DLSS değerlendirmesinde güvenle kilitlenir.
prefs.fp16_storage = FP16 Hattı
prefs.fp16_storage.tip = HDR kazanç haritası taşıyıcısını, model çalışma dokularını ve kaldırılmamış bileşim referansını RGBA32F yerine RGBA16F'de depola. HDR hattının bant genişliğini ve ayak izini, taşıyıcıdan-HDR'ye çarpanı ve model-etki alanı deltalarındaki niceleme pahasına yarıya indirir. SDR yolları etkilenmez. Değiştirmek zamansal geçmişi sıfırlar ve NGX özelliğini yeniden oluşturur.
