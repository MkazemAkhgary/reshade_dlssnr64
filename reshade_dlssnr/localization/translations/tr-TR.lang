hdr.gain_max = Maksimum Kazanç
hdr.gain_max.tip = Taşıyıcıdan-HDR'ye beklenen maksimum kazanç, log2 durak cinsinden. Yalnızca tanılama kazanç haritası istatistikleri ve hata ayıklama görünümleri tarafından kullanılır; bileşimi etkilemez.
hdr.gain_min = Minimum Kazanç
hdr.gain_min.tip = Taşıyıcıdan-HDR'ye beklenen minimum kazanç, log2 durak cinsinden. Yalnızca tanılama kazanç haritası istatistikleri ve hata ayıklama görünümleri tarafından kullanılır; bileşimi etkilemez.
hdr.game.bias = Pozlama Sapması
hdr.game.bias.tip = Oyunun pozlamasına göre elle sapma, durak cinsinden. Sıfır, oyunun değerini değiştirmeden bırakır.
hdr.game.enabled = Oyun Pozlaması
hdr.game.enabled.tip = Temel pozlama olarak oyunun NGX ExposureTexture değerini kullan. Oyun bir tane sağlamazsa, bu katman atlanır ve Uyarlamalı Pozlama bunun yerine temeli sağlayabilir.
hdr.highlight_headroom = Yüksek Işık Payı
hdr.highlight_headroom.tip = BT.2446C tarafından kullanılan etkin HDR tepe değerini ölçekler. Bu, pozlamanın nasıl yorumlandığını değiştirmez.
hdr.layer.adaptive = Uyarlamalı Pozlama
hdr.layer.adaptive.tip = Histogram tabanlı küresel pozlama veya Oyun Pozlaması üzerinde sınırlı bir düzeltme.
hdr.layer.game = Oyun Pozlaması
hdr.layer.game.tip = Oyunun pozlamasını temel katman olarak yapılandır.
hdr.layers.stack_order = Yığın sırası: Oyun Pozlaması tabanı, ardından Uyarlamalı düzeltme. Yerel Pozlama kendi bölümüdür ve her ikisinden sonra uygulanır.
hdr.measure_interval = Ölçüm Aralığı
hdr.measure_interval.tip = Pozlama histogramlarının ne sıklıkla ölçüldüğü, kare cinsinden.
hdr.metering_density = Ölçüm Yoğunluğu
hdr.metering_density.tip = HDR histogramının kaç pikseli örneklediği. Tam yoğunluk her pikseli yakalar; daha kaba yoğunluklar daha düşük GPU maliyetiyle daha az piksel örnekler.
hdr.reuse_previous_pass = Önceki HDR Pass Ölçümünü Yeniden Kullan
hdr.reuse_previous_pass.tip = Aynı Pre-DLSS veya Post-DLSS zincirindeki sonraki pass'ler için, yeni bir histogram göndermek yerine önceki pass'in HDR ölçümünü yeniden kullan. İlk pass hâlâ oyunun kaynağını ölçer.
