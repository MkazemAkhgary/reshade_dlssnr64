# ctl
ctl.category.toggle = %s サブセクションを展開または折りたたむ
ctl.menu.copy = コピー
ctl.menu.paste = 貼り付け
ctl.reset.default.tip = 宣言されたデフォルトにリセットします。
ctl.section.toggle = %s を有効または無効にします。

# debug
debug.title = デバッグ
debug.view = デバッグビュー
debug.view.depth = 深度
debug.view.depth.tip = ゲームが DLSS に供給した深度バッファー。グレースケールで表示されます。
debug.view.exposure_mask = 露出マスク
debug.view.exposure_mask.tip = 実際のモデル入力（入力グレーディングやローカル露出を含む）と生のモデル出力との、現在のフレームのマスク。次のフレームで露出として使用するために公開されます。
debug.view.gain_map = ゲインマップ
debug.view.gain_map.tip = 生の f32 キャリアから HDR への再構成倍率。ログ2ストップで -4（黒）から +6（白）として表示されます。
debug.view.game_exposure = ゲーム露出
debug.view.game_exposure.tip = ストップ単位のゲーム NGX 露出：1.0x（0 ストップ）は中間灰色。より明るい/暗い値は白/黒に近づきます。マゼンタは有効な値が読み取られなかったことを意味します。
debug.view.hdr_local_exposure = HDR ローカル露出
debug.view.hdr_local_exposure.tip = ストップ単位のローカル露出係数。0 ストップが中間灰色、-2 ストップが黒、+2 ストップが白になるようにマッピングされます。
debug.view.hdr_roundtrip_diagnostic = HDR ラウンドトリップ診断
debug.view.hdr_roundtrip_diagnostic.tip = 2x2 比較：実際の準備済みモデル入力 | モデル出力 / グレードなしのモデル領域にマッピングし直した合成 HDR | グレードなしのモデル出力に対する合成の差。フル解像度のソース詳細は保持されるため、非零のエッジは予想されます。ワーキングスケールはこの比較に影響します。分離されたキャリア再構成チェックには HDR ラウンドトリップエラーを使用してください。
debug.view.hdr_roundtrip_error = HDR ラウンドトリップエラー
debug.view.hdr_roundtrip_error.tip = 元のデコード済み HDR ソースと、RGBA32F キャリアとキャリアから HDR 倍率からの直接の float32 再構成との間の擬似カラー相対誤差。これはキャリア転送のみを検証し、モデルの編集や最終合成は検証しません。ワーキングスケールおよび入力グレードに依存しません。
debug.view.hint = このビューは、下のタブで現在選択されているパスによってレンダリングされ、そのパスが有効な間のみ効果があります。
debug.view.model_input_pre_grade = モデル入力（グレード前）
debug.view.model_input_pre_grade.tip = 入力グレードが実行される前の、ちょうどその時点のモデル入力の色。グレードはその場で適用されるため、パイプラインはこのテクスチャをビュー選択時にスナップショットします。入力グレードを有効にしている場合は、モデル入力（準備済み）と比較してください。
debug.view.model_input_prepared = モデル入力（準備済み）
debug.view.model_input_prepared.tip = モデルに実際に渡される画像。ワーキングスケールへのリサイズ、HDR 準備、および有効時の入力グレーディングの後でのものです。
debug.view.model_input_source = モデル入力（ソース）
debug.view.model_input_source.tip = あらゆる処理前にキャプチャされたフレーム。これはモデルが動作する DLSS 出力で、ネイティブ解像度です。
debug.view.model_output_composed = モデル出力（合成済み）
debug.view.model_output_composed.tip = このパスの最終結果。モデルの編集がソースと合成された後です。これがターゲットに書き込まれるものです。
debug.view.model_output_post_grade = モデル出力（グレード後）
debug.view.model_output_post_grade.tip = 出力グレード実行後のモデル出力。モデル自身の sRGB エンコードされた SDR 領域。モデル入力の入力グレードと対称。これ以降（合成、露出マスク、書き戻し）は、モデルがそれを生成したかのようにこれを消費します。
debug.view.model_output_raw = モデル出力（生）
debug.view.model_output_raw.tip = 出力グレードが適用される前の、NGX が生成したそのままのモデル出力。グレードはその場で実行されるため、パイプラインがスナップショットを取得します。出力グレードを有効にしている場合は、モデル出力（グレード後）と比較してください。
debug.view.motion_vectors = モーションベクトル
debug.view.motion_vectors.tip = このパスが評価するモーションフィールド。ゲームのベクトル、または Correct Motion Vectors が生成したフィールド。R = x 方向、G = y 方向として表示されます。
debug.view.off = オフ
debug.view.off.tip = デバッグビューを無効にし、通常の合成出力を表示します。
debug.view.sdr_base_pre_model = SDR ベース（モデル前）
debug.view.sdr_base_pre_model.tip = BT.2446C 分割によって生成されたフル解像度のリニア SDR キャリア。これはモデルがダウンサンプルされる RGB ペイロードです。
debug.view.temporal_candidate_status = テンポラル候補ステータス
debug.view.temporal_candidate_status.tip = 深度検証前の再投影信頼度。グレースケールで表示（白 = 完全に信頼、黒 = 拒否）。信頼度は局所的な編集クランプ一致、測光的な一致、および前回の信頼度を組み合わせます。前の編集が再投影可能になるまで利用できません。
debug.view.temporal_reprojected_edit = テンポラル再投影編集
debug.view.temporal_reprojected_edit.tip = 前のフレームからの検証済みチャンネルごとのログゲイン。中立ゲインが灰色、より強い正/負の編集は白/黒に近づくようにマッピングされます。拒否されたピクセルは暗くなります。
debug.view.temporal_validation_status = テンポラル検証ステータス
debug.view.temporal_validation_status.tip = 深度検証後の信頼度。グレースケールで表示されます。信頼度は適用される編集の重みをスケールします。低い値は入力への編集をフェードさせます。
debug.view.tip = 最終画像を内部バッファに置き換え、パイプラインを検査します。

# exposure_mask
exposure_mask.chroma_threshold = クロマ閾値
exposure_mask.chroma_threshold.tip = モデルの編集をマークするための最小のクロマのみの差。
exposure_mask.edit_strength = 編集強度
exposure_mask.edit_strength.tip = 閾値処理前に、測定されたモデル入力/出力差をスケールします。
exposure_mask.enabled = 有効
exposure_mask.enabled.tip = このパスはモデル評価後に露出マスクを構築します。このマスクはこのパスの次フレームの HDR メータリングにのみ影響します。
exposure_mask.luma_relative = 相対輝度
exposure_mask.luma_relative.tip = より明るい入力/出力輝度に対する最小の相対輝度差。
exposure_mask.luma_threshold = 輝度閾値
exposure_mask.luma_threshold.tip = モデルの編集をマークするための最小の絶対輝度差。
exposure_mask.response = テンポラル応答
exposure_mask.response.tip = 新しいマスクの投票を前のフレームのマスクとブレンドします。
exposure_mask.smoothing = 空間平滑化
exposure_mask.smoothing.tip = 小さな近傍でバイナリ露出投票を多数決フィルタで処理します。
exposure_mask.title = 露出マスク

# grade
grade.black_level = ブラックレベル
grade.black_level.tip = 黒にマッピングされる OKLab 輝度値。正の値は最も深い影のみを暗くし、負の値はトーンを持ち上げます。
grade.brightness = 明るさ
grade.brightness.tip = 露出モードでは、値はストップ単位（-1 はリニア光を半分に、+1 は倍にします）。他のモードは独自の明るさ曲線を使用します。
grade.brightness_mode = 明るさモード
grade.brightness_mode.tip = 明るさに使用するアルゴリズム。これらはレイヤーではなく代替です。
grade.cas = CAS シャープニング
grade.cas.tip = グレード結果に対して AMD FidelityFX Contrast Adaptive Sharpening を有効にします。リニア SDR のみで別のディスパッチとして実行されます。HDR 形式ではスキップされます。
grade.cas_strength = CAS 強度
grade.cas_strength.tip = AMD FidelityFX CAS のシャープニング量。0 はシャープニングなし、1 は最大シャープニングを適用します。
grade.chroma_mode = クロマモード
grade.chroma_mode.saturation = 彩度
grade.chroma_mode.saturation.tip = 知覚的な色相を保持したまま、OKLab クロマを同じ係数でスケールします。
grade.chroma_mode.tip = 彩度に使用するアルゴリズム。これらはレイヤーではなく代替です。
grade.chroma_mode.vibrance = バイブランス
grade.chroma_mode.vibrance.tip = OKLab で抑えた色をより強くブーストし、クロマが上がるにつれて効果を減らします。
grade.contrast = コントラスト
grade.contrast.tip = 中間輝度を中心としたピボット付き S カーブ。正の値はコントラストを増やし、負の値は黒と白を固定したまま減らします。
grade.edge_softening = エッジ対応ソフトニング
grade.edge_softening.tip = グレード入力にジョイントバイラテラル 3x3 近傍をブレンドします。輝度の類似性は強いエッジを横切るぼかしを減らします。
grade.highlights = ハイライト
grade.highlights.tip = 黒の手前でフェードアウトする滑らかな曲線でハイライトを調整します。
grade.luma_mode.exposure = 露出
grade.luma_mode.exposure.tip = リニア光 RGB に 2^amount（ストップ）を乗算します。結果が出力範囲を超える場合、色域マッピングが色を保護します。
grade.luma_mode.gain = ゲイン
grade.luma_mode.gain.tip = OKLab 輝度を有界の乗算曲線でスケールします。
grade.luma_mode.gamma = ガンマ
grade.luma_mode.gamma.tip = OKLab 輝度に符号付き累乗曲線を適用します。中立的な黒と白は固定されたまま、中間調に効果を集中させます。
grade.luma_mode.soft = ソフト
grade.luma_mode.soft.tip = 黒と白の近くでゼロにフェードする滑らかな輝度調整。
grade.saturation = 彩度
grade.saturation.tip = OKLab で知覚的なクロマを調整します。色域外の色はチャンネルクリッピングのアーティファクトを避けるため、中立軸方向に圧縮されます。
grade.shadows = シャドウ
grade.shadows.tip = 白の手前でフェードアウトする滑らかな曲線でシャドウを調整します。
grade.softening_strength = ソフトニング強度
grade.softening_strength.tip = エッジ対応 3x3 ソフトニングの量。
grade.white_level = ホワイトレベル
grade.white_level.tip = 白にマッピングされる OKLab 輝度値。点を上げると画像が暗くなります。色域外の色はチャンネルクリップではなく圧縮されます。

# grade_backbuffer
grade_backbuffer.enabled = 有効
grade_backbuffer.enabled.tip = すべてのパスの直後、提示の直前に最終的なスワップチェーン画像をグレードします。これは各パスのモデル入力およびモデル出力グレードから独立しています。
grade_backbuffer.title = グレードバックバッファ

# hdr
hdr.adaptive.enabled = アダプティブ露出
hdr.adaptive.enabled.tip = ゲーム露出がオフの場合、ヒストグラム測定からグローバル露出を提供します。ゲーム露出がオンの場合、Strength Over Game を有界の補正として適用します（0 では効果なし）。最初の測定が届くまで効果はありません。
hdr.adaptive.max_correction = 最大補正ストップ
hdr.adaptive.max_correction.tip = 両方のレイヤーが有効な場合のゲーム露出周りの最大調整量。
hdr.adaptive.midtone = ミッドトーンターゲット
hdr.adaptive.midtone.tip = 選択したポピュレーションのターゲット輝度。
hdr.adaptive.speed_down = 暗くする速度
hdr.adaptive.speed_down.tip = 毎秒の最大露出減少量（ストップ）。
hdr.adaptive.speed_up = 明るくする速度
hdr.adaptive.speed_up.tip = 毎秒の最大露出増加量（ストップ）。
hdr.adaptive.strength_over_game = ゲームに対する強度
hdr.adaptive.strength_over_game.tip = ゲーム露出がアクティブな場合、アダプティブターゲットのストップ補正のこの割合を加算します。ゲームが無効な場合、アダプティブが基本露出になります。
hdr.bt2446_ip = BT.2446C インフレクション
hdr.bt2446_ip.tip = BT.2446C 曲線領域でのニー位置。この点より上のコンテンツはログ圧縮され、下のコンテンツはリニアです。スライダーは実際の HDR コンテンツの有用な範囲をカバーします。範囲外の値も入力可能です：10000 は圧縮を無効にします。
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = リニア領域の傾き：インフレクション点より下のコンテンツでは Y_SDR = k1 * Y_HDR。また、ログ分岐がニーで一致させる傾きでもあります。
hdr.bt2446_k2 = BT.2446C k2（導出）
hdr.bt2446_k2.tip = BT.2446C 曲線のログ領域の傾き。k1、k3、およびインフレクション点から導出され、ログ分岐がリニア分岐の傾きにニーで一致します。
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = ショルダー圧縮の強度。大きい値はログ分岐をより強く下げ、ハイライトをより暗くします。k2 と k4 はこれから導出され、曲線がニーで滑らかになるようにします。
hdr.bt2446_k4 = BT.2446C k4（導出）
hdr.bt2446_k4.tip = BT.2446C 曲線のログ領域の切片。k1、k3、およびインフレクション点から導出され、ログ分岐がリニア分岐の値にニーで一致します。
hdr.cat.advanced = 詳細
hdr.cat.diagnostics = 診断
hdr.cat.filters = フィルタ
hdr.common.available = 利用可能
hdr.common.no = いいえ
