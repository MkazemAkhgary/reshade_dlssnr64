hdr.crosstalk.tip = BT.2446C 事前脱飽和量。
hdr.density.full = フル
hdr.density.full.tip = すべてのピクセルをサンプルします。フル密度ヒストグラム、最高精度。
hdr.density.quarter = 1/4
hdr.density.quarter.tip = 各軸で 2 ピクセルごとにサンプルします（フレームの 1/4）。小さな孤立したハイライトが見落とされる可能性があります。
hdr.density.sixteenth = 1/16
hdr.density.sixteenth.tip = 各軸で 4 ピクセルごとにサンプルします（フレームの 1/16）。孤立したハイライトや細かいディテールが見落とされる可能性があります。
hdr.density.sixty_fourth = 1/64
hdr.density.sixty_fourth.tip = 各軸で 8 ピクセルごとにサンプルします（フレームの 1/64）。おおむね均一なコンテンツにのみ適しています。
hdr.detailed_statistics = 詳細 HDR 統計
hdr.detailed_statistics.tip = フルフレームのゲインマップ範囲と逸脱統計を収集します。有効にすると 2 つの GPU ディスパッチが追加されます。
hdr.diag.adaptive_scene_white = adaptive scene white: %.4f
hdr.diag.async_note = 値は非同期に更新されます。露出とヒストグラムは、GPU が書き戻しを完了した最新の測定を反映します。
hdr.diag.exposure = Exposure: %.4f
hdr.diag.format = Format: %s - resolved=%s
hdr.diag.gain_excursions = SDR excursions: %u
hdr.diag.gain_map = Gain map: %s
hdr.diag.gain_out_of_range = out of range: %u
hdr.diag.gain_range = range (log2): %.3f .. %.3f
hdr.diag.game_exposure = Game exposure: %s
hdr.diag.game_texture = texture: %ux%u fmt=%d
hdr.diag.game_value = value: %.4f
hdr.diag.guides = DLSS guides: %s
hdr.diag.histogram = Histogram (log2 luminance)
hdr.diag.histogram.tip = 測定されたログ2輝度のヒストグラム。ポピュレーションはアクティブな露出フィルタに依存します。
hdr.diag.histogram_missing = Histogram: not ready
hdr.diag.metering_source = Metering source: %s
hdr.diag.post_blocked = Post-DLSS blocked: %s
hdr.diag.reference_luma = reference luma: %.4f
hdr.diag.samples = Samples: %u - frames since measure: %u
hdr.diag.scene_white = Scene white: %.4f
hdr.diag.warming = Warming up - no exposure measurement yet.
hdr.enabled = 有効
hdr.enabled.tip = このパスの直前に HDR 画像をメータリングします。メータリング再利用が有効でない限り、以降のパスは前のパスが合成した画像を測定します。バックバッファパスは SDR 合成を使用します。
hdr.format = 形式
hdr.format.auto = 自動
hdr.format.auto.tip = アクティブな Pre/Post-DLSS ソースから形式を自動検出します。
hdr.format.hdr10 = HDR10
hdr.format.hdr10.tip = ソースを HDR10 PQ (ST.2084) として扱います。
hdr.format.scrgb = scRGB
hdr.format.scrgb.tip = ソースをリニア scRGB (1.0 = 80 nits) として扱います。
hdr.format.sdr = SDR
hdr.format.sdr.tip = ソースを SDR sRGB として扱います。
hdr.format.tip = ソース画像のエンコード方法。DLSS 出力の DXGI 形式から自動検出します。
hdr.gain_max = ゲイン最大
hdr.gain_max.tip = 予想されるキャリアから HDR への最大ゲイン（ログ2ストップ）。診断用ゲインマップ統計およびデバッグビューでのみ使用され、合成には影響しません。
hdr.gain_min = ゲイン最小
hdr.gain_min.tip = 予想されるキャリアから HDR への最小ゲイン（ログ2ストップ）。診断用ゲインマップ統計およびデバッグビューでのみ使用され、合成には影響しません。
hdr.game.bias = 露出バイアス
hdr.game.bias.tip = ゲームの露出に対する相対的な手動バイアス（ストップ）。ゼロはゲームの値をそのままにします。
hdr.game.enabled = ゲーム露出
hdr.game.enabled.tip = ゲームの NGX ExposureTexture を基本露出として使用します。ゲームが提供しない場合、このレイヤーはフォールスルーし、アダプティブ露出が代わりに基本を提供できます。
hdr.highlight_headroom = ハイライトヘッドルーム
hdr.highlight_headroom.tip = BT.2446C が使用する実効的な HDR ピークをスケールします。これは露出の解釈方法を変更しません。
hdr.layer.adaptive = アダプティブ露出
hdr.layer.adaptive.tip = ヒストグラムベースのグローバル露出、またはゲーム露出に対する有界の補正。
hdr.layer.game = ゲーム露出
hdr.layer.game.tip = ゲームの露出を基本レイヤーとして設定します。
hdr.layers.stack_order = スタック順序：ゲーム露出を基本とし、次にアダプティブ補正。ローカル露出は独自のセクションで、両方の後に適用されます。
hdr.measure_interval = 測定間隔
hdr.measure_interval.tip = 露出ヒストグラムが測定される頻度（フレーム単位）。
hdr.metering_density = メータリング密度
hdr.metering_density.tip = HDR ヒストグラムがサンプルするピクセル数。フル密度はすべてのピクセルをキャプチャします。粗い密度はより少ないピクセルをサンプルし、GPU コストが低くなります。
hdr.reuse_previous_pass = 前の HDR パスのメータリングを再利用
hdr.reuse_previous_pass.tip = 同じ Pre-DLSS または Post-DLSS チェーン内の以降のパスについて、新しいヒストグラムをディスパッチする代わりに、前のパスの HDR 測定を再利用します。最初のパスは引き続きゲームのソースを測定します。
hdr.source.filtered = フィルタされたポピュレーション
hdr.source.full_frame = フルフレーム
hdr.source.game_exposure = ゲーム露出 (NGX)
hdr.source.unknown = 不明
hdr.title = HDR

# hdr_filters
hdr_filters.depth = 深度
hdr_filters.depth.tip = このレイヤーを選択された正規化深度区間に制限します。
hdr_filters.depth_far = 深度遠
hdr_filters.depth_far.tip = 受け入れられる正規化深度区間の遠端。
hdr_filters.depth_near = 深度近
hdr_filters.depth_near.tip = 受け入れられる正規化深度区間の近端。
hdr_filters.exposure_mask = 露出マスク
hdr_filters.exposure_mask.tip = 永続的な露出マスクによって重み付けされたピクセルのみをメータリングまたは補正します。
hdr_filters.percentile_high = 高パーセンタイル
hdr_filters.percentile_high.tip = このレイヤーの上位パーセンタイル境界。
hdr_filters.percentile_low = 低パーセンタイル
hdr_filters.percentile_low.tip = 下位パーセンタイル境界。ゲーム/アダプティブはメータリングにバンドを使用します。ローカルはそれを輝度保護バンドとして使用します。
hdr_filters.percentile_range = パーセンタイル範囲
hdr_filters.percentile_range.tip = ゲーム/アダプティブの場合、このレイヤーのヒストグラムのパーセンタイルバンドを選択します。ローカル露出の場合、測定された輝度バンド外でローカル補正をフェードさせます。

# local_exposure
local_exposure.bright_detail_protection = 明部ディテール保護
local_exposure.bright_detail_protection.tip = 暗い近傍がピボットより上のピクセルを持ち上げるかどうかを制御します。1 は明るいスポットを固定したままにし、0 はピボットを越えた補正を許可します。
local_exposure.cat.advanced = 詳細
local_exposure.dark_detail_protection = 暗部ディテール保護
local_exposure.dark_detail_protection.tip = 明るい近傍がピボットより下のピクセルを暗くするかどうかを制御します。1 は暗いディテールを固定したままにし、0 はピボットを越えた補正を許可します。
local_exposure.detail_retention = ディテール保持
local_exposure.detail_retention.tip = ピクセルの局所的なベースに対するログ輝度ディテールを保持します。1 はすべての相対ディテールを保持し、低い値はそれを圧縮します。
local_exposure.edge_protection = エッジ保護
local_exposure.edge_protection.tip = 強いログ輝度エッジを横切るサンプルの影響を減らします。0 は空間的重みのみを使用します。高い値はハロを減らしますが、適応をより局所的にする可能性があります。
local_exposure.enabled = ローカル露出
local_exposure.enabled.tip = 表示参照の中間調をピボットとして、空間的に変化する露出補正を適用します。あらゆるソースで動作します。HDR パスはトーンカーブを通じてピボットに到達し、表示参照パスは画像からそれを読み取ります。
local_exposure.highlight_reduction = ハイライト削減
local_exposure.highlight_reduction.tip = ハイライト削減の独立した乗数。ゼロに設定すると、シャドウを持ち上げながら明るい領域をそのままにします。
local_exposure.highlight_transition = ハイライト遷移
local_exposure.highlight_transition.tip = ハイライト削減が最大強度に達するまでの中間調ピボット上のストップ数。小さい値はより積極的に作用します。
local_exposure.max_brighten = 最大明るさ上げ
local_exposure.max_brighten.tip = シャドウを持ち上げる最大量（ストップ）。明部ディテール保護が最大の場合、近傍が暗くても中間調ピボットより上のピクセルは持ち上げられません。
local_exposure.max_darken = 最大暗さ下げ
local_exposure.max_darken.tip = ハイライト削減の最大量（ストップ）。暗部ディテール保護が最大の場合、ピボットより下のピクセルは近傍が明るくても暗くされません。
local_exposure.midtone = ローカル中間調
local_exposure.midtone.tip = モデルの SDR 領域でのターゲット輝度ピボット。このピボットに近いピクセルは補正を受けません。シャドウは上がり、ハイライトはそれに向かって下がります。
local_exposure.radius = ローカル半径
local_exposure.radius.tip = ソースピクセル単位の半径。半径 1 はマルチタップ近傍サンプリングを無効にし、中心ピクセルのみを使用します。大きい半径は個々のピクセルノイズではなく、より広い暗/明領域に応答します。
local_exposure.restore = モデル露出の復元
local_exposure.restore.tip = 評価後にモデル出力に補正を適用します。無効にすると、モデルが再構成した局所的なシェーディングはそのままになります。
local_exposure.restore_scale = 復元空間スケール
local_exposure.restore_scale.tip = 露出復元の空間スケールを制御します：0 = 局所リフトのピクセルごとの正確なキャンセル、1 = 均一なグローバル補正、その間はログ空間ブレンド。グローバル復元はモデルが再構成した輝度関係をより多く保持します。
local_exposure.restore_strength = 復元強度
local_exposure.restore_strength.tip = 露出復元の量：0 = 補正なし、1 = 完全な補正。中間値は選択された復元をログ露出空間でブレンドします。
local_exposure.samples = 近傍サンプル
local_exposure.samples.tip = 局所ログ輝度推定での要求される空間タップ数。実効数は空間的にバランスを保つため、4 の倍数に丸められます。
local_exposure.shadow_lift = シャドウリフト
local_exposure.shadow_lift.tip = シャドウを持ち上げる独立した乗数。ゼロに設定すると、ハイライトを削減しながら暗い領域をそのままにします。
local_exposure.shadow_transition = シャドウ遷移
local_exposure.shadow_transition.tip = シャドウリフトが最大強度に達するまでの中間調ピボットからのストップ数。小さい値は暗い領域により積極的に作用します。
local_exposure.strength = 強度
local_exposure.strength.tip = ローカル露出補正の全体的な量。
local_exposure.title = ローカル露出

# pass
pass.auto_mask = 自動マスク
pass.auto_mask.tip = モデルがキャラクターの皮膚を検出し、その編集を個別に適用できるようにします。
pass.cat.model = モデル
pass.cat.residual_edits = 残差編集
pass.cat.strength = 強度
pass.cat.temporal = テンポラル再投影
pass.cheap_preset.auto = 自動
pass.cheap_preset.auto.tip = このパス自身の Render Preset を使用します。1 つの NGX 機能が両方のモデルにサーブします。
pass.cheap_preset.performance = パフォーマンス
pass.cheap_preset.performance.tip = ヒント 2 で安価なモデルの機能を作成します。
pass.cheap_preset.quality = 品質
pass.cheap_preset.quality.tip = ヒント 1 で安価なモデルの機能を作成します。
pass.chroma_strength = クロマ強度
pass.chroma_strength.tip = 元のクロマと編集済みクロマの間をブレンドします。
pass.correct_motion = モーションベクトルを補正
pass.correct_motion.tip = このパスが信頼できるモーションフィールドを生成します。フレームの最初の Pre/Post-DLSS パスは、それが作成された画像を処理するため、ゲームのベクトルをそのまま保持します。それ以降のすべてのパス、およびすべてのバックバッファパスは、補正されたフィールドを受け取ります：検索はゲームのベクトルの数ピクセル周囲に制限され、前のフィールドにバイアスされます。ゲームのベクトルがない場合、パスは代わりに色と深度からそれらを合成します。モデルとテンポラル再投影の両方に供給されます。パスごとに 1 つの GPU ディスパッチを消費し、使用可能な深度ガイドが必要です。
pass.edit_strength = 編集強度
pass.edit_strength.tip = ソースに運ばれる前に、モデルの編集をスケールします。
pass.enabled = 有効
pass.enabled.tip = このパスプロファイルを有効または無効にします。無効なパスはモデルを評価しません。
pass.grade_input.apply_to_pre_grade = 編集をグレード前画像に適用
pass.grade_input.apply_to_pre_grade.tip = モデルの編集をグレード前の画像に適用し、グレードが出力に達しないようにします。オフの場合、グレード済みのモデル出力がそのまま使用されます。
pass.grade_input.enabled = モデル入力をグレード
pass.grade_input.enabled.tip = モデル評価前に、モデルが読み取る画像をグレードします。
pass.grade_input.title = モデル入力をグレード
pass.grade_output.enabled = モデル出力をグレード
pass.grade_output.enabled.tip = モデルが生成したものを公開前にグレードします。
pass.grade_output.title = モデル出力をグレード
pass.intensity = 強度
pass.intensity.tip = モデルに画像を編集する強さをどの程度指示するか。\n0 はモデル評価を完全にスキップします
pass.local_structure = ローカル構造
pass.local_structure.tip = モデルのローカル構造ディテールをどの程度適用するか。
pass.local_tone = ローカルトーン
pass.local_tone.tip = モデルのローカルトーン調整をどの程度適用するか。
pass.luma_strength = 輝度強度
pass.luma_strength.tip = 元の輝度と編集済み輝度の間をブレンドします。
pass.menu.copy_from_next = 次のパスからコピー
pass.menu.copy_from_previous = 前のパスからコピー
pass.name = 名前
pass.name.tip = このパスのタブに表示されるラベル。空の場合は位置デフォルトの「Pass N」が表示されます。
pass.order = パス順序
pass.preset = プリセット
pass.preset.a = A
pass.preset.a.tip = モデルプリセット A を使用します。変更は評価ごとに適用され、機能を再構築せずにモデルの内部履歴をリセットします。
pass.preset.b = B
pass.preset.b.tip = モデルプリセット B を使用します。変更は評価ごとに適用され、機能を再構築せずにモデルの内部履歴をリセットします。
pass.preset.c = C
pass.preset.c.tip = モデルプリセット C を使用します。変更は評価ごとに適用され、機能を再構築せずにモデルの内部履歴をリセットします。
pass.preset.tip = このパスのモデル品質/動作プリセットを選択します。
pass.ratio_brighten = 比率明るさ上げ
pass.ratio_brighten.tip = Ratio Clamps が有効な場合の、チャンネルごとの残差比率の上限。SDR および HDR 合成の両方に適用されます。
pass.ratio_clamps = 比率クランプ
pass.ratio_clamps.tip = 整形前に、チャンネルごとのモデル残差ログ比率を [Ratio Darken, Ratio Brighten] 範囲に制限します。SDR および HDR 合成の両方に適用されます。
pass.ratio_darken = 比率暗さ下げ
pass.ratio_darken.tip = Ratio Clamps が有効な場合の、チャンネルごとの残差比率の下限。SDR および HDR 合成の両方に適用されます。
pass.ratio_eps = 比率 Eps
pass.ratio_eps.tip = チャンネルごとの残差ログ比率の分母フロア。チャンネルがゼロに近い場合に残差を有限に保ちます。SDR および HDR 合成の両方に適用されます。
pass.render_preset = レンダープリセット
pass.render_preset.performance = パフォーマンス
pass.render_preset.performance.tip = ヒント 2：パフォーマンス指向のプリセット。
pass.render_preset.quality = 品質
pass.render_preset.quality.tip = ヒント 1：品質指向のプリセット。
pass.render_preset.tip = このパスの DLSSNR.Hint.Render.Preset ヒント。NGX は機能作成時にそれをラッチするため、変更するとこのパスの機能を再構築します。
pass.residual_chroma = クロマ強度
pass.residual_chroma.tip = 編集のクロマがその明るさに対してどの程度反映されるか。
pass.residual_gamma = 編集ガンマ
pass.residual_gamma.tip = 編集の応答曲線を整形します。
pass.residual_highlight = ハイライト保護
pass.residual_highlight.tip = 中〜高輝度以上で編集をフェードアウトします。
pass.residual_shadow = シャドウ保護
pass.residual_shadow.tip = 中〜低輝度以下で編集をフェードアウトします。
pass.skin_structure = スキン構造
pass.skin_structure.tip = モデルが皮膚固有の編集をどの程度強く適用するかを制御します。モデルの自動マスキングオプションがオフの場合は無効です。
pass.target = ターゲット
pass.target.backbuffer = バックバッファ
pass.target.backbuffer.tip = ReShade Present で最終的なスワップチェーンバックバッファ上で実行します。ゲームが DLSS を使用していない場合でも動作します。それらのステージが利用可能でない限り、Pre/Post-DLSS パスと順序付けられません。
pass.target.post_dlss = Post-DLSS
pass.target.post_dlss.tip = ゲームの DLSS 評価の直後、後続のポストプロセッシングと UI の前に、そのアップスケール出力上で実行します。
pass.target.pre_dlss = Pre-DLSS
pass.target.pre_dlss.tip = ゲームの DLSS 評価の前、その入力 Color リソース上で実行します。ゲームはその後、修正された画像をアップスケールします。フル解像度の Color 入力が必要です。
pass.target.tip = 各パスは Pre-DLSS、Post-DLSS、またはバックバッファを独立してターゲットにできます。実行順序はステージごとにグループ化され、各ステージ内のパスはパスタブの順序に従います。ターゲットを変更すると、モデルの内部履歴は次の評価でリセットされます。
pass.temporal.adaptive = アダプティブ
pass.temporal.adaptive.tip = ピクセルごとの信頼度が許す限り再投影編集を再利用し、N フレームごとに少なくとも 1 回の更新を強制します。N は Cadence スライダーです。無効ピクセル割合が高い場合、実効的なケイデンスは半分になります。
pass.temporal.cadence = ケイデンス
pass.temporal.cadence.tip = モデル評価間のフレーム数。アダプティブモードではこれは最大値。無効ピクセル割合が高い場合、実効的なケイデンスは半分になります。固定モードでは、これは正確なケイデンスです。
pass.temporal.cheap = 安価なモデル
pass.temporal.cheap.tip = 完全評価の間のフレームで、2 つ目のより安価なモデルを実行し、再投影信頼度が低い場所でその編集を採用します。オフの場合、それらのフレームは履歴のみから再構成され、追加コストはかかりませんが、ディスオクルージョンと高速な動きは次の完全評価まで未解決のままです。
pass.temporal.cheap_preset = 安価なモデルプリセット
pass.temporal.cheap_preset.tip = 安価なモデル自身の機能のレンダープリセット。自動はこのパスのプリセットに従います（2 つ目の機能は不要）。それ以外は機能を作成します。NGX は作成時にヒントをラッチするためです。
pass.temporal.cheap_scale = 安価なモデルスケール
pass.temporal.cheap_scale.tip = より安価なモデルの解像度（ワーキングスケールに対する割合）。0.5 はワーキングスケール解像度の 50% を意味します。低い値は高速ですが、低信頼度の再投影領域をより少ないディテールで埋めます。
pass.temporal.depth_abs = 深度絶対
pass.temporal.depth_abs.tip = モーション再投影後に許容される絶対深度差。
pass.temporal.depth_rel = 深度相対
pass.temporal.depth_rel.tip = 相対深度差の許容値。しきい値はこの許容値と深度絶対の大きい方です。
pass.temporal.fixed = 固定
pass.temporal.fixed.tip = モデル評価間で、信頼度に関係なく固定数のフレームの間再投影編集を再利用します。Cadence スライダーが正確なケイデンスです。
pass.temporal.fp16_history = FP16 編集履歴
pass.temporal.fp16_history.tip = テンポラル編集/候補テクスチャを FP16 に格納します。再利用された編集の小さな量子化差と引き換えに、履歴の帯域幅とメモリを削減します。
pass.temporal.max_invalid = 最大無効 %
pass.temporal.max_invalid.tip = モデルを更新する前に許容される、無効または測光不一致のピクセル割合の最大値。
pass.temporal.max_motion = 最大モーション
pass.temporal.max_motion.tip = モーションがこのワーキング解像度ピクセル数を超えた場合、再投影を拒否します。
pass.temporal.mode = モード
pass.temporal.mode.tip = モデルを毎フレーム評価する代わりに、モーション再投影された乗法的モデル編集を再利用します。現在のフレームの深度とモーションフィールド（ゲームのもの、または Correct Motion Vectors が生成したもの）が必要です。不確実な履歴は新しい評価を強制します。
pass.temporal.off = オフ
pass.temporal.off.tip = ニューラルモデルを毎フレーム評価します。
pass.temporal.photo_abs = 写真絶対
pass.temporal.photo_abs.tip = 現在のピクセルとそのモーション再投影された前フレームの一致との間に許容される、絶対的なモデル入力輝度差。
pass.temporal.photo_rel = 写真相対
pass.temporal.photo_rel.tip = 相対輝度差の許容値。より大きい絶対現在輝度または前輝度のいずれかでスケールされます。Photo Abs に加算されます。
pass.ui_correction = UI 補正
pass.ui_correction.tip = モデルが UI 要素を検出した場所で、モデルの編集を減らします。
pass.upsample_sharpness = アップサンプルシャープネス
pass.upsample_sharpness.tip = モデル入力および出力の固定ジョイントバイラテラル 3x3 再構成のためのエッジ保持指数。高い値はフル解像度のガイドエッジをより鋭く追跡し、低い値は低解像度近傍をより滑らかにブレンドします。これはモデル編集をスケールしません。
pass.working_scale = ワーキングスケール
pass.working_scale.reset_tip = ワーキングスケールと x2 をデフォルトにリセットします。
pass.working_scale.slider_tip = モデルのワーキング解像度（フレームに対する割合）。\n\n非常に低い値は最小 180p の垂直解像度に引き上げられ、テンポラル再投影が常に使用可能な履歴を持つようにします。この値を変更すると、モデルの内部履歴は次の評価でリセットされます。
pass.working_scale.tip = モデルが実行される解像度（フレームに対する割合）。スーパーサンプリングのために x2 をチェックして倍にします。合成とバックバッファはフレーム解像度のままです。
pass.working_scale.x2_off_tip = 現在、スーパーサンプリングのためにモデルのワーキング解像度を倍にしています。チェックを外すとスライダーの値に戻ります。この設定を変更すると、モデルの内部履歴は次の評価でリセットされます。\n\nチェックを外した後の最初のフレームも、より小さなリソースが割り当てられ、以前のリソースが GPU でリタイアしている間に、一時的にフリーズする可能性があります。
pass.working_scale.x2_on_tip = スーパーサンプリングのためにモデルのワーキング解像度を倍にします。これにより、モデルの内部履歴は次の評価でリセットされます。\n\n警告：有効にすると、切り替え後の最初のフレームでゲームが一瞬フリーズする可能性があります。より大きなワーキングスケールリソース（ワーキング入力/出力、テンポラル履歴、非リフト参照）が割り当てられ、以前のインフライトバッファが GPU でリタイアしている間です。\n\nその他の危険性：\n  - ワーキングスケールリソースの VRAM 使用量は約 4 倍になります。\n  - モデル評価と合成は 2x で遅くなります。\n  - 再利用フレームで再利用される安価なモデルはワーキングスケールとともに成長するため、再利用フレームもより高価になります。\n  - 1〜2 秒以上のフリーズは通常、デバイスが VRAM を使い果たしたことを意味します。これをオフにして回復してください。

# prefs
prefs.clone_resources = ゲームリソースをクローン
prefs.clone_resources.tip = オフ（デフォルト）：ゲームの現在の深度/モーションデータと DLSS 出力を直接読み取ります。オン：現在のフレームの深度/モーション、および Post-DLSS が有効な場合は DLSS 出力を、アドオン所有のテクスチャにコピーします。この 1 つのオプションはバックバッファを含むすべてのステージに適用されます。要求されたモードは新しい DLSS 評価で安全にラッチされます。
prefs.fp16_storage = FP16 パイプライン
prefs.fp16_storage.tip = HDR ゲインマップキャリア、モデルのワーキングテクスチャ、および非リフト合成参照を RGBA32F の代わりに RGBA16F に格納します。キャリアから HDR への乗数とモデル領域デルタの量子化を犠牲にして、HDR パイプラインの帯域幅とフットプリントを半減します。SDR パスは影響を受けません。切り替えるとテンポラル履歴をリセットし、NGX 機能を再構築します。
prefs.invert_fallback_depth = フォールバック深度を反転
