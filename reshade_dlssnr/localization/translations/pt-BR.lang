# debug
debug.title = Depuração
debug.view = Visão de Depuração
debug.view.depth = Profundidade
debug.view.depth.tip = O buffer de profundidade que o jogo forneceu ao DLSS. Exibido em escala de cinza.
debug.view.exposure_mask = Máscara de Exposição
debug.view.exposure_mask.tip = A máscara da frame atual a partir da entrada real do modelo (incluindo a gradação de entrada e a Exposição Local) em comparação com a saída bruta do modelo. É publicada para uso de exposição na próxima frame.
debug.view.gain_map = Mapa de Ganho
debug.view.gain_map.tip = Multiplicador bruto de reconstrução f32 portador-para-HDR, exibido em paradas log2 de -4 (preto) a +6 (branco).
debug.view.game_exposure = Exposição do Jogo
debug.view.game_exposure.tip = Exposição NGX do jogo em paradas: 1,0x (0 paradas) é cinza médio; valores mais claros/escuros se aproximam do branco/preto. Magenta significa que nenhum valor válido foi lido.
debug.view.hdr_local_exposure = Exposição Local HDR
debug.view.hdr_local_exposure.tip = Fator de exposição local em paradas, mapeado para que 0 paradas seja cinza médio, -2 paradas seja preto e +2 paradas seja branco.
debug.view.hdr_roundtrip_diagnostic = Diagnóstico de Ida e Volta HDR
debug.view.hdr_roundtrip_diagnostic.tip = Comparação 2x2: Entrada de Modelo preparada real | Saída do Modelo / HDR composto mapeado de volta ao domínio do modelo não graduado | diferença de composição em relação à Saída do Modelo não graduada. Arestas não nulas podem ser esperadas porque o detalhe de fonte em resolução total é preservado; a escala de trabalho afeta essa comparação. Use Erro de Ida e Volta HDR para a verificação isolada de reconstrução do portador.
debug.view.hdr_roundtrip_error = Erro de Ida e Volta HDR
debug.view.hdr_roundtrip_error.tip = Erro relativo em falso colorido entre a fonte HDR decodificada original e a reconstrução direta float32 a partir do portador RGBA32F e do multiplicador portador-para-HDR. Isso valida apenas a transferência do portador, não a edição do modelo nem a composição final; independente da Escala de Trabalho e da gradação de entrada.
debug.view.hint = A visão é renderizada pela passagem atualmente selecionada nas abas abaixo e só tem efeito enquanto essa passagem estiver ativada.
debug.view.model_input_pre_grade = Entrada do Modelo (pré-gradação)
debug.view.model_input_pre_grade.tip = A cor de entrada do modelo exatamente como estava antes da Gravação de Entrada ser executada. A gradação é aplicada no local, então o pipeline captura essa textura para você quando a visão é selecionada; com a Gravação de Entrada ativada, compare-a com Entrada do Modelo (preparada).
debug.view.model_input_prepared = Entrada do Modelo (preparada)
debug.view.model_input_prepared.tip = A imagem efetivamente alimentada ao modelo, após o redimensionamento para a Escala de Trabalho, preparação HDR e gradação de entrada quando ativada.
debug.view.model_input_source = Entrada do Modelo (fonte)
debug.view.model_input_source.tip = A frame conforme capturada, antes de qualquer processamento. Esta é a saída do DLSS da qual o modelo trabalhará, em sua resolução nativa.
debug.view.model_output_composed = Saída do Modelo (composta)
debug.view.model_output_composed.tip = O resultado final desta passagem, após a edição do modelo ser composta com a fonte. É isso que é gravado no destino.
debug.view.model_output_post_grade = Saída do Modelo (pós-gradação)
debug.view.model_output_post_grade.tip = A saída do modelo após a Gravação de Saída ser executada, no próprio domínio SDR codificado em sRGB do modelo - simétrica à Gravação de Entrada na entrada do modelo. Tudo a jusante (composição, máscara de exposição, writeback) consome isso como se o modelo o tivesse produzido.
debug.view.model_output_raw = Saída do Modelo (bruta)
debug.view.model_output_raw.tip = A saída do modelo exatamente como a NGX a produziu, antes da Gravação de Saída ser aplicada. Captura feita pelo pipeline porque a gradação roda no local; com a Gravação de Saída ativada, compare-a com Saída do Modelo (pós-gradação).
debug.view.motion_vectors = Vetores de Movimento
debug.view.motion_vectors.tip = O campo de movimento que esta passagem avalia: os vetores do jogo, ou o campo que Correct Motion Vectors produziu para ela. Exibido como R = direção x, G = direção y.
debug.view.off = Desativado
debug.view.off.tip = Desativa a visão de depuração e mostra a saída composta normal.
debug.view.sdr_base_pre_model = Base SDR (pré-modelo)
debug.view.sdr_base_pre_model.tip = Carga RGB de SDR linear em resolução total produzida pela divisão BT.2446C. Esta é a carga RGB da qual o modelo é subamostrado.
debug.view.temporal_candidate_status = Status do Candidato Temporal
debug.view.temporal_candidate_status.tip = Confiança de reprojeção antes da validação de profundidade, exibida em escala de cinza (branco = totalmente confiável, preto = rejeitado). A confiança combina concordância de limitação de edição local, concordância fotométrica e confiança anterior. Indisponível até que uma edição anterior possa ser reprojetada.
debug.view.temporal_reprojected_edit = Edição Reprojetada Temporal
debug.view.temporal_reprojected_edit.tip = Ganho logarítmico por canal validado da frame anterior, mapeado para que ganho neutro seja cinza e edições positivas/negativas mais fortes se aproximem do branco/preto. Pixels rejeitados estão escuros.
debug.view.temporal_validation_status = Status de Validação Temporal
debug.view.temporal_validation_status.tip = Confiança após a validação de profundidade, exibida em escala de cinza. A confiança dimensiona o peso da edição aplicada; valores baixos desvanecem a edição em direção à entrada.
debug.view.tip = Substitui a imagem final por um buffer interno, para inspecionar o pipeline.

# exposure_mask
exposure_mask.chroma_threshold = Limite de Croma
exposure_mask.chroma_threshold.tip = Diferença mínima apenas de croma para marcar uma edição do modelo.
exposure_mask.edit_strength = Força da Edição
exposure_mask.edit_strength.tip = Dimensiona a diferença medida entrada/saída do modelo antes do limiar.
exposure_mask.enabled = Ativar
exposure_mask.enabled.tip = Esta passagem constrói sua Máscara de Exposição após a avaliação do modelo. A máscara afeta apenas a medição HDR da próxima frame desta passagem.
exposure_mask.luma_relative = Luma Relativa
exposure_mask.luma_relative.tip = Diferença mínima de luma relativa à luma de entrada/saída mais clara.
exposure_mask.luma_threshold = Limite de Luma
exposure_mask.luma_threshold.tip = Diferença mínima de luma absoluta para marcar uma edição do modelo.
exposure_mask.response = Resposta Temporal
exposure_mask.response.tip = Mistura novos votos de máscara com a máscara da frame anterior.
exposure_mask.smoothing = Suavização Espacial
exposure_mask.smoothing.tip = Filtra por maioria os votos binários de exposição em uma pequena vizinhança.
exposure_mask.title = Máscara de Exposição

# grade
grade.black_level = Nível de Preto
grade.black_level.tip = O valor de luminosidade OKLab mapeado para preto. Valores positivos escurecem apenas as sombras mais profundas; valores negativos elevam a ponta.
grade.brightness = Brilho
grade.brightness.tip = No modo Exposição, o valor está em paradas (-1 reduz pela metade a luz linear; +1 a dobra). Outros modos usam sua própria curva de brilho.
grade.brightness_mode = Modo de Brilho
grade.brightness_mode.tip = Qual algoritmo o brilho usa. Estas são alternativas, não camadas.
grade.cas = Nitidez CAS
grade.cas.tip = Ativa o Contrast Adaptive Sharpening da AMD FidelityFX no resultado graduado. Executa como um despacho separado apenas em SDR linear; ignorado para formatos HDR.
grade.cas_strength = Força CAS
grade.cas_strength.tip = Quantidade de nitidez para o CAS da AMD FidelityFX. 0 não aplica nitidez, 1 aplica nitidez máxima.
grade.chroma_mode = Modo de Croma
grade.chroma_mode.saturation = Saturação
grade.chroma_mode.saturation.tip = Dimensiona o croma OKLab pelo mesmo fator preservando o matiz perceptual.
grade.chroma_mode.tip = Qual algoritmo a saturação usa. Estas são alternativas, não camadas.
grade.chroma_mode.vibrance = Vibração
grade.chroma_mode.vibrance.tip = Realça cores fracas com mais força em OKLab, reduzindo o efeito conforme o croma aumenta.
grade.contrast = Contraste
grade.contrast.tip = Uma curva em S pivotada em torno da luminosidade média. Positivo aumenta o contraste e negativo o reduz mantendo preto e branco ancorados.
grade.edge_softening = Suavização Ciente de Aresta
grade.edge_softening.tip = Mistura uma vizinhança joint-bilateral 3x3 na entrada da gradação. Similaridade de luminância reduz o desfoque através de arestas fortes.
grade.highlights = Realces
grade.highlights.tip = Ajusta realces com uma curva suave que se esvai antes do preto.
grade.luma_mode.exposure = Exposição
grade.luma_mode.exposure.tip = Multiplica RGB em luz linear por 2^valor (paradas); mapeamento de gamut protege cores quando o resultado excede a faixa de saída.
grade.luma_mode.gain = Ganho
grade.luma_mode.gain.tip = Dimensiona a luminosidade OKLab por uma curva multiplicativa limitada.
grade.luma_mode.gamma = Gama
grade.luma_mode.gamma.tip = Aplica uma curva de potência com sinal à luminosidade OKLab. Preto e branco neutros permanecem ancorados, concentrando o efeito nos meios-tons.
grade.luma_mode.soft = Suave
grade.luma_mode.soft.tip = Um ajuste suave de luminosidade que se esvai a zero perto do preto e do branco.
grade.saturation = Saturação
grade.saturation.tip = Ajusta o croma perceptual em OKLab. Cores fora do gamut são comprimidas em direção ao eixo neutro para evitar artefatos de recorte de canal.
grade.shadows = Sombras
grade.shadows.tip = Ajusta sombras com uma curva suave que se esvai antes do branco.
grade.softening_strength = Força de Suavização
grade.softening_strength.tip = Quantidade de suavização ciente de aresta 3x3.
grade.white_level = Nível de Branco
grade.white_level.tip = O valor de luminosidade OKLab mapeado para branco. Elevar o ponto reduz a imagem; cores fora do gamut são comprimidas em vez de cortadas por canal.

# grade_backbuffer
grade_backbuffer.enabled = Ativado
grade_backbuffer.enabled.tip = Gradua a imagem final do swapchain após cada passagem, imediatamente antes da apresentação. Isso é independente das gradações de entrada e saída do modelo de cada passagem.
grade_backbuffer.title = Graduar Backbuffer

# hdr
hdr.adaptive.enabled = Exposição Adaptativa
hdr.adaptive.enabled.tip = Com a Exposição do Jogo desativada, fornece exposição global a partir de uma medição de histograma. Com a Exposição do Jogo ativada, aplica Força sobre o Jogo como uma correção limitada (sem efeito em 0). Não tem efeito até a primeira medição chegar.
hdr.adaptive.max_correction = Paradadas Máx. de Correção
hdr.adaptive.max_correction.tip = Ajuste máximo em torno da Exposição do Jogo quando ambas as camadas estão ativadas.
hdr.adaptive.midtone = Alvo de Meio-tom
hdr.adaptive.midtone.tip = Luminância alvo para a população selecionada.
hdr.adaptive.speed_down = Velocidade de Escurecimento
hdr.adaptive.speed_down.tip = Redução máxima de exposição em paradas por segundo.
hdr.adaptive.speed_up = Velocidade de Clareamento
hdr.adaptive.speed_up.tip = Aumento máximo de exposição em paradas por segundo.
hdr.adaptive.strength_over_game = Força sobre o Jogo
hdr.adaptive.strength_over_game.tip = Quando a Exposição do Jogo está ativa, adiciona esta fração da correção em paradas do alvo adaptativo. Com o Jogo desativado, a Adaptativa é a exposição base.
hdr.bt2446_ip = Inflexão BT.2446C
hdr.bt2446_ip.tip = Posição do joelho no domínio da curva BT.2446C. O conteúdo acima deste ponto é comprimido em log; o conteúdo abaixo é linear. O controle deslizante cobre a faixa útil para conteúdo HDR real. Valores fora dela ainda podem ser digitados: 10000 desativa a compressão.
hdr.bt2446_k1 = k1 BT.2446C
hdr.bt2446_k1.tip = Inclinação da região linear: Y_SDR = k1 * Y_HDR para conteúdo abaixo do ponto de inflexão. Também a inclinação que o ramo log iguala no joelho.
hdr.bt2446_k2 = k2 BT.2446C (derivado)
hdr.bt2446_k2.tip = Inclinação da região log da curva BT.2446C. Derivada de k1, k3 e do ponto de inflexão, para que o ramo log iguale a inclinação do ramo linear no joelho.
hdr.bt2446_k3 = k3 BT.2446C
hdr.bt2446_k3.tip = Força de compressão de ombro. Valores maiores puxam o ramo log para baixo com mais força, escurecendo mais os realces. k2 e k4 são derivados disto, para que a curva permaneça suave no joelho.
hdr.bt2446_k4 = k4 BT.2446C (derivado)
hdr.bt2446_k4.tip = Interceptação da região log da curva BT.2446C. Derivada de k1, k3 e do ponto de inflexão, para que o ramo log iguale o valor do ramo linear no joelho.
hdr.cat.advanced = Avançado
hdr.cat.diagnostics = Diagnósticos
hdr.cat.filters = Filtros
hdr.common.available = disponível
hdr.common.no = não
hdr.common.not_seen = não visto
hdr.common.pending = pendente
hdr.common.ready = pronto
hdr.common.unavailable = indisponível
hdr.common.valid = válido
hdr.common.yes = sim
hdr.crosstalk = Diafonia
hdr.crosstalk.tip = Quantidade de pré-dessaturação BT.2446C.
hdr.density.full = Total
hdr.density.full.tip = Amostra cada pixel. Histograma de densidade total, maior precisão.
hdr.density.quarter = 1/4
hdr.density.quarter.tip = Amostra cada 2º pixel em cada eixo (1/4 da frame). Pequenos realces isolados podem ser perdidos.
hdr.density.sixteenth = 1/16
hdr.density.sixteenth.tip = Amostra cada 4º pixel em cada eixo (1/16 da frame). Realces isolados e detalhes finos podem ser perdidos.
hdr.density.sixty_fourth = 1/64
hdr.density.sixty_fourth.tip = Amostra cada 8º pixel em cada eixo (1/64 da frame). Adequado apenas para conteúdo aproximadamente uniforme.
hdr.detailed_statistics = Estatísticas HDR Detalhadas
hdr.detailed_statistics.tip = Coleta a faixa completa do mapa de ganho e estatísticas de excursão. Adiciona dois despachos de GPU quando ativado.
hdr.diag.adaptive_scene_white = branco de cena adaptativo: %.4f
hdr.diag.async_note = Os valores atualizam assincronamente. Exposição e histograma refletem a medição mais recente que a GPU terminou de gravar.
hdr.diag.exposure = Exposição: %.4f
hdr.diag.format = Formato: %s - resolvido=%s
hdr.diag.gain_excursions = excursões SDR: %u
hdr.diag.gain_map = Mapa de ganho: %s
hdr.diag.gain_out_of_range = fora da faixa: %u
hdr.diag.gain_range = faixa (log2): %.3f .. %.3f
hdr.diag.game_exposure = Exposição do jogo: %s
hdr.diag.game_texture = textura: %ux%u fmt=%d
hdr.diag.game_value = valor: %.4f
hdr.diag.guides = Guias DLSS: %s
hdr.diag.histogram = Histograma (luminância log2)
hdr.diag.histogram.tip = Histograma da luminância log2 medida. A população depende dos filtros de exposição ativos.
hdr.diag.histogram_missing = Histograma: não pronto
hdr.diag.metering_source = Fonte de medição: %s
hdr.diag.post_blocked = Post-DLSS bloqueado: %s
hdr.diag.reference_luma = luma de referência: %.4f
hdr.diag.samples = Amostras: %u - frames desde a medição: %u
hdr.diag.scene_white = Branco de cena: %.4f
hdr.diag.warming = Aquecendo - nenhuma medição de exposição ainda.
hdr.enabled = Ativar
hdr.enabled.tip = Mede a imagem HDR imediatamente antes desta passagem. Passagens posteriores medem a imagem composta pela passagem anterior, a menos que a reutilização de medição esteja ativada. Passagens de backbuffer usam composição SDR.
hdr.format = Formato
hdr.format.auto = Automático
hdr.format.auto.tip = Detecta o formato automaticamente a partir da fonte Pre/Post-DLSS ativa.
hdr.format.hdr10 = HDR10
hdr.format.hdr10.tip = Trata a fonte como HDR10 PQ (ST.2084).
hdr.format.scrgb = scRGB
hdr.format.scrgb.tip = Trata a fonte como scRGB linear (1,0 = 80 nits).
hdr.format.sdr = SDR
hdr.format.sdr.tip = Trata a fonte como SDR sRGB.
hdr.format.tip = Como a imagem de origem está codificada. Auto detecta a partir do formato DXGI da saída DLSS.
hdr.gain_max = Ganho Máx.
hdr.gain_max.tip = Ganho portador-para-HDR máximo esperado em paradas log2. Usado apenas pelas estatísticas do mapa de ganho de diagnóstico e visões de depuração; não afeta a composição.
hdr.gain_min = Ganho Mín.
hdr.gain_min.tip = Ganho portador-para-HDR mínimo esperado em paradas log2. Usado apenas pelas estatísticas do mapa de ganho de diagnóstico e visões de depuração; não afeta a composição.
hdr.game.bias = Viés de Exposição
hdr.game.bias.tip = Viés manual relativo à exposição do jogo, em paradas. Zero deixa o valor do jogo intocado.
hdr.game.enabled = Exposição do Jogo
hdr.game.enabled.tip = Usa a ExposureTexture NGX do jogo como exposição base. Se o jogo não fornecer uma, esta camada cai e a Exposição Adaptativa pode fornecer a base.
hdr.highlight_headroom = Reserva de Realces
hdr.highlight_headroom.tip = Escala o pico HDR efetivo usado pela BT.2446C. Isso não altera como a exposição é interpretada.
hdr.layer.adaptive = Exposição Adaptativa
hdr.layer.adaptive.tip = Exposição global baseada em histograma ou uma correção limitada sobre a Exposição do Jogo.
hdr.layer.game = Exposição do Jogo
hdr.layer.game.tip = Configura a exposição do jogo como a camada base.
hdr.layers.stack_order = Ordem de pilha: base Exposição do Jogo, depois correção Adaptativa. Exposição Local é sua própria seção e se aplica após ambas.
hdr.measure_interval = Intervalo de Medição
hdr.measure_interval.tip = Com que frequência os histogramas de exposição são medidos, em frames.
hdr.metering_density = Densidade de Medição
hdr.metering_density.tip = Quantos pixels o histograma HDR amostra. Densidade total captura cada pixel; densidades mais grossas amostram menos pixels a um custo menor de GPU.
hdr.reuse_previous_pass = Reutilizar Medição HDR da Passagem Anterior
hdr.reuse_previous_pass.tip = Para passagens posteriores na mesma cadeia Pre-DLSS ou Post-DLSS, reutiliza a medição HDR da passagem anterior em vez de despachar um novo histograma. A primeira passagem ainda mede a fonte do jogo.
hdr.source.filtered = População filtrada
hdr.source.full_frame = Frame completa
hdr.source.game_exposure = Exposição do jogo (NGX)
hdr.source.unknown = Desconhecido
hdr.title = HDR

# hdr_filters
hdr_filters.depth = Profundidade
hdr_filters.depth.tip = Restringe esta camada ao intervalo de profundidade normalizado selecionado.
hdr_filters.depth_far = Profundidade Distante
hdr_filters.depth_far.tip = Extremidade distante do intervalo de profundidade normalizado aceito.
hdr_filters.depth_near = Profundidade Próxima
hdr_filters.depth_near.tip = Extremidade próxima do intervalo de profundidade normalizado aceito.
hdr_filters.exposure_mask = Máscara de Exposição
hdr_filters.exposure_mask.tip = Mede ou corrige apenas pixels ponderados pela máscara persistente da Máscara de Exposição.
hdr_filters.percentile_high = Percentil Alto
hdr_filters.percentile_high.tip = Limite de percentil superior para esta camada.
hdr_filters.percentile_low = Percentil Baixo
hdr_filters.percentile_low.tip = Limite de percentil inferior. Jogo/Adaptativa usam a faixa para medição; Local a usa como faixa de proteção de luminância.
hdr_filters.percentile_range = Faixa de Percentil
hdr_filters.percentile_range.tip = Para Jogo/Adaptativa, seleciona uma faixa de percentil do histograma desta camada. Para Exposição Local, esvai a correção local fora de sua faixa de luminância medida.

# local_exposure
local_exposure.bright_detail_protection = Proteção de Detalhe Claro
local_exposure.bright_detail_protection.tip = Controla se uma vizinhança escura pode elevar pixels acima do pivô. 1 mantém os pontos claros ancorados; 0 permite correção além do pivô.
local_exposure.cat.advanced = Avançado
local_exposure.dark_detail_protection = Proteção de Detalhe Escuro
local_exposure.dark_detail_protection.tip = Controla se uma vizinhança clara pode escurecer pixels abaixo do pivô. 1 mantém os detalhes escuros ancorados; 0 permite correção além do pivô.
local_exposure.detail_retention = Retenção de Detalhe
local_exposure.detail_retention.tip = Retém o detalhe de log-luminância do pixel relativo à sua base local. 1 preserva todo o detalhe relativo; valores menores o comprimem.
local_exposure.edge_protection = Proteção de Aresta
local_exposure.edge_protection.tip = Reduz a influência de amostras através de fortes arestas de log-luminância. 0 usa apenas pesos espaciais; valores mais altos reduzem halos, mas podem tornar a adaptação mais local.
local_exposure.enabled = Exposição Local
local_exposure.enabled.tip = Aplica uma correção de exposição espacialmente variável, pivotando em um meio-tom referenciado à exibição. Funciona em qualquer fonte: o caminho HDR atinge o pivô através de sua curva de tom, um caminho referenciado à exibição o lê da imagem.
local_exposure.highlight_reduction = Redução de Realces
local_exposure.highlight_reduction.tip = Multiplicador independente para redução de realces. Defina como zero para deixar as regiões claras onde estão, ainda elevando as sombras.
local_exposure.highlight_transition = Transição de Realces
local_exposure.highlight_transition.tip = Paradadas acima do pivô de meio-tom sobre as quais a redução de realces aumenta até a força total. Um valor menor age mais agressivamente.
local_exposure.max_brighten = Clareamento Máx.
local_exposure.max_brighten.tip = Elevação máxima de sombras em paradas. Com proteção total de detalhe claro, pixels acima do pivô de meio-tom não são elevados mesmo quando sua vizinhança é escura.
local_exposure.max_darken = Escurecimento Máx.
local_exposure.max_darken.tip = Redução máxima de realces em paradas. Com proteção total de detalhe escuro, pixels abaixo do pivô não são escurecidos mesmo quando sua vizinhança é clara.
local_exposure.midtone = Meio-tom Local
local_exposure.midtone.tip = Alvo de luminância pivô no domínio SDR do modelo. Pixels perto deste pivô recebem pouca correção; sombras sobem e realces descem em direção a ele.
local_exposure.radius = Raio Local
local_exposure.radius.tip = Raio em pixels de fonte. Um raio de 1 desativa a amostragem de vizinhança multi-toque e usa apenas o pixel central. Raios maiores respondem a regiões amplas escuras/claras em vez do ruído de pixels individuais.
local_exposure.restore = Restaurar Exposição do Modelo
local_exposure.restore.tip = Aplica uma correção à saída do modelo após a avaliação. Quando desativado, o sombreamento local reconstruído do modelo é deixado intocado.
local_exposure.restore_scale = Escala Espacial de Restauração
local_exposure.restore_scale.tip = Controla a escala espacial da restauração de exposição: 0 = cancelamento exato pixel a pixel da elevação local, 1 = correção global uniforme, com mistura no espaço log entre elas. A restauração global retém mais das relações de brilho reconstruídas pelo modelo.
local_exposure.restore_strength = Força de Restauração
local_exposure.restore_strength.tip = Quantidade de restauração de exposição: 0 = nenhuma correção, 1 = correção total. Valores intermediários misturam a restauração selecionada no espaço de exposição log.
local_exposure.samples = Amostras de Vizinhança
local_exposure.samples.tip = Toques espaciais solicitados na estimativa local de log-luminância. A contagem efetiva arredonda para grupos de quatro para manter a amostragem espacialmente equilibrada.
local_exposure.shadow_lift = Elevação de Sombras
local_exposure.shadow_lift.tip = Multiplicador independente para elevação de sombras. Defina como zero para deixar as regiões escuras onde estão, ainda reduzindo realces.
local_exposure.shadow_transition = Transição de Sombras
