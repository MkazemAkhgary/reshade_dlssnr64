# language: zh-CN
# name: 简体中文
#
# Values are C string escapes: \n is a line break, \" a quote.
# An empty value means the English text is used.

# ctl
ctl.category.toggle = 展开或折叠%s子小节。
ctl.menu.copy = 复制
ctl.menu.paste = 粘贴
ctl.reset.default.tip = 恢复为声明的默认值。
ctl.section.toggle = 启用或禁用%s。

# debug
debug.title = 调试
debug.view = 调试视图
debug.view.depth = 深度
debug.view.depth.tip = 游戏提供给 DLSS 的深度缓冲，以灰度显示。
debug.view.exposure_mask = 曝光遮罩
debug.view.exposure_mask.tip = 当前帧的遮罩，由实际的模型输入（含输入调色与局部曝光）与原始模型输出对比得出。它在下一帧用于曝光处理。
debug.view.gain_map = 增益图
debug.view.gain_map.tip = 原始的 f32 载波到 HDR 重建倍率，以 log2 档显示，范围从 -4（黑）到 +6（白）。
debug.view.game_exposure = 游戏曝光
debug.view.game_exposure.tip = 游戏 NGX 曝光，单位为档：1.0x（0 档）为中灰；更亮或更暗的值分别趋近白或黑。洋红色表示未读到有效值。
debug.view.hdr_local_exposure = HDR 局部曝光
debug.view.hdr_local_exposure.tip = 局部曝光系数，单位为档，映射为 0 档中灰、-2 档黑、+2 档白。
debug.view.hdr_roundtrip_diagnostic = HDR 往返诊断
debug.view.hdr_roundtrip_diagnostic.tip = 2x2 对比：实际准备好的模型输入 | 映射回未调色模型域的模型输出/合成 HDR | 相对于未调色模型输出的合成差异。由于保留了全分辨率源细节，边缘出现非零值是正常的；工作倍率会影响这一对比。若要单独检查载波重建，请使用 HDR 往返误差。
debug.view.hdr_roundtrip_error = HDR 往返误差
debug.view.hdr_roundtrip_error.tip = 原始解码 HDR 源与由 RGBA32F 载波及载波到 HDR 倍率直接重建的 float32 结果之间的伪彩相对误差。这只验证载波传输，不验证模型编辑或最终合成；与工作倍率和输入调色无关。
debug.view.hint = 视图由下方标签页中当前选中的通道渲染，并且只有该通道启用时才生效。
debug.view.model_input_pre_grade = 模型输入（调色前）
debug.view.model_input_pre_grade.tip = 输入调色运行之前的模型输入颜色原样。调色是就地应用的，因此选中此视图时管线会为你快照这张纹理；若启用了输入调色，可将它与模型输入（已准备）对比。
debug.view.model_input_prepared = 模型输入（已准备）
debug.view.model_input_prepared.tip = 实际送入模型的图像，已经过缩放到工作倍率、HDR 准备，以及在启用时的输入调色。
debug.view.model_input_source = 模型输入（源）
debug.view.model_input_source.tip = 捕获到的画面，尚未经过任何处理。这就是模型将基于其工作的 DLSS 输出，保持其原始分辨率。
debug.view.model_output_composed = 模型输出（已合成）
debug.view.model_output_composed.tip = 本通道的最终结果，即模型编辑已与源图像合成之后。这就是写入目标的内容。
debug.view.model_output_post_grade = 模型输出（调色后）
debug.view.model_output_post_grade.tip = 输出调色运行之后的模型输出，位于模型自身的 sRGB 编码 SDR 域——与模型输入上的输入调色相对称。下游的一切（合成、曝光遮罩、写回）都把它当作模型直接产出的一样使用。
debug.view.model_output_raw = 模型输出（原始）
debug.view.model_output_raw.tip = NGX 产出的模型输出原样，尚未应用输出调色。由于调色是就地运行的，管线会快照这张纹理；若启用了输出调色，可将它与模型输出（调色后）对比。
debug.view.motion_vectors = 运动矢量
debug.view.motion_vectors.tip = 本通道用于评估的运动场：游戏提供的矢量，或“校正运动矢量”为它生成的场。显示为 R = x 方向，G = y 方向。
debug.view.off = 关闭
debug.view.off.tip = 关闭调试视图，显示正常的合成输出。
debug.view.sdr_base_pre_model = SDR 基础（模型前）
debug.view.sdr_base_pre_model.tip = 由 BT.2446C 分离产生的全分辨率线性 SDR 载波。这是模型降采样所依据的 RGB 数据。
debug.view.temporal_candidate_status = 时域候选状态
debug.view.temporal_candidate_status.tip = 深度验证之前的重投影置信度，以灰度显示（白 = 完全可信，黑 = 被拒绝）。置信度综合了局部编辑钳制一致性、光度一致性和上一帧的置信度。在能够重投影上一帧编辑之前不可用。
debug.view.temporal_reprojected_edit = 时域重投影编辑
debug.view.temporal_reprojected_edit.tip = 来自上一帧的、经校验的逐通道对数增益，映射为中性增益为灰、更强正负编辑分别趋近白或黑。被拒绝的像素为暗色。
debug.view.temporal_validation_status = 时域验证状态
debug.view.temporal_validation_status.tip = 深度验证之后的置信度，以灰度显示。置信度会缩放所应用的编辑权重；较低的值会让编辑向输入淡出。
debug.view.tip = 用内部缓冲替换最终图像，以便检查管线。

# exposure_mask
exposure_mask.chroma_threshold = 色度阈值
exposure_mask.chroma_threshold.tip = 标记模型编辑所需的最小纯色度差异。
exposure_mask.edit_strength = 编辑强度
exposure_mask.edit_strength.tip = 在阈值判定之前缩放测得的模型输入与输出差异。
exposure_mask.enabled = 启用
exposure_mask.enabled.tip = 本通道在模型评估之后构建自己的曝光遮罩。该遮罩只影响本通道下一帧的 HDR 测光。
exposure_mask.luma_relative = 相对亮度
exposure_mask.luma_relative.tip = 相对于较亮一侧输入或输出亮度的最小亮度差异。
exposure_mask.luma_threshold = 亮度阈值
exposure_mask.luma_threshold.tip = 标记模型编辑所需的最小绝对亮度差异。
exposure_mask.response = 时域响应
exposure_mask.response.tip = 将新的遮罩投票与上一帧的遮罩混合。
exposure_mask.smoothing = 空间平滑
exposure_mask.smoothing.tip = 在小邻域内对二值曝光投票做多数滤波。
exposure_mask.title = 曝光遮罩

# grade
grade.black_level = 黑场
grade.black_level.tip = 映射为黑色的 OKLab 亮度值。正值只压暗最深的阴影；负值抬升暗部。
grade.brightness = 亮度
grade.brightness.tip = 在曝光模式下，数值以档为单位（-1 使线性光减半；+1 使其加倍）。其他模式使用各自的亮度曲线。
grade.brightness_mode = 亮度模式
grade.brightness_mode.tip = 亮度使用哪种算法。这些是互斥的替代方案，而非叠加层。
grade.cas = CAS 锐化
grade.cas.tip = 对调色结果启用 AMD FidelityFX 对比度自适应锐化。仅在线性 SDR 下作为独立调度运行；HDR 格式会跳过。
grade.cas_strength = CAS 强度
grade.cas_strength.tip = AMD FidelityFX CAS 的锐化量。0 表示不锐化，1 表示最大锐化。
grade.chroma_mode = 色度模式
grade.chroma_mode.saturation = 饱和度
grade.chroma_mode.saturation.tip = 以相同倍率缩放 OKLab 色度，同时保持感知色相。
grade.chroma_mode.tip = 饱和度使用哪种算法。这些是互斥的替代方案，而非叠加层。
grade.chroma_mode.vibrance = 自然饱和度
grade.chroma_mode.vibrance.tip = 在 OKLab 中更强烈地提升低饱和颜色，并随着色度升高而减弱效果。
grade.contrast = 对比度
grade.contrast.tip = 围绕中间亮度的一条带枢轴的 S 形曲线。正值提高对比度，负值降低对比度，同时保持黑白锚定。
grade.edge_softening = 边缘感知柔化
grade.edge_softening.tip = 将联合双边 3x3 邻域混入调色输入。亮度相近程度会减少强边缘处的模糊。
grade.highlights = 高光
grade.highlights.tip = 用一条在接近黑色前淡出的平滑曲线调整高光。
grade.luma_mode.exposure = 曝光
grade.luma_mode.exposure.tip = 将线性光 RGB 乘以 2^数值（档）；结果超出输出范围时通过色域映射保护颜色。
grade.luma_mode.gain = 增益
grade.luma_mode.gain.tip = 用有界的乘法曲线缩放 OKLab 亮度。
grade.luma_mode.gamma = 伽马
grade.luma_mode.gamma.tip = 对 OKLab 亮度施加带符号的幂曲线。中性黑与中性白保持锚定，效果集中在中间调。
grade.luma_mode.soft = 柔和
grade.luma_mode.soft.tip = 一种平滑的亮度调整，在接近黑与白时衰减为零。
grade.saturation = 饱和度
grade.saturation.tip = 调整 OKLab 中的感知色度。超出色域的颜色会向中性轴压缩，以避免通道截断产生的伪影。
grade.shadows = 阴影
grade.shadows.tip = 用一条在接近白色前淡出的平滑曲线调整阴影。
grade.softening_strength = 柔化强度
grade.softening_strength.tip = 边缘感知 3x3 柔化的量。
grade.white_level = 白场
grade.white_level.tip = 映射为白色的 OKLab 亮度值。提高该点会使画面变暗；超出色域的颜色会被压缩而不是逐通道截断。

# grade_backbuffer
grade_backbuffer.enabled = 启用
grade_backbuffer.enabled.tip = 在所有通道之后、呈现之前立即对最终交换链图像调色。这与各通道的模型输入、模型输出调色互相独立。
grade_backbuffer.title = 后备缓冲调色

# hdr
hdr.adaptive.enabled = 自适应曝光
hdr.adaptive.enabled.tip = 关闭游戏曝光时，由直方图测量提供全局曝光。开启游戏曝光时，把“相对游戏强度的强度”作为有界修正应用（为 0 时无效）。在第一次测量到达之前不起作用。
hdr.adaptive.max_correction = 最大修正档数
hdr.adaptive.max_correction.tip = 两层都启用时，围绕游戏曝光允许的最大调整量。
hdr.adaptive.midtone = 中间调目标
hdr.adaptive.midtone.tip = 所选样本群体的目标亮度。
hdr.adaptive.speed_down = 变暗速度
hdr.adaptive.speed_down.tip = 每秒最大曝光降低量，单位为档。
hdr.adaptive.speed_up = 变亮速度
hdr.adaptive.speed_up.tip = 每秒最大曝光提升量，单位为档。
hdr.adaptive.strength_over_game = 相对游戏强度的强度
hdr.adaptive.strength_over_game.tip = 游戏曝光启用时，叠加自适应目标档位修正的这一比例。关闭游戏曝光时，自适应曝光即为基准曝光。
hdr.bt2446_ip = BT.2446C 拐点
hdr.bt2446_ip.tip = BT.2446C 曲线域中的膝点位置。高于该点的内容做对数压缩，低于该点的内容保持线性。滑块覆盖了真实 HDR 内容的常用范围。范围之外的值仍可手动输入：10000 表示禁用压缩。
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = 线性段斜率：拐点以下的内容满足 Y_SDR = k1 * Y_HDR。这也是对数段在膝点处所匹配的斜率。
hdr.bt2446_k2 = BT.2446C k2（推导）
hdr.bt2446_k2.tip = BT.2446C 曲线的对数段斜率。由 k1、k3 和拐点推导，使对数段在膝点处与线性段斜率一致。
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = 肩部压缩强度。数值越大，对数段被压得越低，高光越暗。k2 与 k4 由此推导，以保证曲线在膝点处平滑。
hdr.bt2446_k4 = BT.2446C k4（推导）
hdr.bt2446_k4.tip = BT.2446C 曲线的对数段截距。由 k1、k3 和拐点推导，使对数段在膝点处与线性段的取值一致。
hdr.cat.advanced = 高级
hdr.cat.diagnostics = 诊断
hdr.cat.filters = 滤镜
hdr.common.available = 可用
hdr.common.no = 否
hdr.common.not_seen = 未检测到
hdr.common.pending = 待定
hdr.common.ready = 就绪
hdr.common.unavailable = 不可用
hdr.common.valid = 有效
hdr.common.yes = 是
hdr.crosstalk = 串扰
hdr.crosstalk.tip = BT.2446C 的预去饱和量。
hdr.density.full = 全部
hdr.density.full.tip = 对每个像素采样。全密度直方图，精度最高。
hdr.density.quarter = 1/4
hdr.density.quarter.tip = 每个轴每 2 个像素采样一次（画面的 1/4）。细小的孤立高光可能被漏掉。
hdr.density.sixteenth = 1/16
hdr.density.sixteenth.tip = 每个轴每 4 个像素采样一次（画面的 1/16）。孤立高光和精细细节可能被漏掉。
hdr.density.sixty_fourth = 1/64
hdr.density.sixty_fourth.tip = 每个轴每 8 个像素采样一次（画面的 1/64）。仅适合内容大致均匀的场景。
hdr.detailed_statistics = 详细 HDR 统计
hdr.detailed_statistics.tip = 收集全画面的增益图范围与越界统计。启用后增加两次 GPU 调度。
hdr.diag.adaptive_scene_white =   自适应场景白点：%.4f
hdr.diag.async_note = 数值异步更新。曝光与直方图反映 GPU 最近一次写完的测量结果。
hdr.diag.exposure = 曝光：%.4f
hdr.diag.format = 格式：%s - 已解析=%s
hdr.diag.gain_excursions =   SDR 越界：%u
hdr.diag.gain_map = 增益图：%s
hdr.diag.gain_out_of_range =   超出范围：%u
hdr.diag.gain_range =   范围（log2）：%.3f .. %.3f
hdr.diag.game_exposure = 游戏曝光：%s
hdr.diag.game_texture =   纹理：%ux%u fmt=%d
hdr.diag.game_value =   数值：%.4f
hdr.diag.guides = DLSS 引导数据：%s
hdr.diag.histogram = 直方图（log2 亮度）
hdr.diag.histogram.tip = 测得的 log2 亮度直方图。样本群体取决于当前启用的曝光滤镜。
hdr.diag.histogram_missing = 直方图：尚未就绪
hdr.diag.metering_source = 测光来源：%s
hdr.diag.post_blocked = Post-DLSS 已阻断：%s
hdr.diag.reference_luma =   参考亮度：%.4f
hdr.diag.samples = 样本数：%u - 距上次测量帧数：%u
hdr.diag.scene_white = 场景白点：%.4f
hdr.diag.warming =   正在预热 - 尚无曝光测量。
hdr.enabled = 启用
hdr.enabled.tip = 在本通道之前立即对 HDR 图像测光。除非启用测光复用，后续通道测量的是上一通道合成后的图像。后备缓冲通道使用 SDR 合成。
hdr.format = 格式
hdr.format.auto = 自动
hdr.format.auto.tip = 从当前生效的 Pre/Post-DLSS 源自动识别格式。
hdr.format.hdr10 = HDR10
hdr.format.hdr10.tip = 将源视为 HDR10 PQ（ST.2084）。
hdr.format.scrgb = scRGB
hdr.format.scrgb.tip = 将源视为线性 scRGB（1.0 = 80 尼特）。
hdr.format.sdr = SDR
hdr.format.sdr.tip = 将源视为 SDR sRGB。
hdr.format.tip = 源图像的编码方式。“自动”会从 DLSS 输出的 DXGI 格式识别。
hdr.gain_max = 增益上限
hdr.gain_max.tip = 载波到 HDR 的预期最大增益，单位为 log2 档。仅用于诊断性增益图统计和调试视图；不影响合成。
hdr.gain_min = 增益下限
hdr.gain_min.tip = 载波到 HDR 的预期最小增益，单位为 log2 档。仅用于诊断性增益图统计和调试视图；不影响合成。
hdr.game.bias = 曝光偏移
hdr.game.bias.tip = 相对于游戏曝光的偏移量，单位为档。为 0 时保持游戏原值不变。
hdr.game.enabled = 游戏曝光
hdr.game.enabled.tip = 使用游戏的 NGX ExposureTexture 作为基准曝光。如果游戏没有提供，该层会跳过，改由自适应曝光提供基准。
hdr.highlight_headroom = 高光余量
hdr.highlight_headroom.tip = 缩放 BT.2446C 使用的有效 HDR 峰值。这不会改变曝光的解读方式。
hdr.layer.adaptive = 自适应曝光
hdr.layer.adaptive.tip = 基于直方图的全局曝光，或在游戏曝光之上的有界修正。
hdr.layer.game = 游戏曝光
hdr.layer.game.tip = 将游戏的曝光配置为基准层。
hdr.layers.stack_order = 叠加顺序：游戏曝光为基准，然后是自适应修正。局部曝光是独立分区，在两者之后应用。
hdr.measure_interval = 测量间隔
hdr.measure_interval.tip = 曝光直方图的测量频率，单位为帧。
hdr.metering_density = 测光密度
hdr.metering_density.tip = HDR 直方图采样的像素数量。全密度覆盖每个像素；更粗的密度采样更少像素，GPU 开销更低。
hdr.reuse_previous_pass = 复用上一 HDR 通道的测光
hdr.reuse_previous_pass.tip = 对于同一 Pre-DLSS 或 Post-DLSS 链中的后续通道，复用上一通道的 HDR 测量结果，而不是再调度一次直方图。第一个通道仍会测量游戏的源图像。
hdr.source.filtered = 过滤后的群体
hdr.source.full_frame = 全画面
hdr.source.game_exposure = 游戏曝光（NGX）
hdr.source.unknown = 未知
hdr.title = HDR

# hdr_filters
hdr_filters.depth = 深度
hdr_filters.depth.tip = 将该层限制在选定的归一化深度区间内。
hdr_filters.depth_far = 深度远端
hdr_filters.depth_far.tip = 可接受归一化深度区间的远端。
hdr_filters.depth_near = 深度近端
hdr_filters.depth_near.tip = 可接受归一化深度区间的近端。
hdr_filters.exposure_mask = 曝光遮罩
hdr_filters.exposure_mask.tip = 只对按持久曝光遮罩加权的像素测光或修正。
hdr_filters.percentile_high = 高百分位
hdr_filters.percentile_high.tip = 该层的百分位上限。
hdr_filters.percentile_low = 低百分位
hdr_filters.percentile_low.tip = 百分位下限。游戏/自适应层用该区间测光；局部层将其作为亮度保护区间。
hdr_filters.percentile_range = 百分位区间
hdr_filters.percentile_range.tip = 对游戏/自适应层，选取该层直方图的一个百分位区间。对局部曝光，在测得的亮度区间之外淡出局部修正。

# local_exposure
local_exposure.bright_detail_protection = 亮部细节保护
local_exposure.bright_detail_protection.tip = 控制暗邻域是否可以把像素抬到枢轴之上。1 保持亮点锚定；0 允许跨枢轴修正。
local_exposure.cat.advanced = 高级
local_exposure.dark_detail_protection = 暗部细节保护
local_exposure.dark_detail_protection.tip = 控制亮邻域是否可以把像素压到枢轴之下。1 保持暗部细节锚定；0 允许跨枢轴修正。
local_exposure.detail_retention = 细节保留
local_exposure.detail_retention.tip = 保留像素相对于其局部基准的 log 亮度细节。1 保留全部相对细节；更低的值会压缩它。
local_exposure.edge_protection = 边缘保护
local_exposure.edge_protection.tip = 减弱跨强 log 亮度边缘的样本影响。0 只使用空间权重；更高的值减少光晕，但会让适应更局部化。
local_exposure.enabled = 局部曝光
local_exposure.enabled.tip = 以显示参考的中间调为枢轴，施加随空间变化的曝光修正。适用于任何来源：HDR 路径通过其色调曲线到达枢轴，显示参考路径则直接从图像读取。
local_exposure.highlight_reduction = 高光压低
local_exposure.highlight_reduction.tip = 高光压低的独立倍率。设为 0 可在仍然提亮阴影的同时保持亮部不动。
local_exposure.highlight_transition = 高光过渡
local_exposure.highlight_transition.tip = 中间调枢轴之上、高光压低逐渐升到全强度的档数范围。更小的值作用更激进。
local_exposure.max_brighten = 最大提亮
local_exposure.max_brighten.tip = 阴影提升的最大档数。在亮部细节保护拉满时，即使邻域很暗，高于中间调枢轴的像素也不会被提升。
local_exposure.max_darken = 最大压暗
local_exposure.max_darken.tip = 高光压低的最大档数。在暗部细节保护拉满时，即使邻域很亮，低于枢轴的像素也不会被压暗。
local_exposure.midtone = 局部中间调
local_exposure.midtone.tip = 模型 SDR 域中的目标亮度枢轴。接近该枢轴的像素几乎不被修正；阴影向上、高光向下朝它靠拢。
local_exposure.radius = 局部半径
local_exposure.radius.tip = 以源像素为单位的半径。半径为 1 会关闭多点邻域采样，只使用中心像素。更大的半径响应更宽的明暗区域，而不是单个像素噪声。
local_exposure.restore = 还原模型曝光
local_exposure.restore.tip = 在评估之后对模型输出施加修正。禁用时，模型重建出的局部明暗保持不变。
local_exposure.restore_scale = 还原空间尺度
local_exposure.restore_scale.tip = 控制曝光还原的空间尺度：0 = 逐像素精确抵消局部提升，1 = 统一的全局修正，两者之间在对数空间混合。全局还原能保留更多模型重建出的亮度关系。
local_exposure.restore_strength = 还原强度
local_exposure.restore_strength.tip = 曝光还原量：0 = 不修正，1 = 完全修正。中间值在对数曝光空间中混合所选的还原方式。
local_exposure.samples = 邻域采样数
local_exposure.samples.tip = 局部 log 亮度估计中请求的空间采样次数。实际数量会按 4 的倍数取整，以保持采样在空间上均衡。
local_exposure.shadow_lift = 阴影提升
local_exposure.shadow_lift.tip = 阴影提升的独立倍率。设为 0 可在仍然压低高光的同时保持暗部不动。
local_exposure.shadow_transition = 阴影过渡
local_exposure.shadow_transition.tip = 中间调枢轴之下、阴影提升逐渐升到全强度的档数范围。更小的值对暗部作用更激进。
local_exposure.strength = 强度
local_exposure.strength.tip = 局部曝光修正的总体幅度。
local_exposure.title = 局部曝光

# pass
pass.auto_mask = 自动遮罩
pass.auto_mask.tip = 让模型识别角色皮肤并对它单独应用编辑。
pass.cat.model = 模型
pass.cat.residual_edits = 残差编辑
pass.cat.strength = 强度
pass.cat.temporal = 时域重投影
pass.cheap_preset.auto = 自动
pass.cheap_preset.auto.tip = 使用本通道自己的渲染预设。一个 NGX 特性同时服务两个模型。
pass.cheap_preset.performance = 性能
pass.cheap_preset.performance.tip = 用提示 2 创建轻量模型的特性。
pass.cheap_preset.quality = 质量
pass.cheap_preset.quality.tip = 用提示 1 创建轻量模型的特性。
pass.chroma_strength = 色度强度
pass.chroma_strength.tip = 在原始色度与编辑后色度之间混合。
pass.correct_motion = 校正运动矢量
pass.correct_motion.tip = 生成本通道可以信赖的运动场。一帧中第一个 Pre/Post-DLSS 通道会原样保留游戏的矢量，因为它处理的正是这些矢量为对应图像。其后的每个通道以及每个后备缓冲通道都会得到校正后的场：搜索被限制在游戏矢量周围几个像素内，并偏向上一帧的场。若没有游戏矢量，通道会改从颜色和深度合成。它同时供模型和时域重投影使用；每个通道多一次 GPU 调度，且需要可用的深度引导数据。
pass.edit_strength = 编辑强度
pass.edit_strength.tip = 在把模型的编辑叠加到源图像之前缩放它。
pass.enabled = 启用
pass.enabled.tip = 启用或禁用此通道配置。被禁用的通道不会评估模型。
pass.grade_input.apply_to_pre_grade = 将编辑应用于调色前图像
pass.grade_input.apply_to_pre_grade.tip = 在调色之前把模型的编辑应用到图像上，使调色不会进入输出。关闭时，按原样使用调色后的模型输出。
pass.grade_input.enabled = 模型输入调色
pass.grade_input.enabled.tip = 在模型评估之前，对模型读取的图像调色。
pass.grade_input.title = 模型输入调色
pass.grade_output.enabled = 模型输出调色
pass.grade_output.enabled.tip = 在模型输出发布之前对它调色。
pass.grade_output.title = 模型输出调色
pass.intensity = 强度
pass.intensity.tip = 模型被要求编辑图像的强度。\n0 会完全跳过模型评估
pass.local_structure = 局部结构
pass.local_structure.tip = 应用模型局部结构细节的多少。
pass.local_tone = 局部色调
pass.local_tone.tip = 应用模型局部色调调整的多少。
pass.luma_strength = 亮度强度
pass.luma_strength.tip = 在原始亮度与编辑后亮度之间混合。
pass.menu.copy_from_next = 从下一个通道复制
pass.menu.copy_from_previous = 从上一个通道复制
pass.name = 名称
pass.name.tip = 显示在该通道标签页上的名称。留空则显示按位置生成的默认名“通道 N”。
pass.order = 通道顺序
pass.preset = 预设
pass.preset.a = A
pass.preset.a.tip = 使用模型预设 A。改动在每次评估时应用，并重置模型的内部历史，无需重建特性。
pass.preset.b = B
pass.preset.b.tip = 使用模型预设 B。改动在每次评估时应用，并重置模型的内部历史，无需重建特性。
pass.preset.c = C
pass.preset.c.tip = 使用模型预设 C。改动在每次评估时应用，并重置模型的内部历史，无需重建特性。
pass.preset.tip = 为本通道选择模型质量或行为预设。
pass.ratio_brighten = 比值提亮
pass.ratio_brighten.tip = 启用“比值钳制”时，逐通道残差比值的上限。对 SDR 与 HDR 合成均生效。
pass.ratio_clamps = 比值钳制
pass.ratio_clamps.tip = 在塑形之前，把逐通道模型残差对数比值限制在[比值压暗, 比值提亮]区间内。对 SDR 与 HDR 合成均生效。
pass.ratio_darken = 比值压暗
pass.ratio_darken.tip = 启用“比值钳制”时，逐通道残差比值的下限。对 SDR 与 HDR 合成均生效。
pass.ratio_eps = 比值下限
pass.ratio_eps.tip = 逐通道残差对数比值的分母下限。当某个通道接近零时保持残差有限。对 SDR 与 HDR 合成均生效。
pass.render_preset = 渲染预设
pass.render_preset.performance = 性能
pass.render_preset.performance.tip = 提示 2：面向性能的预设。
pass.render_preset.quality = 质量
pass.render_preset.quality.tip = 提示 1：面向质量的预设。
pass.render_preset.tip = 本通道的 DLSSNR.Hint.Render.Preset 提示。NGX 在创建特性时锁定它，因此改动会重建本通道的特性。
pass.residual_chroma = 色度强度
pass.residual_chroma.tip = 编辑的色度相对于其亮度落地的比例。
pass.residual_gamma = 编辑伽马
pass.residual_gamma.tip = 塑造编辑的响应曲线。
pass.residual_highlight = 高光保护
pass.residual_highlight.tip = 在中高亮度以上淡出编辑。
pass.residual_shadow = 阴影保护
pass.residual_shadow.tip = 在中低亮度以下淡出编辑。
pass.skin_structure = 皮肤结构
pass.skin_structure.tip = 控制模型应用其皮肤专属编辑的强度。模型的自动遮罩选项关闭时禁用。
pass.target = 目标
pass.target.backbuffer = 后备缓冲
pass.target.backbuffer.tip = 在 ReShade 呈现时对最终交换链后备缓冲运行。即使游戏不使用 DLSS 也能工作；除非 Pre/Post-DLSS 阶段可用，否则它不与这些通道一起排序。
pass.target.post_dlss = DLSS 后
pass.target.post_dlss.tip = 在游戏 DLSS 评估之后、后续后处理和 UI 之前，对其放大后的输出运行。
pass.target.pre_dlss = DLSS 前
pass.target.pre_dlss.tip = 在游戏 DLSS 评估之前，对其输入的 Color 资源运行。游戏随后会放大修改后的图像。需要全资源范围的 Color 输入。
pass.target.tip = 每个通道可以独立选择 DLSS 前、DLSS 后或后备缓冲。执行顺序按阶段分组；同一阶段内的通道遵循标签页顺序。更改目标会在下次评估时重置模型的内部历史。
pass.temporal.adaptive = 自适应
pass.temporal.adaptive.tip = 在逐像素置信度允许的范围内复用重投影的编辑，并强制至少每 N 帧刷新一次，其中 N 是“周期”滑块。当无效像素比例较高时，实际周期减半。
pass.temporal.cadence = 周期
pass.temporal.cadence.tip = 两次模型评估之间的帧数。在自适应模式下这是上限；当无效像素比例较高时实际周期减半。在固定模式下这就是精确周期。
pass.temporal.cheap = 轻量模型
pass.temporal.cheap.tip = 在两次完整评估之间的帧上运行第二个更轻量的模型，并在重投影置信度低的位置采用它的编辑。关闭时，这些帧仅由历史重建，不产生额外开销，但遮挡显露和快速运动要等到下一次完整评估才能解决。
pass.temporal.cheap_preset = 轻量模型预设
pass.temporal.cheap_preset.tip = 轻量模型自身特性的渲染预设。“自动”跟随本通道的预设，无需第二个特性；其他选项会创建一个，因为 NGX 在创建时锁定提示。
pass.temporal.cheap_scale = 轻量模型倍率
pass.temporal.cheap_scale.tip = 更轻量模型的分辨率，占工作倍率的比例。0.5 表示工作倍率分辨率的 50%。更低的值更快，但低置信度重投影区域的细节更少。
pass.temporal.depth_abs = 深度绝对差
pass.temporal.depth_abs.tip = 运动重投影之后允许的绝对深度差异。
pass.temporal.depth_rel = 深度相对差
pass.temporal.depth_rel.tip = 相对深度差容许量。阈值取该容许量与“深度绝对差”中较大者。
pass.temporal.fixed = 固定
pass.temporal.fixed.tip = 在两次模型评估之间按固定帧数复用重投影的编辑，不考虑置信度。“周期”滑块就是精确周期。
pass.temporal.fp16_history = FP16 编辑历史
pass.temporal.fp16_history.tip = 用 FP16 存储时域编辑与候选纹理。降低历史带宽和内存占用，代价是复用的编辑出现少量量化差异。
pass.temporal.max_invalid = 最大无效 %
pass.temporal.max_invalid.tip = 刷新模型之前允许的无效或光度不匹配像素比例上限。
pass.temporal.max_motion = 最大运动
pass.temporal.max_motion.tip = 当运动超过这么多工作分辨率像素时拒绝重投影。
pass.temporal.mode = 模式
pass.temporal.mode.tip = 复用经运动重投影的乘性模型编辑，而不是每帧评估模型。需要当前帧的深度和运动场——游戏提供的，或由“校正运动矢量”生成的；历史不确定时会强制重新评估。
pass.temporal.off = 关闭
pass.temporal.off.tip = 每帧都评估神经网络模型。
pass.temporal.photo_abs = 光度绝对差
pass.temporal.photo_abs.tip = 当前像素与其运动重投影得到的上一帧匹配之间，允许的模型输入亮度绝对差异。
pass.temporal.photo_rel = 光度相对差
pass.temporal.photo_rel.tip = 相对亮度差容许量，按当前或上一帧亮度中较大者缩放。与“光度绝对差”相加。
pass.ui_correction = UI 校正
pass.ui_correction.tip = 在检测到 UI 元素的位置减弱模型的编辑。
pass.upsample_sharpness = 上采样锐度
pass.upsample_sharpness.tip = 模型输入与输出固定的联合双边 3x3 重建的边缘保留指数。更高的值更锐利地跟随全分辨率引导边缘；更低的值在低分辨率邻域内更平滑地混合。这不会缩放模型编辑。
pass.working_scale = 工作倍率
pass.working_scale.reset_tip = 将工作倍率与 x2 恢复为默认值。
pass.working_scale.slider_tip = 模型的工作分辨率，占画面的比例。\n\n过低的值会被提升到垂直分辨率至少 180p，以保证时域重投影总有可用的历史。更改此值会在下次评估时重置模型的内部历史。
pass.working_scale.tip = 模型运行的分辨率，占画面的比例。勾选 x2 可加倍以进行超采样。合成与后备缓冲仍保持画面分辨率。
pass.working_scale.x2_off_tip = 当前正以两倍工作分辨率进行超采样。取消勾选可回到滑块的值。更改此设置会在下次评估时重置模型的内部历史。\n\n取消勾选后的第一帧也可能短暂卡顿，因为要分配更小的资源并让之前的资源在 GPU 上退役。
pass.working_scale.x2_on_tip = 将模型的工作分辨率加倍以进行超采样。这会在下次评估时重置模型的内部历史。\n\n警告：启用后，切换后的第一帧可能出现短暂卡顿，因为要分配更大的工作倍率资源（工作输入/输出、时域历史、未提升的参考）并让之前正在使用的缓冲在 GPU 上退役。\n\n其他风险：\n  - 工作倍率资源的显存占用大约变为四倍。\n  - 2x 时模型评估与合成更慢。\n  - 复用时使用的轻量模型会随工作倍率增大，因此复用帧也更昂贵。\n  - 若卡顿超过一两秒，通常意味着设备显存耗尽；关闭此选项即可恢复。

# prefs
prefs.clone_resources = 复制游戏资源
prefs.clone_resources.tip = 关闭（默认）：直接读取游戏当前的深度/运动资源和 DLSS 输出。开启：把当前帧的深度/运动，以及启用 Post-DLSS 时的 DLSS 输出，复制到插件自有的纹理中。这一个选项对所有阶段生效，包括后备缓冲；所请求的模式会在新的 DLSS 评估时安全锁定。
prefs.fp16_storage = FP16 管线
prefs.fp16_storage.tip = 用 RGBA16F 而不是 RGBA32F 存储 HDR 增益图载波、模型工作纹理和未提升的合成参考。带宽和占用减半，代价是载波到 HDR 倍率与模型域增量出现量化。SDR 路径不受影响。切换会重置时域历史并重建 NGX 特性。
prefs.invert_fallback_depth = 反转回退深度
prefs.invert_fallback_depth.tip = 当 DLSS 评估未提供深度资源而改用 ReShade Generic Depth 数值时，将其反转。不会改变 DLSS 提供的深度。
prefs.language = 语言
prefs.language.auto = 自动（跟随 ReShade）
prefs.language.tip = 界面语言。自动选项跟随 ReShade 的语言设置。
prefs.show_tooltips = 显示提示
prefs.show_tooltips.tip = 悬停在控件和分区标题上时显示说明。
prefs.title = 首选项

# status
status.block.hooks_missing = Post-DLSS 已禁用：D3D12 命令列表钩子未安装
status.block.ray_reconstruction = 光线重建：游戏向 DLSS 提供的是一块更大分配的子区域，因此 Pre-DLSS 无法安全地改写其 Color。请改用 Post-DLSS。

