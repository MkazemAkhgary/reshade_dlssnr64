ui.profiles.load = 加载
ui.profiles.load.tip = 将此预设加载到当前设置，并保存为当前的 ReShade.ini 配置。
ui.profiles.name_error = 预设名称为空、过长或已被使用。
ui.profiles.none = 没有已保存的预设。
ui.profiles.remove = x
ui.profiles.remove.tip = 确认后移除此预设。
ui.profiles.rename = 重命名
ui.profiles.rename.button_tip = 编辑此预设的名称。回车保存；Esc 取消。
ui.profiles.rename.tip = 回车保存名称；Esc 取消编辑。
ui.profiles.save = 保存
ui.profiles.save.tip = 用当前设置覆盖此已保存的预设。
ui.profiles.save_as_new = 保存为新预设
ui.profiles.save_as_new.tip = 以新名称保存当前所有 DLSSNR 设置。ReShade.ini 中最多可保存 %u 个预设。
ui.profiles.save_name = 保存名称
ui.profiles.tip = 在 ReShade.ini 中保存和恢复当前 DLSSNR 设置的命名配置。
ui.profiles.unnamed = （未命名预设）
ui.resources = GPU 资源
ui.resources.buffer = 缓冲
