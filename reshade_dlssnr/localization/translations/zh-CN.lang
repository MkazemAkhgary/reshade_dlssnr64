# language: zh-CN
# name: 简体中文
#
# Values are C string escapes: \n is a line break, \" a quote.
# An empty value means the English text is used.

# ctl
ctl.category.toggle = 展开或折叠 %s 子分区。
ctl.menu.copy = 复制
ctl.menu.paste = 粘贴
ctl.reset.default.tip = 重置为声明的默认值。
ctl.section.toggle = 启用或禁用 %s。

# debug
debug.title = 调试
debug.view = 调试视图
debug.view.depth = 深度
debug.view.depth.tip = 游戏提供给 DLSS 的深度缓冲区。以灰度显示。
debug.view.exposure_mask = 曝光遮罩
debug.view.exposure_mask.tip = 当前帧的遮罩，来自实际模型输入（包括输入分级和局部曝光）与原始模型输出对比。该遮罩发布供下一帧的曝光使用。
debug.view.gain_map = 增益图
debug.view.gain_map.tip = 原始 f32 载体到 HDR 重建倍率，以 log2 档位显示，从 -4（黑）到 +6（白）。
debug.view.game_exposure = 游戏曝光
debug.view.game_exposure.tip = 游戏 NGX 曝光以档位表示：1.0x（0 档）为中灰；更亮/更暗的值趋向白/黑。品红色表示未读取到有效值。
debug.view.hdr_local_exposure = HDR 局部曝光
debug.view.hdr_local_exposure.tip = 局部曝光系数以档位表示，映射为 0 档为中灰，-2 档为黑，+2 档为白。
debug.view.hdr_roundtrip_diagnostic = HDR 往返诊断
debug.view.hdr_roundtrip_diagnostic.tip = 2x2 对比：实际准备的模型输入 | 模型输出 / 合成 HDR 映射回未分级的模型域 | 相对未分级模型输出的合成差异。由于保留了全分辨率源细节，出现非零边缘是预期的；工作分辨率会影响此对比。使用 HDR 往返误差进行独立的载体重建检查。
debug.view.hdr_roundtrip_error = HDR 往返误差
debug.view.hdr_roundtrip_error.tip = 原始解码 HDR 源与从 RGBA32F 载体及载体到 HDR 倍率直接 float32 重建之间的伪彩色相对误差。这仅验证载体传输，而非模型编辑或最终合成；与工作分辨率和输入分级无关。
debug.view.hint = 该视图由下方标签页中当前选中的通道渲染，且只在该通道启用时生效。
debug.view.model_input_pre_grade = 模型输入（分级前）
debug.view.model_input_pre_grade.tip = 模型输入颜色，正是输入分级运行前的状态。分级在原位应用，因此选择该视图时管线会为你快照此纹理；启用输入分级时，可将其与模型输入（已准备）对比。
debug.view.model_input_prepared = 模型输入（已准备）
debug.view.model_input_prepared.tip = 真正送入模型的图像，已缩放到工作分辨率，完成 HDR 准备，并在启用时应用输入分级。
debug.view.model_input_source = 模型输入（源）
debug.view.model_input_source.tip = 捕获时的帧，未经任何处理。这是模型将处理的 DLSS 输出，以其原生分辨率呈现。
debug.view.model_output_composed = 模型输出（已合成）
debug.view.model_output_composed.tip = 此通道的最终结果，模型编辑已与源合成。这就是写入目标的内容。
debug.view.model_output_post_grade = 模型输出（分级后）
debug.view.model_output_post_grade.tip = 输出分级运行后的模型输出，位于模型自身的 sRGB 编码 SDR 域——与模型输入的输入分级对称。下游的一切（合成、曝光遮罩、回写）都以此为准，如同模型本身产生。
debug.view.model_output_raw = 模型输出（原始）
debug.view.model_output_raw.tip = 模型输出，正是 NGX 产生时的状态，在输出分级应用之前。由于分级在原位运行，管线会对此快照；启用输出分级时，可将其与模型输出（分级后）对比。
debug.view.motion_vectors = 运动矢量
debug.view.motion_vectors.tip = 此通道用于评估的运动场：游戏的矢量，或“修正运动矢量”为其生成的场。显示为 R = x 方向，G = y 方向。
debug.view.off = 关闭
debug.view.off.tip = 禁用调试视图并显示正常的合成输出。
debug.view.sdr_base_pre_model = SDR 基底（模型前）
debug.view.sdr_base_pre_model.tip = 由 BT.2446C 拆分生成的全分辨率线性 SDR 载体。这是模型下采样所用的 RGB 载荷。
debug.view.temporal_candidate_status = 时域候选状态
debug.view.temporal_candidate_status.tip = 深度验证前的重投影置信度，以灰度显示（白=完全信任，黑=拒绝）。置信度结合了局部编辑钳制一致性、光度一致性和上一帧置信度。在上一帧编辑可以被重投影之前不可用。
debug.view.temporal_reprojected_edit = 时域重投影编辑
debug.view.temporal_reprojected_edit.tip = 来自上一帧的已验证逐通道对数增益，映射为中性增益为灰，更强的正/负编辑趋向白/黑。被拒绝的像素为暗。
debug.view.temporal_validation_status = 时域验证状态
debug.view.temporal_validation_status.tip = 深度验证后的置信度，以灰度显示。置信度缩放所应用的编辑权重；低值使编辑向输入淡出。
debug.view.tip = 用内部缓冲替换最终图像，以便检查管线。

# exposure_mask
exposure_mask.chroma_threshold = 色度阈值
exposure_mask.chroma_threshold.tip = 标记模型编辑所需的最小纯色度差异。
exposure_mask.edit_strength = 编辑强度
exposure_mask.edit_strength.tip = 在阈值化之前缩放测量到的模型输入/输出差异。
exposure_mask.enabled = 启用
exposure_mask.enabled.tip = 此通道在模型评估后构建其曝光遮罩。该遮罩仅影响此通道下一帧的 HDR 测光。
exposure_mask.luma_relative = 相对亮度
exposure_mask.luma_relative.tip = 相对于较亮输入/输出亮度的最小亮度差异。
exposure_mask.luma_threshold = 亮度阈值
exposure_mask.luma_threshold.tip = 标记模型编辑所需的最小绝对亮度差异。
exposure_mask.response = 时域响应
exposure_mask.response.tip = 将新的遮罩投票与上一帧的遮罩混合。
exposure_mask.smoothing = 空间平滑
exposure_mask.smoothing.tip = 在小邻域内对二值曝光投票进行多数滤波。
exposure_mask.title = 曝光遮罩

# grade
grade.black_level = 黑位
grade.black_level.tip = 映射到黑色的 OKLab 亮度值。正值仅压暗最深的阴影；负值提升暗部。
grade.brightness = 亮度
grade.brightness.tip = 在曝光模式下，数值以档位表示（-1 使线性光减半；+1 使其加倍）。其他模式使用各自的亮度曲线。
grade.brightness_mode = 亮度模式
grade.brightness_mode.tip = 亮度所使用的算法。这些是替代方案，而非叠加层。
grade.cas = CAS 锐化
grade.cas.tip = 在分级结果上启用 AMD FidelityFX 对比度自适应锐化。仅在线性 SDR 中作为独立调度运行；HDR 格式时跳过。
grade.cas_strength = CAS 强度
grade.cas_strength.tip = AMD FidelityFX CAS 的锐化量。0 不应用锐化，1 应用最大锐化。
grade.chroma_mode = 色度模式
grade.chroma_mode.saturation = 饱和度
grade.chroma_mode.saturation.tip = 以相同系数缩放 OKLab 色度，同时保留感知色相。
grade.chroma_mode.tip = 饱和度所使用的算法。这些是替代方案，而非叠加层。
grade.chroma_mode.vibrance = 自然饱和度
grade.chroma_mode.vibrance.tip = 在 OKLab 中更强地增强低饱和颜色，并随色度升高减弱效果。
grade.contrast = 对比度
grade.contrast.tip = 围绕中间亮度的支点 S 曲线。正值增加对比度，负值降低对比度，同时保持黑和白锚定。
grade.edge_softening = 边缘感知柔化
grade.edge_softening.tip = 将联合双边 3x3 邻域混合到分级输入中。亮度相似性可减少跨强边缘的模糊。
grade.highlights = 高光
grade.highlights.tip = 用一条在黑色之前淡出的平滑曲线调整高光。
grade.luma_mode.exposure = 曝光
grade.luma_mode.exposure.tip = 将线性光 RGB 乘以 2^amount（档位）；当结果超出输出范围时，色域映射保护颜色。
grade.luma_mode.gain = 增益
grade.luma_mode.gain.tip = 通过有界的乘法曲线缩放 OKLab 亮度。
grade.luma_mode.gamma = 伽马
grade.luma_mode.gamma.tip = 对 OKLab 亮度应用带符号的幂曲线。中性黑和白保持锚定，将效果集中在中间调。
grade.luma_mode.soft = 柔和
grade.luma_mode.soft.tip = 在黑和白附近淡出为零的平滑亮度调整。
grade.saturation = 饱和度
grade.saturation.tip = 在 OKLab 中调整感知色度。超出色域的颜色被向中性轴压缩，以避免通道裁剪伪影。
grade.shadows = 阴影
grade.shadows.tip = 用一条在白之前淡出的平滑曲线调整阴影。
grade.softening_strength = 柔化强度
grade.softening_strength.tip = 边缘感知 3x3 柔化的量。
grade.white_level = 白位
grade.white_level.tip = 映射到白色的 OKLab 亮度值。提高该点会压暗图像；超出色域的颜色被压缩而非通道裁剪。

# grade_backbuffer
grade_backbuffer.enabled = 启用
grade_backbuffer.enabled.tip = 在每次通道之后、呈现之前对最终交换链图像进行分级。这与每个通道的模型输入和模型输出分级相互独立。
grade_backbuffer.title = 分级后缓冲

# hdr
hdr.adaptive.enabled = 自适应曝光
hdr.adaptive.enabled.tip = 游戏曝光关闭时，由直方图测量提供全局曝光。游戏曝光开启时，将“相对游戏强度”作为有界校正应用（在 0 时无效）。在首次测量到达之前无效。
hdr.adaptive.max_correction = 最大校正档位
hdr.adaptive.max_correction.tip = 两层都启用时，围绕游戏曝光的最大调整。
hdr.adaptive.midtone = 中间调目标
hdr.adaptive.midtone.tip = 所选群体的目标亮度。
hdr.adaptive.speed_down = 变暗速度
hdr.adaptive.speed_down.tip = 每秒曝光减少的最大档位数。
hdr.adaptive.speed_up = 变亮速度
hdr.adaptive.speed_up.tip = 每秒曝光增加的最大档位数。
hdr.adaptive.strength_over_game = 相对游戏强度
hdr.adaptive.strength_over_game.tip = 游戏曝光处于活动状态时，将自适应目标档位校正的一部分叠加到游戏曝光上。游戏曝光禁用时，自适应为基准曝光。
hdr.bt2446_ip = BT.2446C 拐点
hdr.bt2446_ip.tip = BT.2446C 曲线域中的拐点位置。高于此点的内容被对数压缩；低于此点的内容为线性。滑块覆盖真实 HDR 内容的有用范围。仍可键入其外的值：10000 表示禁用压缩。
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = 线性区域斜率：拐点以下的内容满足 Y_SDR = k1 * Y_HDR。也是对数分支在拐点处匹配的斜率。
hdr.bt2446_k2 = BT.2446C k2（派生）
hdr.bt2446_k2.tip = BT.2446C 曲线的对数区域斜率。由 k1、k3 和拐点派生，使对数分支在拐点处匹配线性分支的斜率。
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = 肩部压缩强度。值越大，对数分支压得更低，高光更暗。k2 和 k4 由此派生，使曲线在拐点处保持平滑。
hdr.bt2446_k4 = BT.2446C k4（派生）
hdr.bt2446_k4.tip = BT.2446C 曲线的对数区域截距。由 k1、k3 和拐点派生，使对数分支在拐点处匹配线性分支的值。
hdr.cat.advanced = 高级
hdr.cat.diagnostics = 诊断
hdr.cat.filters = 滤镜
hdr.common.available = 可用
hdr.common.no = 否
hdr.common.not_seen = 未见到
hdr.common.pending = 等待中
hdr.common.ready = 就绪
hdr.common.unavailable = 不可用
hdr.common.valid = 有效
hdr.common.yes = 是
hdr.crosstalk = 串扰
hdr.crosstalk.tip = BT.2446C 去饱和前量。
hdr.density.full = 全采样
hdr.density.full.tip = 对每个像素采样。全密度直方图，最高精度。
hdr.density.quarter = 1/4
hdr.density.quarter.tip = 每个轴每隔 1 个像素采样（帧的 1/4）。小的孤立高光可能被遗漏。
hdr.density.sixteenth = 1/16
hdr.density.sixteenth.tip = 每个轴每隔 3 个像素采样（帧的 1/16）。孤立高光和精细细节可能被遗漏。
hdr.density.sixty_fourth = 1/64
hdr.density.sixty_fourth.tip = 每个轴每隔 7 个像素采样（帧的 1/64）。仅适用于大致均匀的内容。
hdr.detailed_statistics = 详细 HDR 统计
hdr.detailed_statistics.tip = 收集全帧增益图范围和偏移统计。启用时增加两次 GPU 调度。
hdr.diag.adaptive_scene_white = 自适应场景白：%.4f
hdr.diag.async_note = 数值异步更新。曝光和直方图反映 GPU 已完成回写的最近一次测量。
hdr.diag.exposure = 曝光：%.4f
hdr.diag.format = 格式：%s - resolved=%s
hdr.diag.gain_excursions = SDR 偏移：%u
hdr.diag.gain_map = 增益图：%s
hdr.diag.gain_out_of_range = 超出范围：%u
hdr.diag.gain_range = 范围 (log2)：%.3f .. %.3f
hdr.diag.game_exposure = 游戏曝光：%s
hdr.diag.game_texture = 纹理：%ux%u fmt=%d
hdr.diag.game_value = 值：%.4f
hdr.diag.guides = DLSS 引导：%s
hdr.diag.histogram = 直方图（log2 亮度）
hdr.diag.histogram.tip = 测量到的 log2 亮度直方图。群体取决于活动曝光滤镜。
hdr.diag.histogram_missing = 直方图：未就绪
hdr.diag.metering_source = 测光来源：%s
hdr.diag.post_blocked = 后-DLSS 被阻止：%s
hdr.diag.reference_luma = 参考亮度：%.4f
hdr.diag.samples = 样本：%u - 距测量帧数：%u
hdr.diag.scene_white = 场景白：%.4f
hdr.diag.warming = 预热中 - 尚无曝光测量。
hdr.enabled = 启用
hdr.enabled.tip = 在此通道之前立即对 HDR 图像进行测光。除非启用了测光复用，否则后续通道测量由上一通道合成的图像。后缓冲通道使用 SDR 合成。
hdr.format = 格式
hdr.format.auto = 自动
hdr.format.auto.tip = 从活动的预/后-DLSS 源自动检测格式。
hdr.format.hdr10 = HDR10
hdr.format.hdr10.tip = 将源视为 HDR10 PQ（ST.2084）。
hdr.format.scrgb = scRGB
hdr.format.scrgb.tip = 将源视为线性 scRGB（1.0 = 80 nits）。
hdr.format.sdr = SDR
hdr.format.sdr.tip = 将源视为 SDR sRGB。
hdr.format.tip = 源图像的编码方式。自动从 DLSS 输出的 DXGI 格式检测。
hdr.gain_max = 增益上限
hdr.gain_max.tip = 载体到 HDR 增益的预期最大值，以 log2 档位表示。仅用于诊断增益图统计和调试视图；不影响合成。
hdr.gain_min = 增益下限
hdr.gain_min.tip = 载体到 HDR 增益的预期最小值，以 log2 档位表示。仅用于诊断增益图统计和调试视图；不影响合成。
hdr.game.bias = 曝光偏移
hdr.game.bias.tip = 相对于游戏曝光的手动偏移，以档位表示。零表示保持游戏的值不变。
hdr.game.enabled = 游戏曝光
hdr.game.enabled.tip = 使用游戏的 NGX ExposureTexture 作为基准曝光。如果游戏未提供，此层将回退，由自适应曝光提供基准。
hdr.highlight_headroom = 高光余量
hdr.highlight_headroom.tip = 缩放 BT.2446C 使用的有效 HDR 峰值。这不会改变曝光的解释方式。
hdr.layer.adaptive = 自适应曝光
hdr.layer.adaptive.tip = 基于直方图的全局曝光，或对游戏曝光的有界校正。
hdr.layer.game = 游戏曝光
hdr.layer.game.tip = 将游戏的曝光配置为基准层。
hdr.layers.stack_order = 堆叠顺序：游戏曝光为基准，然后是自适应校正。局部曝光为独立分区，在两者之后应用。
hdr.measure_interval = 测量间隔
hdr.measure_interval.tip = 曝光直方图的测量频率，以帧为单位。
hdr.metering_density = 测光密度
hdr.metering_density.tip = HDR 直方图采样的像素数量。全密度捕获每个像素；较粗的密度以更低的 GPU 成本采样更少像素。
hdr.reuse_previous_pass = 复用上一 HDR 通道测光
hdr.reuse_previous_pass.tip = 对于同一预/后-DLSS 链中的后续通道，复用上一通道的 HDR 测量，而非调度新的直方图。第一个通道仍测量游戏的源。
hdr.source.filtered = 过滤群体
hdr.source.full_frame = 全帧
hdr.source.game_exposure = 游戏曝光 (NGX)
hdr.source.unknown = 未知
hdr.title = HDR

# hdr_filters
hdr_filters.depth = 深度
hdr_filters.depth.tip = 将此层限制为选定的归一化深度区间。
hdr_filters.depth_far = 远深度
hdr_filters.depth_far.tip = 所接受归一化深度区间的远端。
hdr_filters.depth_near = 近深度
hdr_filters.depth_near.tip = 所接受归一化深度区间的近端。
hdr_filters.exposure_mask = 曝光遮罩
hdr_filters.exposure_mask.tip = 仅对由持久曝光遮罩加权的像素进行测光或校正。
hdr_filters.percentile_high = 高百分位
hdr_filters.percentile_high.tip = 此层的上百分位边界。
hdr_filters.percentile_low = 低百分位
hdr_filters.percentile_low.tip = 下百分位边界。游戏/自适应将该区间用于测光；局部曝光将其用作亮度保护带。
hdr_filters.percentile_range = 百分位范围
hdr_filters.percentile_range.tip = 对于游戏/自适应，选择该层直方图的百分位区间。对于局部曝光，在其测量亮度带之外淡出局部校正。

# local_exposure
local_exposure.bright_detail_protection = 亮部细节保护
local_exposure.bright_detail_protection.tip = 控制暗邻域是否可将像素提亮至枢轴之上。1 使亮部保持锚定；0 允许跨枢轴校正。
local_exposure.cat.advanced = 高级
local_exposure.dark_detail_protection = 暗部细节保护
local_exposure.dark_detail_protection.tip = 控制亮邻域是否可将像素压暗至枢轴之下。1 使暗部细节保持锚定；0 允许跨枢轴校正。
local_exposure.detail_retention = 细节保留
local_exposure.detail_retention.tip = 保留像素相对于其局部基底的对数亮度细节。1 保留所有相对细节；较低的值压缩它。
local_exposure.edge_protection = 边缘保护
local_exposure.edge_protection.tip = 降低跨强对数亮度边缘的样本影响。0 仅使用空间权重；更高的值减少光晕，但可能使自适应更局部。
local_exposure.enabled = 局部曝光
local_exposure.enabled.tip = 应用随空间变化的曝光校正，以显示参考中间调为枢轴。适用于任何源：HDR 路径通过其色调曲线到达枢轴，显示参考路径从图像中读取它。
local_exposure.highlight_reduction = 高光抑制
local_exposure.highlight_reduction.tip = 高光抑制的独立乘子。设为零可在仍提亮阴影的同时，保持亮部区域不变。
local_exposure.highlight_transition = 高光过渡
local_exposure.highlight_transition.tip = 高于中间调枢轴的档位数，在此范围内高光抑制渐增至满强度。值越小作用越激进。
local_exposure.max_brighten = 最大提亮
local_exposure.max_brighten.tip = 最大阴影提亮档位数。在满亮部细节保护下，即使邻域为暗，高于中间调枢轴的像素也不会被提亮。
local_exposure.max_darken = 最大压暗
local_exposure.max_darken.tip = 最大高光抑制档位数。在满暗部细节保护下，即使邻域为亮，低于枢轴的像素也不会被压暗。
local_exposure.midtone = 局部中间调
local_exposure.midtone.tip = 模型 SDR 域中的目标亮度枢轴。接近此枢轴的像素几乎不受校正；阴影上移、高光下移趋向它。
local_exposure.radius = 局部半径
local_exposure.radius.tip = 以源像素为单位的半径。半径为 1 时禁用多重邻域采样，仅使用中心像素。更大的半径响应更宽的区域明暗，而非单个像素噪声。
local_exposure.restore = 恢复模型曝光
local_exposure.restore.tip = 在评估后对模型输出应用校正。禁用时，模型重建的局部明暗保持不变。
local_exposure.restore_scale = 恢复空间尺度
local_exposure.restore_scale.tip = 控制曝光恢复的空间尺度：0 = 逐像素精确抵消局部提亮，1 = 均匀全局校正，二者之间为 log 空间混合。全局恢复保留更多模型重建的亮度关系。
local_exposure.restore_strength = 恢复强度
local_exposure.restore_strength.tip = 曝光恢复的量：0 = 无校正，1 = 完全校正。中间值在 log 曝光空间中混合所选恢复。
local_exposure.samples = 邻域样本
local_exposure.samples.tip = 局部对数亮度估计中请求的空间采样点。有效数量四舍五入到四的倍数，以保持采样空间均衡。
local_exposure.shadow_lift = 阴影提亮
local_exposure.shadow_lift.tip = 阴影提亮的独立乘子。设为零可在仍抑制高光的同时，保持暗部区域不变。
local_exposure.shadow_transition = 阴影过渡
local_exposure.shadow_transition.tip = 距中间调枢轴的档位数，在此范围内阴影提亮渐增至满强度。值越小对暗区作用越激进。
local_exposure.strength = 强度
local_exposure.strength.tip = 局部曝光校正的总体量。
local_exposure.title = 局部曝光

# pass
pass.auto_mask = 自动遮罩
pass.auto_mask.tip = 让模型检测角色皮肤，并对其单独应用编辑。
pass.cat.model = 模型
pass.cat.residual_edits = 残差编辑
pass.cat.strength = 强度
pass.cat.temporal = 时域重投影
pass.cheap_preset.auto = 自动
pass.cheap_preset.auto.tip = 使用此通道自身的渲染预设。一个 NGX 功能同时服务于两个模型。
pass.cheap_preset.performance = 性能
pass.cheap_preset.performance.tip = 使用提示 2 创建廉价模型的功能。
pass.cheap_preset.quality = 质量
pass.cheap_preset.quality.tip = 使用提示 1 创建廉价模型的功能。
pass.chroma_strength = 色度强度
pass.chroma_strength.tip = 在原始色度与编辑后色度之间混合。
pass.correct_motion = 修正运动矢量
pass.correct_motion.tip = 生成此通道可信任的运动场。帧的第一个预/后-DLSS 通道保持游戏矢量不变，因为它处理的是这些矢量所对应的图像。它之后的每个通道，以及每个后缓冲通道，都会获得一个修正后的场：搜索被限制在游戏矢量周围几个像素内，并偏向先前的场。如果没有游戏矢量，该通道会从颜色和深度合成它们。同时供给模型和时域重投影；每个通道消耗一次 GPU 调度，并需要一个可用的深度引导。
pass.edit_strength = 编辑强度
pass.edit_strength.tip = 在编辑被带到源之前，缩放模型的编辑。
pass.enabled = 启用
pass.enabled.tip = 启用或禁用此通道配置文件。禁用的通道不评估模型。
pass.grade_input.apply_to_pre_grade = 将编辑应用到分级前图像
pass.grade_input.apply_to_pre_grade.tip = 在分级之前将模型的编辑应用到图像，使分级不会到达输出。关闭时，直接使用分级后的模型输出。
pass.grade_input.enabled = 分级模型输入
pass.grade_input.enabled.tip = 在模型评估之前，对模型读取的图像进行分级。
pass.grade_input.title = 分级模型输入
pass.grade_output.enabled = 分级模型输出
pass.grade_output.enabled.tip = 在模型发布之前对其进行分级。
pass.grade_output.title = 分级模型输出
pass.intensity = 强度
pass.intensity.tip = 模型被指示编辑图像的程度。\n0 会完全跳过模型评估
pass.local_structure = 局部结构
pass.local_structure.tip = 要应用多少模型的局部结构细节。
pass.local_tone = 局部色调
pass.local_tone.tip = 要应用多少模型的局部色调调整。
pass.luma_strength = 亮度强度
pass.luma_strength.tip = 在原始亮度与编辑后亮度之间混合。
pass.menu.copy_from_next = 从下一通道复制
pass.menu.copy_from_previous = 从上一通道复制
pass.name = 名称
pass.name.tip = 显示在此通道标签页上的标签。为空时显示位置默认标签\"Pass N\"。
pass.order = 通道顺序
pass.preset = 预设
pass.preset.a = A
pass.preset.a.tip = 使用模型预设 A。更改在每次评估时应用，并在不重建功能的情况下重置模型的内部历史。
pass.preset.b = B
pass.preset.b.tip = 使用模型预设 B。更改在每次评估时应用，并在不重建功能的情况下重置模型的内部历史。
pass.preset.c = C
pass.preset.c.tip = 使用模型预设 C。更改在每次评估时应用，并在不重建功能的情况下重置模型的内部历史。
pass.preset.tip = 为此通道选择模型质量/行为预设。
pass.ratio_brighten = 比例提亮
pass.ratio_brighten.tip = 启用比例钳制时，逐通道残差比例的上限。适用于 SDR 和 HDR 合成。
pass.ratio_clamps = 比例钳制
pass.ratio_clamps.tip = 在成形之前，将逐通道模型残差对数比例限制在[压暗比例, 提亮比例]范围内。适用于 SDR 和 HDR 合成。
pass.ratio_darken = 比例压暗
pass.ratio_darken.tip = 启用比例钳制时，逐通道残差比例的下限。适用于 SDR 和 HDR 合成。
pass.ratio_eps = 比例 Eps
pass.ratio_eps.tip = 逐通道残差对数比例的分母下限。当通道接近零时保持残差有限。适用于 SDR 和 HDR 合成。
pass.render_preset = 渲染预设
pass.render_preset.performance = 性能
pass.render_preset.performance.tip = 提示 2：面向性能的预设。
pass.render_preset.quality = 质量
pass.render_preset.quality.tip = 提示 1：面向质量的预设。
pass.render_preset.tip = 此通道的 DLSSNR.Hint.Render.Preset 提示。NGX 在功能创建时锁定它，因此更改会重建此通道的功能。
pass.residual_chroma = 色度强度
pass.residual_chroma.tip = 编辑的色度相对于其亮度的落地量。
pass.residual_gamma = 编辑伽马
pass.residual_gamma.tip = 塑造编辑的响应曲线。
pass.residual_highlight = 高光保护
pass.residual_highlight.tip = 在高到极高亮度之上淡出编辑。
pass.residual_shadow = 阴影保护
pass.residual_shadow.tip = 在中到低亮度之下淡出编辑。
pass.skin_structure = 皮肤结构
pass.skin_structure.tip = 控制模型应用其特定于皮肤的编辑的强度。当模型的自动遮罩选项关闭时禁用。
pass.target = 目标
pass.target.backbuffer = 后缓冲
pass.target.backbuffer.tip = 在 ReShade Present 的最终交换链后缓冲上运行。即使游戏不使用 DLSS 也能工作；除非这些阶段可用，否则不与预/后-DLSS 通道排序。
pass.target.post_dlss = 后-DLSS
pass.target.post_dlss.tip = 在游戏的 DLSS 评估之后、后续后期处理和 UI 之前，于其上采样输出上运行。
pass.target.pre_dlss = 预-DLSS
pass.target.pre_dlss.tip = 在游戏的 DLSS 评估之前，于其输入 Color 资源上运行。游戏随后对修改后的图像进行上采样。需要完整资源的 Color 输入。
pass.target.tip = 每个通道可独立以预-DLSS、后-DLSS 或后缓冲为目标。执行顺序按阶段分组；每个阶段内的通道遵循其通道标签页顺序。更改目标会在下一次评估时重置模型的内部历史。
pass.temporal.adaptive = 自适应
pass.temporal.adaptive.tip = 在逐像素置信度允许的范围内复用重投影编辑，并强制至少每 N 帧刷新一次（N 为节奏滑块）。当无效像素比例较高时，有效节奏减半。
pass.temporal.cadence = 节奏
pass.temporal.cadence.tip = 模型评估之间的帧数。在自适应模式下，这是最大值；当无效像素比例较高时，有效节奏减半。在固定模式下，这是精确的节奏。
pass.temporal.cheap = 廉价模型
pass.temporal.cheap.tip = 在完整评估之间的帧上运行第二个更廉价的模型，并在重投影置信度低的位置采用其编辑。关闭时，这些帧仅从历史重建，不额外消耗成本，但会留下遮挡缺失和快速运动，直到下一次完整评估。
pass.temporal.cheap_preset = 廉价模型预设
pass.temporal.cheap_preset.tip = 廉价模型自身功能的渲染预设。自动跟随此通道的预设，无需第二个功能；其他预设会创建一个，因为 NGX 在创建时锁定提示。
pass.temporal.cheap_scale = 廉价模型比例
pass.temporal.cheap_scale.tip = 廉价模型的分辨率，以工作分辨率的比例表示。0.5 表示工作分辨率分辨率的 50%。值越低越快，但低置信度重投影区域填充的细节更少。
pass.temporal.depth_abs = 深度绝对
pass.temporal.depth_abs.tip = 运动重投影后允许的绝对深度差异。
pass.temporal.depth_rel = 深度相对
pass.temporal.depth_rel.tip = 相对深度差异容差。阈值为此容差与深度绝对中的较大者。
pass.temporal.fixed = 固定
pass.temporal.fixed.tip = 在模型评估之间，以固定帧数复用重投影编辑，不考虑置信度。节奏滑块即为精确的节奏。
pass.temporal.fp16_history = FP16 编辑历史
pass.temporal.fp16_history.tip = 将时域编辑/候选纹理存储在 FP16 中。减少历史带宽和内存，复用编辑上仅有微小的量化差异。
pass.temporal.max_invalid = 最大无效 %
pass.temporal.max_invalid.tip = 在刷新模型之前允许的最大无效或光度不匹配像素比例。
pass.temporal.max_motion = 最大运动
pass.temporal.max_motion.tip = 当运动超过此数量的工作分辨率像素时，拒绝重投影。
pass.temporal.mode = 模式
pass.temporal.mode.tip = 复用运动重投影的乘性模型编辑，而非每帧评估模型。需要当前帧深度和运动场——游戏的，或由修正运动矢量生成的；不确定的历史会强制进行新的评估。
pass.temporal.off = 关闭
pass.temporal.off.tip = 在每一帧上评估神经模型。
pass.temporal.photo_abs = 光度绝对
pass.temporal.photo_abs.tip = 当前像素与其运动重投影的上一帧匹配之间允许的绝对模型输入亮度差异。
pass.temporal.photo_rel = 光度相对
pass.temporal.photo_rel.tip = 相对亮度差异容差，按较大的绝对当前或上一帧亮度进行缩放。叠加到光度绝对之上。
pass.ui_correction = UI 校正
pass.ui_correction.tip = 在检测到 UI 元素的位置减少模型的编辑。
pass.upsample_sharpness = 上采样锐度
pass.upsample_sharpness.tip = 用于模型输入和输出的固定联合双边 3x3 重建的边缘保留指数。较高的值更清晰地跟踪全分辨率引导边缘；较低的值在低分辨率邻域内更平滑地混合。这不会改变模型编辑的幅度。
pass.working_scale = 工作分辨率
pass.working_scale.reset_tip = 将工作分辨率和 x2 重置为其默认值。
pass.working_scale.slider_tip = 模型的工作分辨率，以帧的比例表示。\n\n非常低的值会被提升到至少 180p 垂直分辨率，因此时域重投影始终有可用的历史。更改此值会在下一次评估时重置模型的内部历史。
pass.working_scale.tip = 模型运行的分辨率，以帧的比例表示。勾选 x2 将其翻倍以进行超采样。合成与后缓冲保持帧分辨率。
pass.working_scale.x2_off_tip = 当前正在将模型的工作分辨率翻倍以进行超采样。取消勾选可返回滑块的值。更改此设置会在下一次评估时重置模型的内部历史。\n\n取消勾选后的第一帧也可能短暂冻结，同时分配更小的资源，先前的资源在 GPU 上退役。
pass.working_scale.x2_on_tip = 将模型的工作分辨率翻倍以进行超采样。这会在下一次评估时重置模型的内部历史。\n\n警告：启用此选项可能会在切换后的第一帧短暂冻结游戏，同时分配更大的工作分辨率资源（工作输入/输出、时域历史、未提升参考），并且先前在途的缓冲区在 GPU 上退役。\n\n其他风险：\n  - 工作分辨率资源的 VRAM 使用量大约翻两番。\n  - 模型评估和合成在 2x 下较慢。\n  - 在复用帧上复用的廉价模型随工作分辨率增长，因此复用帧也更昂贵。\n  - 超过一两秒的冻结通常意味着设备 VRAM 耗尽；关闭此选项以恢复。

# prefs
prefs.clone_resources = 克隆游戏资源
prefs.clone_resources.tip = 关闭（默认）：直接读取游戏当前的深度/运动资源和 DLSS 输出。开启：将当前帧的深度/运动，以及启用后-DLSS 时的 DLSS 输出，复制到插件拥有的纹理中。此选项适用于所有阶段，包括后缓冲；所请求的模式会在新的 DLSS 评估时安全锁定。
prefs.fp16_storage = FP16 管线
prefs.fp16_storage.tip = 将 HDR 增益图载体、模型工作纹理和未提升合成参考存储在 RGBA16F 而非 RGBA32F 中。将 HDR 管线的带宽和占用减半，代价是载体到 HDR 乘数和模型域增量中的量化。SDR 路径不受影响。切换会重置时域历史并重建 NGX 功能。
prefs.invert_fallback_depth = 反转回退深度
prefs.invert_fallback_depth.tip = 当由于 DLSS 评估未提供深度资源而使用 ReShade Generic Depth 值时，反转其数值。不会改变 DLSS 提供的深度。
prefs.language = 语言
prefs.language.auto = 自动 (ReShade)
prefs.language.tip = 插件界面的语言。自动跟随 ReShade 的语言设置。
prefs.show_tooltips = 显示工具提示
prefs.show_tooltips.tip = 悬停在控件和分区标题上时显示上下文描述。
prefs.title = 首选项

