# language: zh-HK
# name: 繁體中文（香港）
#
# Values are C string escapes: \n is a line break, \" a quote.
# An empty value means the English text is used.

# ctl
ctl.category.toggle = 展開或摺疊 %s 子分區。
ctl.menu.copy = 複製
ctl.menu.paste = 貼上
ctl.reset.default.tip = 重設為宣告的預設值。
ctl.section.toggle = 啟用或停用 %s。

# debug
debug.title = 偵錯
debug.view = 偵錯視圖
debug.view.depth = 深度
debug.view.depth.tip = 遊戲提供給 DLSS 的深度緩衝區。以灰階顯示。
debug.view.exposure_mask = 曝光遮罩
debug.view.exposure_mask.tip = 當前影格的遮罩，來自實際模型輸入（包括輸入分級和局部曝光）與原始模型輸出對比。該遮罩發佈供下一影格的曝光使用。
debug.view.gain_map = 增益圖
debug.view.gain_map.tip = 原始 f32 載體到 HDR 重建倍率，以 log2 檔位顯示，從 -4（黑）到 +6（白）。
debug.view.game_exposure = 遊戲曝光
debug.view.game_exposure.tip = 遊戲 NGX 曝光以檔位表示：1.0x（0 檔）為中灰；更亮/更暗的值趨向白/黑。洋紅色表示未讀取到有效值。
debug.view.hdr_local_exposure = HDR 局部曝光
debug.view.hdr_local_exposure.tip = 局部曝光係數以檔位表示，映射為 0 檔為中灰，-2 檔為黑，+2 檔為白。
debug.view.hdr_roundtrip_diagnostic = HDR 往返診斷
debug.view.hdr_roundtrip_diagnostic.tip = 2x2 對比：實際準備的模型輸入 | 模型輸出 / 合成 HDR 映射回未分級的模型域 | 相對未分級模型輸出的合成差異。由於保留了全解析度源細節，出現非零邊緣是預期的；工作解析度會影響此對比。使用 HDR 往返誤差進行獨立的載體重建檢查。
debug.view.hdr_roundtrip_error = HDR 往返誤差
debug.view.hdr_roundtrip_error.tip = 原始解碼 HDR 源與從 RGBA32F 載體及載體到 HDR 倍率直接 float32 重建之間的偽彩色相對誤差。這僅驗證載體傳輸，而非模型編輯或最終合成；與工作解析度和輸入分級無關。
debug.view.hint = 該視圖由下方標籤頁中目前選取的通道渲染，且只在该通道啟用時生效。
debug.view.model_input_pre_grade = 模型輸入（分級前）
debug.view.model_input_pre_grade.tip = 模型輸入顏色，正是輸入分級執行前的狀態。分級在原位套用，因此選取該視圖時管線會為你快照此紋理；啟用輸入分級時，可將其與模型輸入（已準備）對比。
debug.view.model_input_prepared = 模型輸入（已準備）
debug.view.model_input_prepared.tip = 真正送入模型的影像，已縮放至工作解析度，完成 HDR 準備，並在啟用時套用輸入分級。
debug.view.model_input_source = 模型輸入（源）
debug.view.model_input_source.tip = 擷取時的影格，未經任何處理。這是模型將處理的 DLSS 輸出，以其原生解析度呈現。
debug.view.model_output_composed = 模型輸出（已合成）
debug.view.model_output_composed.tip = 此通道的最終結果，模型編輯已與源合成。這就是寫入目標的內容。
debug.view.model_output_post_grade = 模型輸出（分級後）
debug.view.model_output_post_grade.tip = 輸出分級執行後的模型輸出，位於模型自身的 sRGB 編碼 SDR 域——與模型輸入的輸入分級對稱。下游的一切（合成、曝光遮罩、回寫）都以此為準，如同模型本身產生。
debug.view.model_output_raw = 模型輸出（原始）
debug.view.model_output_raw.tip = 模型輸出，正是 NGX 產生時的狀態，在輸出分級套用之前。由於分級在原位執行，管線會對此快照；啟用輸出分級時，可將其與模型輸出（分級後）對比。
debug.view.motion_vectors = 運動向量
debug.view.motion_vectors.tip = 此通道用於評估的運動場：遊戲的向量，或「修正運動向量」為其生成的場。顯示為 R = x 方向，G = y 方向。
debug.view.off = 關閉
debug.view.off.tip = 停用偵錯視圖並顯示正常的合成輸出。
debug.view.sdr_base_pre_model = SDR 基底（模型前）
debug.view.sdr_base_pre_model.tip = 由 BT.2446C 拆分生成的全面解析度線性 SDR 載體。這是模型下取樣所用的 RGB 載荷。
debug.view.temporal_candidate_status = 時域候選狀態
debug.view.temporal_candidate_status.tip = 深度驗證前的重投影置信度，以灰階顯示（白=完全信任，黑=拒絕）。置信度結合了局部編輯鉗制一致性、光度一致性和上一影格置信度。在上一影格編輯可以被重投影之前不可用。
debug.view.temporal_reprojected_edit = 時域重投影編輯
debug.view.temporal_reprojected_edit.tip = 來自上一影格的已驗證逐通道對數增益，映射為中性增益為灰，更強的正/負編輯趨向白/黑。被拒絕的像素為暗。
debug.view.temporal_validation_status = 時域驗證狀態
debug.view.temporal_validation_status.tip = 深度驗證後的置信度，以灰階顯示。置信度縮放所套用的編輯權重；低值使編輯向輸入淡出。
debug.view.tip = 用內部緩衝替換最終影像，以便檢查管線。

# exposure_mask
exposure_mask.chroma_threshold = 色度閾值
exposure_mask.chroma_threshold.tip = 標記模型編輯所需的最小純色度差異。
exposure_mask.edit_strength = 編輯強度
exposure_mask.edit_strength.tip = 在閾值化之前縮放測量到的模型輸入/輸出差異。
exposure_mask.enabled = 啟用
exposure_mask.enabled.tip = 此通道在模型評估後建構其曝光遮罩。該遮罩僅影響此通道下一影格的 HDR 測光。
exposure_mask.luma_relative = 相對亮度
exposure_mask.luma_relative.tip = 相對於較亮輸入/輸出亮度的最小亮度差異。
exposure_mask.luma_threshold = 亮度閾值
exposure_mask.luma_threshold.tip = 標記模型編輯所需的最小絕對亮度差異。
exposure_mask.response = 時域回應
exposure_mask.response.tip = 將新的遮罩投票與上一影格的遮罩混合。
exposure_mask.smoothing = 空間平滑
exposure_mask.smoothing.tip = 在小鄰域內對二值曝光投票進行多數濾波。
exposure_mask.title = 曝光遮罩

# grade
grade.black_level = 黑位
grade.black_level.tip = 映射到黑色的 OKLab 亮度值。正值僅壓暗最深的陰影；負值提升暗部。
grade.brightness = 亮度
grade.brightness.tip = 在曝光模式下，數值以檔位表示（-1 使線性光減半；+1 使其加倍）。其他模式使用各自的亮度曲線。
grade.brightness_mode = 亮度模式
grade.brightness_mode.tip = 亮度所使用的演算法。這些是替代方案，而非疊加層。
grade.cas = CAS 銳化
grade.cas.tip = 在分級結果上啟用 AMD FidelityFX 對比度自適應銳化。僅在線性 SDR 中作為獨立排程執行；HDR 格式時跳過。
grade.cas_strength = CAS 強度
grade.cas_strength.tip = AMD FidelityFX CAS 的銳化量。0 不套用銳化，1 套用最大銳化。
grade.chroma_mode = 色度模式
grade.chroma_mode.saturation = 飽和度
grade.chroma_mode.saturation.tip = 以相同係數縮放 OKLab 色度，同時保留感知色相。
grade.chroma_mode.tip = 飽和度所使用的演算法。這些是替代方案，而非疊加層。
grade.chroma_mode.vibrance = 自然飽和度
grade.chroma_mode.vibrance.tip = 在 OKLab 中更強地增強低飽和顏色，並隨色度升高減弱效果。
grade.contrast = 對比度
grade.contrast.tip = 圍繞中間亮度的支點 S 曲線。正值增加對比度，負值降低對比度，同時保持黑和白錨定。
grade.edge_softening = 邊緣感知柔化
grade.edge_softening.tip = 將聯合雙邊 3x3 鄰域混合到分級輸入中。亮度相似性可減少跨強邊緣的模糊。
grade.highlights = 高光
grade.highlights.tip = 用一條在黑色之前淡出的平滑曲線調整高光。
grade.luma_mode.exposure = 曝光
grade.luma_mode.exposure.tip = 將線性光 RGB 乘以 2^amount（檔位）；當結果超出輸出範圍時，色域映射保護顏色。
grade.luma_mode.gain = 增益
grade.luma_mode.gain.tip = 透過有界的乘法曲線縮放 OKLab 亮度。
grade.luma_mode.gamma = 伽馬
grade.luma_mode.gamma.tip = 對 OKLab 亮度套用帶符號的冪曲線。中性黑和白保持錨定，將效果集中在中間調。
grade.luma_mode.soft = 柔和
grade.luma_mode.soft.tip = 在黑和白附近淡出為零的平滑亮度調整。
grade.saturation = 飽和度
grade.saturation.tip = 在 OKLab 中調整感知色度。超出色域的顏色被向中性軸壓縮，以避免通道裁剪偽影。
grade.shadows = 陰影
grade.shadows.tip = 用一條在白之前淡出的平滑曲線調整陰影。
grade.softening_strength = 柔化強度
grade.softening_strength.tip = 邊緣感知 3x3 柔化的量。
grade.white_level = 白位
grade.white_level.tip = 映射到白色的 OKLab 亮度值。提高該點會壓暗影像；超出色域的顏色被壓縮而非通道裁剪。

# grade_backbuffer
grade_backbuffer.enabled = 啟用
grade_backbuffer.enabled.tip = 在每次通道之後、呈現之前對最終交換鏈影像進行分級。這與每個通道的模型輸入和模型輸出分級相互獨立。
grade_backbuffer.title = 分級後緩衝

# hdr
hdr.adaptive.enabled = 自適應曝光
hdr.adaptive.enabled.tip = 遊戲曝光關閉時，由直方圖測量提供全局曝光。遊戲曝光開啟時，將「相對遊戲強度」作為有界校正套用（在 0 時無效）。在首次測量到達之前無效。
hdr.adaptive.max_correction = 最大校正檔位
hdr.adaptive.max_correction.tip = 兩層都啟用時，圍繞遊戲曝光的最大調整。
hdr.adaptive.midtone = 中間調目標
hdr.adaptive.midtone.tip = 所選群體的目標亮度。
hdr.adaptive.speed_down = 變暗速度
hdr.adaptive.speed_down.tip = 每秒曝光減少的最大檔位數。
hdr.adaptive.speed_up = 變亮速度
hdr.adaptive.speed_up.tip = 每秒曝光增加的最大檔位數。
hdr.adaptive.strength_over_game = 相對遊戲強度
hdr.adaptive.strength_over_game.tip = 遊戲曝光處於活動狀態時，將自適應目標檔位校正的一部分疊加到遊戲曝光上。遊戲曝光停用時，自適應為基準曝光。
hdr.bt2446_ip = BT.2446C 拐點
hdr.bt2446_ip.tip = BT.2446C 曲線域中的拐點位置。高於此點的內容被對數壓縮；低於此點的內容為線性。滑桿覆蓋真實 HDR 內容的有用範圍。仍可鍵入其外的值：10000 表示停用壓縮。
hdr.bt2446_k1 = BT.2446C k1
hdr.bt2446_k1.tip = 線性區域斜率：拐點以下的內容滿足 Y_SDR = k1 * Y_HDR。也是對數分支在拐點處匹配的斜率。
hdr.bt2446_k2 = BT.2446C k2（派生）
hdr.bt2446_k2.tip = BT.2446C 曲線的對數區域斜率。由 k1、k3 和拐點派生，使對數分支在拐點處匹配線性分支的斜率。
hdr.bt2446_k3 = BT.2446C k3
hdr.bt2446_k3.tip = 肩部壓縮強度。值越大，對數分支壓得更低，高光更暗。k2 和 k4 由此派生，使曲線在拐點處保持平滑。
hdr.bt2446_k4 = BT.2446C k4（派生）
hdr.bt2446_k4.tip = BT.2446C 曲線的對數區域截距。由 k1、k3 和拐點派生，使對數分支在拐點處匹配線性分支的值。
hdr.cat.advanced = 進階
hdr.cat.diagnostics = 診斷
hdr.cat.filters = 濾鏡
hdr.common.available = 可用
hdr.common.no = 否
hdr.common.not_seen = 未見到
hdr.common.pending = 等待中
hdr.common.ready = 就緒
hdr.common.unavailable = 不可用
hdr.common.valid = 有效
hdr.common.yes = 是
hdr.crosstalk = 串擾
hdr.crosstalk.tip = BT.2446C 去飽和前量。
hdr.density.full = 全取樣
hdr.density.full.tip = 對每個像素取樣。全密度直方圖，最高精度。
hdr.density.quarter = 1/4
hdr.density.quarter.tip = 每個軸每隔 1 個像素取樣（影格的 1/4）。小的孤立高光可能被遺漏。
hdr.density.sixteenth = 1/16
hdr.density.sixteenth.tip = 每個軸每隔 3 個像素取樣（影格的 1/16）。孤立高光和精細細節可能被遺漏。
hdr.density.sixty_fourth = 1/64
hdr.density.sixty_fourth.tip = 每個軸每隔 7 個像素取樣（影格的 1/64）。僅適用於大致均勻的內容。
hdr.detailed_statistics = 詳細 HDR 統計
hdr.detailed_statistics.tip = 收集全影格增益圖範圍和偏移統計。啟用時增加兩次 GPU 排程。
hdr.diag.adaptive_scene_white = 自適應場景白：%.4f
hdr.diag.async_note = 數值非同步更新。曝光和直方圖反映 GPU 已完成回寫的最近一次測量。
hdr.diag.exposure = 曝光：%.4f
hdr.diag.format = 格式：%s - resolved=%s
hdr.diag.gain_excursions = SDR 偏移：%u
hdr.diag.gain_map = 增益圖：%s
hdr.diag.gain_out_of_range = 超出範圍：%u
hdr.diag.gain_range = 範圍 (log2)：%.3f .. %.3f
hdr.diag.game_exposure = 遊戲曝光：%s
hdr.diag.game_texture = 紋理：%ux%u fmt=%d
hdr.diag.game_value = 值：%.4f
hdr.diag.guides = DLSS 引導：%s
hdr.diag.histogram = 直方圖（log2 亮度）
hdr.diag.histogram.tip = 測量到的 log2 亮度直方圖。群體取決於活動曝光濾鏡。
hdr.diag.histogram_missing = 直方圖：未就緒
hdr.diag.metering_source = 測光來源：%s
hdr.diag.post_blocked = 後-DLSS 被阻止：%s
hdr.diag.reference_luma = 參考亮度：%.4f
hdr.diag.samples = 樣本：%u - 距測量影格數：%u
hdr.diag.scene_white = 場景白：%.4f
hdr.diag.warming = 預熱中 - 尚無曝光測量。
hdr.enabled = 啟用
hdr.enabled.tip = 在此通道之前立即對 HDR 影像進行測光。除非啟用了測光復用，否則後續通道測量由上一通道合成的影像。後緩衝通道使用 SDR 合成。
hdr.format = 格式
hdr.format.auto = 自動
hdr.format.auto.tip = 從活動的預/後-DLSS 源自動偵測格式。
hdr.format.hdr10 = HDR10
hdr.format.hdr10.tip = 將源視為 HDR10 PQ（ST.2084）。
hdr.format.scrgb = scRGB
hdr.format.scrgb.tip = 將源視為線性 scRGB（1.0 = 80 nits）。
hdr.format.sdr = SDR
hdr.format.sdr.tip = 將源視為 SDR sRGB。
hdr.format.tip = 源影像的編碼方式。自動從 DLSS 輸出的 DXGI 格式偵測。
hdr.gain_max = 增益上限
hdr.gain_max.tip = 載體到 HDR 增益的預期最大值，以 log2 檔位表示。僅用於診斷增益圖統計和偵錯視圖；不影響合成。
hdr.gain_min = 增益下限
hdr.gain_min.tip = 載體到 HDR 增益的預期最小值，以 log2 檔位表示。僅用於診斷增益圖統計和偵錯視圖；不影響合成。
hdr.game.bias = 曝光偏移
hdr.game.bias.tip = 相對於遊戲曝光的手動偏移，以檔位表示。零表示保持遊戲的值不變。
hdr.game.enabled = 遊戲曝光
hdr.game.enabled.tip = 使用遊戲的 NGX ExposureTexture 作為基準曝光。如果遊戲未提供，此層將回退，由自適應曝光提供基準。
hdr.highlight_headroom = 高光餘量
hdr.highlight_headroom.tip = 縮放 BT.2446C 使用的有效 HDR 峰值。這不會改變曝光的解釋方式。
hdr.layer.adaptive = 自適應曝光
hdr.layer.adaptive.tip = 基於直方圖的全局曝光，或對遊戲曝光的有界校正。
hdr.layer.game = 遊戲曝光
hdr.layer.game.tip = 將遊戲的曝光配置為基準層。
hdr.layers.stack_order = 堆疊順序：遊戲曝光為基準，然後是自適應校正。局部曝光為獨立分區，在兩者之後套用。
hdr.measure_interval = 測量間隔
hdr.measure_interval.tip = 曝光直方圖的測量頻率，以影格為單位。
hdr.metering_density = 測光密度
hdr.metering_density.tip = HDR 直方圖取樣的像素數量。全密度捕獲每個像素；較粗的密度以更低的 GPU 成本取樣更少像素。
hdr.reuse_previous_pass = 復用上一 HDR 通道測光
hdr.reuse_previous_pass.tip = 對於同一預/後-DLSS 鏈中的後續通道，復用上一通道的 HDR 測量，而非排程新的直方圖。第一個通道仍測量遊戲的源。
hdr.source.filtered = 過濾群體
hdr.source.full_frame = 全影格
hdr.source.game_exposure = 遊戲曝光 (NGX)
hdr.source.unknown = 未知
hdr.title = HDR

# hdr_filters
hdr_filters.depth = 深度
hdr_filters.depth.tip = 將此層限制為選定的歸一化深度區間。
hdr_filters.depth_far = 遠深度
hdr_filters.depth_far.tip = 所接受歸一化深度區間的遠端。
hdr_filters.depth_near = 近深度
hdr_filters.depth_near.tip = 所接受歸一化深度區間的近端。
hdr_filters.exposure_mask = 曝光遮罩
hdr_filters.exposure_mask.tip = 僅對由持久曝光遮罩加權的像素進行測光或校正。
hdr_filters.percentile_high = 高百分位
hdr_filters.percentile_high.tip = 此層的上百分位邊界。
hdr_filters.percentile_low = 低百分位
hdr_filters.percentile_low.tip = 下百分位邊界。遊戲/自適應將該區間用於測光；局部曝光將其用作亮度保護帶。
hdr_filters.percentile_range = 百分位範圍
hdr_filters.percentile_range.tip = 對於遊戲/自適應，選擇該層直方圖的百分位區間。對於局部曝光，在其測量亮度帶之外淡出局部校正。

# local_exposure
local_exposure.bright_detail_protection = 亮部細節保護
local_exposure.bright_detail_protection.tip = 控制暗鄰域是否可將像素提亮至樞軸之上。1 使亮部保持錨定；0 允許跨樞軸校正。
local_exposure.cat.advanced = 進階
local_exposure.dark_detail_protection = 暗部細節保護
local_exposure.dark_detail_protection.tip = 控制亮鄰域是否可將像素壓暗至樞軸之下。1 使暗部細節保持錨定；0 允許跨樞軸校正。
local_exposure.detail_retention = 細節保留
local_exposure.detail_retention.tip = 保留像素相對於其局部基底的對數亮度細節。1 保留所有相對細節；較低的值壓縮它。
local_exposure.edge_protection = 邊緣保護
local_exposure.edge_protection.tip = 降低跨強對數亮度邊緣的樣本影響。0 僅使用空間權重；更高的值減少光暈，但可能使自適應更局部。
local_exposure.enabled = 局部曝光
local_exposure.enabled.tip = 套用隨空間變化的曝光校正，以顯示參考中間調為樞軸。適用於任何源：HDR 路徑透過其色調曲線到達樞軸，顯示參考路徑從影像中讀取它。
local_exposure.highlight_reduction = 高光抑制
local_exposure.highlight_reduction.tip = 高光抑制的獨立乘子。設為零可在仍提亮陰影的同時，保持亮部區域不變。
local_exposure.highlight_transition = 高光過渡
local_exposure.highlight_transition.tip = 高於中間調樞軸的檔位數，在此範圍內高光抑制漸增至滿強度。值越小作用越激進。
local_exposure.max_brighten = 最大提亮
local_exposure.max_brighten.tip = 最大陰影提亮檔位數。在滿亮部細節保護下，即使鄰域為暗，高於中間調樞軸的像素也不會被提亮。
local_exposure.max_darken = 最大壓暗
local_exposure.max_darken.tip = 最大高光抑制檔位數。在滿暗部細節保護下，即使鄰域為亮，低於樞軸的像素也不會被壓暗。
local_exposure.midtone = 局部中間調
local_exposure.midtone.tip = 模型 SDR 域中的目標亮度樞軸。接近此樞軸的像素幾乎不受校正；陰影上移、高光下移趨向它。
local_exposure.radius = 局部半徑
local_exposure.radius.tip = 以源像素為單位的半徑。半徑為 1 時停用多重鄰域取樣，僅使用中心像素。更大的半徑響應更寬的區域明暗，而非單個像素雜訊。
local_exposure.restore = 恢復模型曝光
local_exposure.restore.tip = 在評估後對模型輸出套用校正。停用時，模型重建的局部明暗保持不變。
local_exposure.restore_scale = 恢復空間尺度
local_exposure.restore_scale.tip = 控制曝光恢復的空間尺度：0 = 逐像素精確抵消局部提亮，1 = 均勻全局校正，二者之間為 log 空間混合。全局恢復保留更多模型重建的亮度關係。
local_exposure.restore_strength = 恢復強度
local_exposure.restore_strength.tip = 曝光恢復的量：0 = 無校正，1 = 完全校正。中間值在 log 曝光空間中混合所選恢復。
local_exposure.samples = 鄰域樣本
local_exposure.samples.tip = 局部對數亮度估計中請求的空間取樣點。有效數量四捨五入到四的倍數，以保持取樣空間均衡。
local_exposure.shadow_lift = 陰影提亮
local_exposure.shadow_lift.tip = 陰影提亮的獨立乘子。設為零可在仍抑制高光的同時，保持暗部區域不變。
local_exposure.shadow_transition = 陰影過渡
local_exposure.shadow_transition.tip = 距中間調樞軸的檔位數，在此範圍內陰影提亮漸增至滿強度。值越小對暗區作用越激進。
local_exposure.strength = 強度
local_exposure.strength.tip = 局部曝光校正的總體量。
local_exposure.title = 局部曝光

# pass
pass.auto_mask = 自動遮罩
pass.auto_mask.tip = 讓模型偵測角色皮膚，並對其單獨套用編輯。
pass.cat.model = 模型
pass.cat.residual_edits = 殘差編輯
pass.cat.strength = 強度
pass.cat.temporal = 時域重投影
pass.cheap_preset.auto = 自動
pass.cheap_preset.auto.tip = 使用此通道自身的渲染預設。一個 NGX 功能同時服務於兩個模型。
pass.cheap_preset.performance = 效能
pass.cheap_preset.performance.tip = 使用提示 2 建立廉價模型的功能。
pass.cheap_preset.quality = 品質
pass.cheap_preset.quality.tip = 使用提示 1 建立廉價模型的功能。
pass.chroma_strength = 色度強度
pass.chroma_strength.tip = 在原始色度與編輯後色度之間混合。
pass.correct_motion = 修正運動向量
pass.correct_motion.tip = 生成此通道可信任的運動場。影格的第一個預/後-DLSS 通道保持遊戲向量不變，因為它處理的是這些向量所對應的影像。它之後的每個通道，以及每個後緩衝通道，都會獲得一個修正後的場：搜尋被限制在遊戲向量周圍幾個像素內，並偏向先前的場。如果沒有遊戲向量，該通道會從顏色和深度合成它們。同時供給模型和時域重投影；每個通道消耗一次 GPU 排程，並需要一個可用的深度引導。
pass.edit_strength = 編輯強度
pass.edit_strength.tip = 在編輯被帶到源之前，縮放模型的編輯。
pass.enabled = 啟用
pass.enabled.tip = 啟用或停用此通道設定檔。停用的通道不評估模型。
pass.grade_input.apply_to_pre_grade = 將編輯套用到分級前影像
pass.grade_input.apply_to_pre_grade.tip = 在分級之前將模型的編輯套用到影像，使分級不會到達輸出。關閉時，直接使用分級後的模型輸出。
pass.grade_input.enabled = 分級模型輸入
pass.grade_input.enabled.tip = 在模型評估之前，對模型讀取的影像進行分級。
pass.grade_input.title = 分級模型輸入
pass.grade_output.enabled = 分級模型輸出
pass.grade_output.enabled.tip = 在模型發布之前對其進行分級。
pass.grade_output.title = 分級模型輸出
pass.intensity = 強度
pass.intensity.tip = 模型被指示編輯影像的程度。\n0 會完全跳過模型評估
pass.local_structure = 局部結構
pass.local_structure.tip = 要套用多少模型的局部結構細節。
pass.local_tone = 局部色調
pass.local_tone.tip = 要套用多少模型的局部色調調整。
pass.luma_strength = 亮度強度
pass.luma_strength.tip = 在原始亮度與編輯後亮度之間混合。
pass.menu.copy_from_next = 從下一通道複製
pass.menu.copy_from_previous = 從上一通道複製
pass.name = 名稱
pass.name.tip = 顯示在此通道標籤頁上的標籤。為空時顯示位置預設標籤\"Pass N\"。
pass.order = 通道順序
pass.preset = 預設
pass.preset.a = A
pass.preset.a.tip = 使用模型預設 A。更改在每次評估時套用，並在不重建功能的情況下重設模型的內部歷史。
pass.preset.b = B
pass.preset.b.tip = 使用模型預設 B。更改在每次評估時套用，並在不重建功能的情況下重設模型的內部歷史。
pass.preset.c = C
pass.preset.c.tip = 使用模型預設 C。更改在每次評估時套用，並在不重建功能的情況下重設模型的內部歷史。
pass.preset.tip = 為此通道選擇模型品質/行為預設。
pass.ratio_brighten = 比例提亮
pass.ratio_brighten.tip = 啟用比例鉗制時，逐通道殘差比例的上限。適用於 SDR 和 HDR 合成。
pass.ratio_clamps = 比例鉗制
pass.ratio_clamps.tip = 在成形之前，將逐通道模型殘差對數比例限制在[壓暗比例, 提亮比例]範圍內。適用於 SDR 和 HDR 合成。
pass.ratio_darken = 比例壓暗
pass.ratio_darken.tip = 啟用比例鉗制時，逐通道殘差比例的下限。適用於 SDR 和 HDR 合成。
pass.ratio_eps = 比例 Eps
pass.ratio_eps.tip = 逐通道殘差對數比例的分母下限。當通道接近零時保持殘差有限。適用於 SDR 和 HDR 合成。
pass.render_preset = 渲染預設
pass.render_preset.performance = 效能
pass.render_preset.performance.tip = 提示 2：面向效能的預設。
pass.render_preset.quality = 品質
pass.render_preset.quality.tip = 提示 1：面向品質的預設。
pass.render_preset.tip = 此通道的 DLSSNR.Hint.Render.Preset 提示。NGX 在功能建立時鎖定它，因此更改會重建此通道的功能。
pass.residual_chroma = 色度強度
pass.residual_chroma.tip = 編輯的色度相對於其亮度的落地量。
pass.residual_gamma = 編輯伽馬
pass.residual_gamma.tip = 塑造編輯的響應曲線。
pass.residual_highlight = 高光保護
pass.residual_highlight.tip = 在高到極高亮度之上淡出編輯。
pass.residual_shadow = 陰影保護
pass.residual_shadow.tip = 在中到低亮度之下淡出編輯。
pass.skin_structure = 皮膚結構
pass.skin_structure.tip = 控制模型套用其特定於皮膚的編輯的強度。當模型的自動遮罩選項關閉時停用。
pass.target = 目標
pass.target.backbuffer = 後緩衝
pass.target.backbuffer.tip = 在 ReShade Present 的最終交換鏈後緩衝上執行。即使遊戲不使用 DLSS 也能工作；除非這些階段可用，否則不與預/後-DLSS 通道排序。
pass.target.post_dlss = 後-DLSS
pass.target.post_dlss.tip = 在遊戲的 DLSS 評估之後、後續後期處理和 UI 之前，於其上取樣輸出上執行。
pass.target.pre_dlss = 預-DLSS
pass.target.pre_dlss.tip = 在遊戲的 DLSS 評估之前，於其輸入 Color 資源上執行。遊戲隨後對修改后的影像進行上取樣。需要完整資源的 Color 輸入。
pass.target.tip = 每個通道可獨立以預-DLSS、後-DLSS 或後緩衝為目標。執行順序按階段分組；每個階段內的通道遵循其通道標籤頁順序。更改目標會在下次評估時重設模型的內部歷史。
pass.temporal.adaptive = 自適應
pass.temporal.adaptive.tip = 在逐像素置信度允許的範圍內復用重投影編輯，並強制至少每 N 影格重新整理一次（N 為節奏滑桿）。當無效像素比例較高時，有效節奏減半。
pass.temporal.cadence = 節奏
pass.temporal.cadence.tip = 模型評估之間的影格數。在自適應模式下，這是最大值；當無效像素比例較高時，有效節奏減半。在固定模式下，這是精確的節奏。
pass.temporal.cheap = 廉價模型
pass.temporal.cheap.tip = 在完整評估之間的影格上執行第二個更廉價的模型，並在重投影置信度低的位置採用其編輯。關閉時，這些影格僅從歷史重建，不額外消耗成本，但會留下遮擋缺失和快速運動，直到下一次完整評估。
pass.temporal.cheap_preset = 廉價模型預設
pass.temporal.cheap_preset.tip = 廉價模型自身功能的渲染預設。自動跟隨此通道的預設，無需第二個功能；其他預設會建立一個，因為 NGX 在建立時鎖定提示。
pass.temporal.cheap_scale = 廉價模型比例
pass.temporal.cheap_scale.tip = 廉價模型的解像度，以工作解像度的比例表示。0.5 表示工作解像度解像度的 50%。值越低越快，但低置信度重投影區域填補的細節更少。
pass.temporal.depth_abs = 深度絕對
pass.temporal.depth_abs.tip = 運動重投影後允許的絕對深度差異。
pass.temporal.depth_rel = 深度相對
pass.temporal.depth_rel.tip = 相對深度差異容差。閾值為此容差與深度絕對中的較大者。
pass.temporal.fixed = 固定
pass.temporal.fixed.tip = 在模型評估之間，以固定影格數復用重投影編輯，不考慮置信度。節奏滑桿即為精確的節奏。
pass.temporal.fp16_history = FP16 編輯歷史
pass.temporal.fp16_history.tip = 將時域編輯/候選紋理儲存在 FP16 中。減少歷史頻寬和記憶體，復用編輯上僅有微小的量化差異。
pass.temporal.max_invalid = 最大無效 %
pass.temporal.max_invalid.tip = 在重新整理模型之前允許的最大無效或光度不匹配像素比例。
pass.temporal.max_motion = 最大運動
pass.temporal.max_motion.tip = 當運動超過此數量的工作解像度像素時，拒絕重投影。
pass.temporal.mode = 模式
pass.temporal.mode.tip = 復用運動重投影的乘性模型編輯，而非每影格評估模型。需要目前影格深度和運動場——遊戲的，或由修正運動向量生成的；不確定的歷史會強制進行新的評估。
pass.temporal.off = 關閉
pass.temporal.off.tip = 在每一影格上評估神經模型。
pass.temporal.photo_abs = 光度絕對
pass.temporal.photo_abs.tip = 目前像素與其運動重投影的上一影格匹配之間允許的絕對模型輸入亮度差異。
pass.temporal.photo_rel = 光度相對
pass.temporal.photo_rel.tip = 相對亮度差異容差，按較大的絕對目前或上一影格亮度進行縮放。疊加到光度絕對之上。
pass.ui_correction = UI 校正
pass.ui_correction.tip = 在偵測到 UI 元素的位置減少模型的編輯。
pass.upsample_sharpness = 上取樣銳度
pass.upsample_sharpness.tip = 用於模型輸入和輸出的固定聯合雙邊 3x3 重建的邊緣保留指數。較高的值更清晰地追蹤全解像度引導邊緣；較低的值在低解像度鄰域內更平滑地混合。這不會改變模型編輯的幅度。
pass.working_scale = 工作解像度
pass.working_scale.reset_tip = 將工作解像度和 x2 重設為其預設值。
pass.working_scale.slider_tip = 模型的工作解像度，以影格的比例表示。\n\n非常低的值會被提升到至少 180p 垂直解像度，因此時域重投影始終有可用的歷史。更改此值會在下次評估時重設模型的內部歷史。
pass.working_scale.tip = 模型執行的解像度，以影格的比例表示。勾選 x2 將其翻倍以進行超取樣。合成與後緩衝保持影格解像度。
pass.working_scale.x2_off_tip = 目前正將模型的工作解像度翻倍以進行超取樣。取消勾選可返回滑桿的值。更改此設定會在下次評估時重設模型的內部歷史。\n\n取消勾選後的第一影格也可能短暫凍結，同時分配更小的資源，先前的資源在 GPU 上退役。
pass.working_scale.x2_on_tip = 將模型的工作解像度翻倍以進行超取樣。這會在下次評估時重設模型的內部歷史。\n\n警告：啟用此選項可能會在切換後的第一影格短暫凍結遊戲，同時分配更大的工作解像度資源（工作輸入/輸出、時域歷史、未提升參考），並且先前在途的緩衝區在 GPU 上退役。\n\n其他風險：\n  - 工作解像度資源的 VRAM 使用量大約翻兩番。\n  - 模型評估和合成在 2x 下較慢。\n  - 在復用影格上復用的廉價模型隨工作解像度增長，因此復用影格也更昂貴。\n  - 超過一兩秒的凍結通常意味著裝置 VRAM 耗盡；關閉此選項以恢復。

# prefs
prefs.clone_resources = 克隆遊戲資源
prefs.clone_resources.tip = 關閉（預設）：直接讀取遊戲目前的深度/運動資源和 DLSS 輸出。開啟：將目前影格的深度/運動，以及啟用後-DLSS 時的 DLSS 輸出，複製到插件擁有的紋理中。此選項適用於所有階段，包括後緩衝；所請求的模式會在新的 DLSS 評估時安全鎖定。
prefs.fp16_storage = FP16 管線
prefs.fp16_storage.tip = 將 HDR 增益圖載體、模型工作紋理和未提升合成參考儲存在 RGBA16F 而非 RGBA32F 中。將 HDR 管線的頻寬和佔用減半，代價是載體到 HDR 乘數和模型域增量中的量化。SDR 路徑不受影響。切換會重設時域歷史並重建 NGX 功能。
prefs.invert_fallback_depth = 反轉回退深度
prefs.invert_fallback_depth.tip = 當由於 DLSS 評估未提供深度資源而使用 ReShade Generic Depth 值時，反轉其數值。不會改變 DLSS 提供的深度。
prefs.language = 語言
prefs.language.auto = 自動 (ReShade)
prefs.language.tip = 插件介面的語言。自動跟隨 ReShade 的語言設定。
prefs.show_tooltips = 顯示工具提示
prefs.show_tooltips.tip = 懸停在控制項和分區標題上時顯示上下文描述。
prefs.title = 偏好設定

# status
status.block.hooks_missing = 後-DLSS 已停用：未安裝 D3D12 命令列表鉤子
status.block.ray_reconstruction = 光線重建：遊戲向 DLSS 提供更大分配的 Subrect，因此預-DLSS 無法安全地重寫其 Color。請使用後-DLSS。

