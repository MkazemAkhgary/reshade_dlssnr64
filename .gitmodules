[submodule "reshade_dlssnr/third_party/reshade"]
	path = reshade_dlssnr/third_party/reshade
	url = https://github.com/crosire/reshade
	sparseCheckout = true
	sparseCheckoutPaths = source/ include/ deps/
[submodule "reshade_dlssnr/third_party/FidelityFX-CAS"]
	path = reshade_dlssnr/third_party/FidelityFX-CAS
	url = https://github.com/GPUOpen-Effects/FidelityFX-CAS.git
	sparseCheckout = true
	sparseCheckoutPaths = ffx-cas/
[submodule "third_party/tracy"]
	path = reshade_dlssnr/third_party/tracy
	url = https://github.com/wolfpld/tracy
	sparseCheckout = true
	sparseCheckoutPaths = public/
